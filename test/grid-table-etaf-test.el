                   '(("a" . "10") ("a" . "8") ("a" . "4") ("b" . "6") ("b" . "2"))))))

(ert-deftest grid-table-etaf-hidden-rows-and-columns ()
  (grid-table-etaf-test--with-grid (10 5 100 14)
    ;; Hide rows 3 and 4 (model 2 and 3) and column B.
    (grid-table-etaf-goto 2 0)
    (grid-table-etaf-goto 3 0 t)
    (grid-table-etaf-hide-rows)
    (should (equal (car (grid-table-hidden source)) '(2 3)))
    (grid-table-etaf-goto 1 1)
    (grid-table-etaf-hide-columns)
    (should (equal (grid-table-etaf--cursor) '(1 . 2)))
    (let ((window (grid-table-etaf-test--window)))
      (should-not (memq 2 (car window)))
      (should-not (memq 1 (cdr window))))
    ;; Movement passes over them.
    (grid-table-etaf-goto 1 0)
    (grid-table-next-line)
    (should (equal (grid-table-etaf--cursor) '(4 . 0)))
    (grid-table-cell-right)
    (should (equal (grid-table-etaf--cursor) '(4 . 2)))
    (grid-table-cell-left)
    (should (equal (grid-table-etaf--cursor) '(4 . 0)))
    ;; Copying leaves them out.
    (grid-table-etaf-goto 1 0)
    (grid-table-etaf-goto 4 2 t)
    (grid-table-etaf-copy)
    (should (equal (current-kill 0 t) "1\t3\n4\t12"))
    ;; Undo shows the column again; showing the rows takes a selection
    ;; across them.
    (grid-table-etaf-undo)
    (should (equal (cdr (grid-table-hidden source)) nil))
    (grid-table-etaf-select-all)
    (grid-table-etaf-show-rows)
    (should (equal (grid-table-hidden source) '(nil)))
    ;; Not everything can be hidden.
    (grid-table-etaf-select-all)
    (should-error (grid-table-etaf-hide-columns) :type 'user-error)
    ;; Rows a filter hides stay the filter's: B is 2, 4, ... so rows 1 to
    ;; 4 go, and hiding rows 0 to 6 hides only the ones shown.
    (grid-table-etaf-filter-column 1 ">" "8")
    (grid-table-etaf-goto 0 0)
    (grid-table-etaf-goto 6 0 t)
    (grid-table-etaf-hide-rows)
    (should (equal (car (grid-table-hidden source)) '(0 5 6)))
    ;; With the rest filtered away, the last shown row cannot go.
    (grid-table-etaf-select-all)
    (should-error (grid-table-etaf-hide-rows) :type 'user-error)))

(ert-deftest grid-table-etaf-defined-names ()
  (grid-table-etaf-test--with-grid (8 4 100 12)
    ;; B2:B4 hold 2, 4, 6.
    (grid-table-etaf-goto 1 1)
    (grid-table-etaf-goto 3 1 t)
    (grid-table-etaf-define-name "Amounts")
    (should (equal (grid-workbook-name-definition
                    (grid-workbook-of source) "amounts")
                   (concat "=" (grid-calc-sheet-prefix
                                (grid-workbook-sheet-name source))
                           "$B$2:$B$4")))
    (grid-table-etaf-set-cell 6 2 "=SUM(Amounts)")
    (should (equal (grid-get-computed-value-at source 6 2) 12))
    ;; Going to the name selects its cells.
    (grid-table-etaf-goto 0 0)
    (grid-table-etaf-goto-name "Amounts")
    (should (equal (grid-table-etaf-selection) '(1 1 3 1)))
    (grid-table-etaf-goto 0 0)
    (grid-table-etaf-goto-address "amounts")
    (should (equal (grid-table-etaf-selection) '(1 1 3 1)))
    ;; A short name reads like column letters; the name wins.
    (grid-table-etaf-goto 4 2)
    (grid-table-etaf-define-name "Qty")
    (grid-table-etaf-goto 0 0)
    (grid-table-etaf-goto-name "Qty")
    (should (equal (grid-table-etaf--cursor) '(4 . 2)))
    ;; Tracing the formula shows the named cells.
    (grid-table-etaf-goto 6 2)
    (grid-table-etaf-trace-precedents)
    (should (eq (grid-table-etaf--traced source 2 1) 'precedent))
    (should-error (grid-table-etaf-define-name "B12") :type 'user-error)
    ;; Deleting it is a step undo takes back.
    (grid-table-etaf-delete-name "Amounts")
    (should (equal (grid-get-computed-value-at source 6 2) "#NAME?"))
    (grid-table-etaf-undo)
    (should (equal (grid-get-computed-value-at source 6 2) 12))))

(ert-deftest grid-table-etaf-validation-lists ()
  (grid-table-etaf-test--with-grid (8 4 100 12)
    ;; Typing starts an edit here, as in Excel.
    (switch-to-buffer buffer)
    (grid-table-etaf-goto 1 0)
    (grid-table-etaf-goto 3 0 t)
    (grid-table-etaf-set-validation-list "Yes, No")
    ;; Editing such a cell offers the choices.
    (grid-table-etaf-goto 2 0)
    (cl-letf (((symbol-function 'completing-read)
               (lambda (_prompt options &rest _)
                 (should (equal options '("Yes" "No")))
                 "No")))
      (grid-table-edit-cell))
    (should (equal (grid-get-raw-value-at source 2 0) "No"))
    ;; Typing something else is refused and leaves the cell alone.
    (should-error (execute-kbd-macro (kbd "m a y b e RET")) :type 'user-error)
    (should (equal (grid-get-raw-value-at source 2 0) "No"))
    (execute-kbd-macro (kbd "y e s RET"))
    (should (equal (grid-get-raw-value-at source 2 0) "yes"))
    ;; Undo takes the rule back with it.
    (grid-table-etaf-goto 1 0)
    (grid-table-etaf-clear-validations)
    (should-not (grid-table-validations source))
    (grid-table-etaf-undo)
    (should (grid-table-validations source))))

(ert-deftest grid-table-etaf-remove-duplicates ()
  (grid-table-etaf-test--with-grid (8 4 100 12)
    ;; Rows 2 to 7: a, b, A, b, c, a in column A; column D reads B.
    (cl-loop for row from 1 for key in '("a" "b" "A" "b" "c" "a") do
             (grid-table-etaf-set-cell row 0 key))
    (grid-table-etaf-set-cell 5 1 "4")
    (grid-table-sheet-new "Other")
    (grid-table-etaf-set-cell 0 0 "=Sheet1!B6+Sheet1!B4")
    (grid-table-sheet-select "Sheet1")
    ;; Comparing column A only.
    (grid-table-etaf-goto 0 0)
    (grid-table-etaf-goto 7 0 t)
    (grid-table-etaf-remove-duplicates)
    (should (equal (cl-loop for row below (grid-get-row-count source)
                            collect (grid-get-raw-value-at source row 0))
                   '("H0" "a" "b" "c" "7")))
    ;; The formula of the row kept moved with it; the other sheet's
    ;; reference to a deleted row is #REF!, to a kept one follows it.
    (should (equal (grid-get-raw-value-at source 3 3) "=B4+C4"))
    (let ((other (grid-workbook-sheet (grid-workbook-of source) "Other")))
      (should (equal (grid-get-raw-value-at other 0 0) "=Sheet1!B4+Sheet1!#REF!"))
      (should (equal (grid-get-computed-value-at other 0 0) "#REF!"))
      (grid-table-etaf-undo)
      (should (= (grid-get-row-count source) 8))
      (should (equal (grid-get-raw-value-at other 0 0) "=Sheet1!B6+Sheet1!B4"))
      (should (equal (grid-get-computed-value-at other 0 0) 10)))
    (grid-table-etaf-goto 0 0)
    (should (equal (grid-table-etaf-remove-duplicates)
                   "No duplicate rows"))))

(defun grid-table-etaf-test--geometry (ref)
  "Return the painted geometry of Host REF, or nil when it is not painted."
  (when-let* ((node (etaf-runtime-host-node (grid-table-etaf--runtime) ref)))
    (ebox-node-geometry node)))

(ert-deftest grid-table-etaf-chart-runs-past-a-short-sheet ()
  "A chart taller than the rows below its anchor keeps its height.
The window's empty lines below the grid take the rest, and the status
bar moves below the chart."
  (grid-table-etaf-test--with-grid (6 3 120 30)
    (grid-table-etaf-goto 0 0)
    (grid-table-etaf-goto 5 1 t)
    (grid-table-etaf-insert-chart 'column)
    (let ((chart (grid-table-etaf-test--geometry 'grid-table-etaf-chart-0)))
      (should (equal (plist-get chart :height) 16))
      (let ((status-line (with-current-buffer (current-buffer)
                           (save-excursion
                             (goto-char (point-min))
                             (search-forward "Chart:")
                             (1- (line-number-at-pos))))))
        (should (>= status-line (+ (plist-get chart :y) 16)))))))

(ert-deftest grid-table-etaf-floating-charts ()
  "A chart floats over its anchor cell, scrolls with it and undoes."
  (grid-table-etaf-test--with-grid (40 8 120 24)
    (let ((source grid-table--data-source)
          (top (grid-table-etaf--state-top grid-table-etaf--state)))
      ;; With no cells selected the chart draws the filled block around
      ;; the cursor, here the whole sheet.
      (grid-table-etaf-goto 2 1)
      (grid-table-etaf-insert-chart 'column)
      (should (equal (plist-get (car (grid-table-charts source)) :range) "A1:H40"))
      (grid-table-etaf-undo)
      (should-not (grid-table-charts source))
      ;; From the selection, sitting right of the block of data it is
      ;; part of: here every column is filled, so past the sheet's edge.
      (grid-table-etaf-goto 1 1)
      (grid-table-etaf-goto 5 2 t)
      (grid-table-etaf-insert-chart 'column)
      (let ((chart (car (grid-table-charts source))))
        (should (equal (plist-get chart :range) "B2:C6"))
        (should (equal (plist-get chart :anchor) '(1 . 8))))
      (let ((geometry (grid-table-etaf-test--geometry 'grid-table-etaf-chart-0)))
        (should (equal (plist-get geometry :y) 3))
        (should (equal (plist-get geometry :height) 16)))
      (should (string-match-p "Chart: untitled (Column, B2:C6)"
                              (grid-table-etaf-test--text)))
      ;; Scrolled two rows past the anchor, the top of the chart is cut.
      (etaf-set-value top 3)
      (let ((geometry (grid-table-etaf-test--geometry 'grid-table-etaf-chart-0)))
        (should (equal (plist-get geometry :y) 2))
        (should (equal (plist-get geometry :height) 14)))
      ;; Scrolled past it entirely, it is gone.
      (etaf-set-value top 30)
      (should-not (grid-table-etaf-test--geometry 'grid-table-etaf-chart-0))
      (etaf-set-value top 0)
      ;; Type, title and switching are each a step to undo.
      (grid-table-etaf-chart-type 'pie)
      (grid-table-etaf-chart-title "Sales")
      (grid-table-etaf-chart-switch)
      (let ((chart (car (grid-table-charts source))))
        (should (eq (plist-get chart :type) 'pie))
        (should (equal (plist-get chart :title) "Sales"))
        (should (eq (plist-get chart :by) 'rows)))
      (grid-table-etaf-undo)
      (grid-table-etaf-undo)
      (should (eq (plist-get (car (grid-table-charts source)) :type) 'pie))
      (should-not (plist-get (car (grid-table-charts source)) :title))
      ;; A row inserted above moves the chart and its range.
      (grid-table-etaf-goto 1 0)
      (grid-table-insert-row-above)
      (let ((chart (car (grid-table-charts source))))
        (should (equal (plist-get chart :anchor) '(2 . 8)))
        (should (equal (plist-get chart :range) "B3:C7")))
      ;; A pointer drag redraws the grid as it goes, so each move may
      ;; reach a handler made after the drag started.
      (funcall (grid-table-etaf--drag-chart (current-buffer) 0) '(:phase start))
      (grid-table-etaf--bump grid-table-etaf--state)
      (funcall (grid-table-etaf--drag-chart (current-buffer) 0)
               '(:phase move :delta (0 . 2)))
      (funcall (grid-table-etaf--drag-chart (current-buffer) 0)
               '(:phase end :delta (0 . 2)))
      (should (equal (plist-get (car (grid-table-charts source)) :anchor) '(4 . 8)))
      (grid-table-etaf-undo)
      ;; A drag moves the chart by whole cells, as one undo step.
      (etaf-drag-step (grid-table-etaf--runtime) 'grid-table-etaf-chart-0 0 3)
      (should (equal (plist-get (car (grid-table-charts source)) :anchor) '(5 . 8)))
      (grid-table-etaf-undo)
      (should (equal (plist-get (car (grid-table-charts source)) :anchor) '(2 . 8)))
      ;; The chart draws what the cells hold now.
      (grid-table-etaf-set-cell 2 1 "999")
      (should (equal (cadr (car (plist-get (grid-table-etaf--chart-data
                                             source (car (grid-table-charts source))
                                             (etaf-value (grid-table-etaf--state-tick
                                                          grid-table-etaf--state)))
                                            :series)))
                     999))
      (grid-table-etaf-chart-move-here)
      (should (equal (plist-get (car (grid-table-charts source)) :anchor) '(1 . 0)))
      (grid-table-etaf-chart-delete)
      (should-not (grid-table-charts source))
      (grid-table-etaf-undo)
      (should (grid-table-charts source))
      ;; A chart anchored far past the sheet's edge, as a file may hold, still mounts.
      (grid-table-set-charts
       source (list (list :anchor '(1 . 50) :size '(20 . 6) :type 'line
                          :range "B2:C6")))
      (grid-table-etaf--bump grid-table-etaf--state)
      ;; It stands there, out of the window's sight, as on a spreadsheet.
      (should (equal (plist-get (car (grid-table-charts source)) :anchor) '(1 . 50)))
      (should-not (grid-table-etaf-test--geometry 'grid-table-etaf-chart-0)))))

(ert-deftest grid-table-etaf-charts-stand-past-the-last-column ()
  "A chart can stand right of the sheet, as on a spreadsheet's empty cells.
Selecting a chart leaves the selected cells alone, so they can be given
to it."
  (grid-table-etaf-test--with-grid (12 3 120 24)
    (let* ((source grid-table--data-source)
           (state grid-table-etaf--state)
           (real (+ (grid-table-etaf--col-pixels state 0)
                    (grid-table-etaf--col-pixels state 1)
                    (grid-table-etaf--col-pixels state 2))))
      ;; Right of a three-column block: column D, past the edge
      (grid-table-etaf-goto 0 0)
      (grid-table-etaf-goto 5 1 t)
      (grid-table-etaf-insert-chart 'column)
      (should (equal (plist-get (car (grid-table-charts source)) :anchor) '(0 . 3)))
      (let ((geometry (grid-table-etaf-test--geometry 'grid-table-etaf-chart-0)))
        (should geometry)
        ;; it starts right of the last column
        (should (>= (plist-get geometry :x) real)))
      ;; Dragged further right, over more empty columns, and back
      (should (= (grid-table-etaf--walk-cols
                  state 3 (* 3 (grid-table-etaf--col-pixels state 3)))
                 6))
      (should (= (grid-table-etaf--walk-cols
                  state 6 (- (* 4 (grid-table-etaf--col-pixels state 3))))
                 2))
      ;; Dragged two empty columns further, it is still drawn, there.
      (etaf-drag-step (grid-table-etaf--runtime) 'grid-table-etaf-chart-0
                      (* 2 (+ 2 grid-table-etaf--blank-col-chars)) 0)
      (should (equal (plist-get (car (grid-table-charts source)) :anchor) '(0 . 5)))
      (let ((geometry (grid-table-etaf-test--geometry 'grid-table-etaf-chart-0)))
        (should geometry)
        (should (>= (plist-get geometry :x)
                    (+ real (* 2 (grid-table-etaf--col-pixels state 3))))))
      ;; Select cells, then the chart: the cells stay selected for C-c k r.
      (grid-table-etaf-chart-deselect)
      (grid-table-etaf-goto 0 0)
      (grid-table-etaf-goto 5 2 t)
      (grid-table-etaf-chart-next)
      (should (equal (grid-table-etaf-selection) '(0 0 5 2)))
      (grid-table-etaf-chart-range)
      (should (equal (plist-get (car (grid-table-charts source)) :range) "A1:C6")))))

(ert-deftest grid-table-etaf-paste-counts-the-cells-pasted ()
  "Pasting says how many cells it pasted, though some held the same."
  (grid-table-etaf-test--with-grid (8 4 100 12)
    (grid-table-etaf-goto 1 0)
    (grid-table-etaf-goto 2 1 t)
    (grid-table-etaf-copy)
    (let ((said nil))
      (cl-letf (((symbol-function 'message)
                 (lambda (format &rest args)
                   (setq said (and format (apply #'format-message format args))))))
        ;; Onto itself: nothing changes, four cells are pasted.
        (grid-table-etaf-paste)
        (should (equal said "Pasted 4 cells"))
        (grid-table-etaf-goto 5 0)
        (grid-table-etaf-paste)
        (should (equal said "Pasted 4 cells"))))))

(defun grid-table-etaf-test--cursor-shown-p ()
  "Return non-nil when the window shows the cursor's row and column.
An empty cell paints no text, so the cursor there has no text to mark."
  (let ((cursor (grid-table-etaf--cursor))
        (window (grid-table-etaf-test--window)))
    (and (memq (car cursor) (car window)) (memq (cdr cursor) (cdr window)) t)))

(ert-deftest grid-table-etaf-cursor-goes-past-the-edge ()
  "The cursor goes past the last row and column onto empty cells.
The window shows them, with their letters and numbers, as a
spreadsheet's does; moving there changes nothing."
  (grid-table-etaf-test--with-grid (4 3 100 12)
    (let ((size (lambda ()
                  (list (grid-get-row-count source) (grid-get-column-count source)))))
      (set-buffer-modified-p nil)
      ;; The window goes on past the last column and row.
      (should (memq 4 (cdr (grid-table-etaf-test--window))))
      (should (memq 6 (car (grid-table-etaf-test--window))))
      (should (string-match-p "\\_<E\\_>" (grid-table-etaf-test--text)))
      ;; Right past the last column, down past the last row.
      (grid-table-etaf-goto 0 2)
      (grid-table-cell-right)
      (grid-table-cell-right)
      (should (equal (grid-table-etaf--cursor) '(0 . 4)))
      (should (grid-table-etaf-test--cursor-shown-p))
      (grid-table-etaf-goto 3 0)
      (grid-table-next-line)
      (grid-table-next-line)
      (should (equal (grid-table-etaf--cursor) '(5 . 0)))
      (should (grid-table-etaf-test--cursor-shown-p))
      (should (string-match-p "^ *6 " (grid-table-etaf-test--text)))
      ;; The name box goes there too, far down, and the window follows.
      (grid-table-etaf-goto-address "H200")
      (should (equal (grid-table-etaf--cursor) '(199 . 7)))
      (should (grid-table-etaf-test--cursor-shown-p))
      (should (string-match-p "200" (grid-table-etaf-test--text)))
      ;; A range there selects, and its cells read as empty.
      (grid-table-etaf-goto-address "F10:G12")
      (should (equal (grid-table-etaf-selection) '(9 5 11 6)))
      ;; Nothing of that changed the sheet or made an undo step.
      (should (equal (funcall size) '(4 3)))
      (should-not (buffer-modified-p))
      (should-not (grid-table-etaf--state-undo grid-table-etaf--state))
      ;; Back up and left to the cells the sheet has.
      (grid-table-etaf-first-cell)
      (should (equal (grid-table-etaf--cursor) '(0 . 0))))))

(ert-deftest grid-table-etaf-writing-past-the-edge-grows-the-sheet ()
  "Writing on the empty cells past the edge grows the sheet to them.
The growing is part of the step the writing is, and undoing it takes
the new rows and columns back; clearing those cells changes nothing."
  (grid-table-etaf-test--with-grid (4 3 100 12)
    (let ((size (lambda ()
                  (list (grid-get-row-count source) (grid-get-column-count source)))))
      ;; A value typed at E7.
      (grid-table-etaf-goto 6 4)
      (grid-table-etaf--enter-cells grid-table-etaf--state '((6 4 "42")))
      (should (equal (funcall size) '(7 5)))
      (should (equal (grid-get-raw-value-at source 6 4) "42"))
      (should (grid-table-etaf--state-undo grid-table-etaf--state))
      (grid-table-etaf-undo)
      (should (equal (funcall size) '(4 3)))
      (should (equal (grid-get-raw-value-at source 6 4) ""))
      ;; Clearing empty cells out there grows nothing.
      (grid-table-etaf-goto 6 4)
      (grid-table-etaf-goto 8 5 t)
      (grid-table-etaf-clear-cells)
      (should (equal (funcall size) '(4 3)))
      ;; Bold on them does, in one step.
      (grid-table-etaf-toggle-bold)
      (should (equal (funcall size) '(9 6)))
      (should (plist-get (grid-get-style-at source 8 5) :bold))
      (grid-table-etaf-undo)
      (should (equal (funcall size) '(4 3)))
      ;; So does a merge reaching out there.
      (grid-table-etaf-goto 3 2)
      (grid-table-etaf-goto 5 4 t)
      (grid-table-etaf-merge)
      (should (equal (funcall size) '(6 5)))
      (should (grid-table--merge-at (grid-get-merges source) 5 4))
      (grid-table-etaf-undo)
      (should (equal (funcall size) '(4 3)))
      (should-not (grid-get-merges source))
      ;; Removing duplicates among empty cells removes nothing.
      (grid-table-etaf-goto 6 0)
      (grid-table-etaf-goto 9 1 t)
      (grid-table-etaf-remove-duplicates)
      (should (equal (funcall size) '(4 3))))))

(ert-deftest grid-table-etaf-spill-past-the-edge-grows-the-sheet ()
  "A typed formula spilling past the sheet's edge makes the sheet grow.
Excel's sheet has no edge short of its last row and column, so only a
cell in the way makes such a formula #SPILL!."
  (grid-table-etaf-test--with-grid (4 3 100 12)
    (let ((size (lambda ()
                  (list (grid-get-row-count source) (grid-get-column-count source)))))
      ;; Down past the last row: six rows from row 3 need nine.
      (grid-table-etaf-set-cell 2 0 "")
      (grid-table-etaf-set-cell 3 0 "=SEQUENCE(6)")
      (should (equal (funcall size) '(9 3)))
      (should (equal (grid-get-computed-value-at source 8 0) 6))
      ;; One undo takes back the formula and the rows it made.
      (grid-table-etaf-undo)
      (should (equal (funcall size) '(4 3)))
      (should-not (string-prefix-p "=" (grid-get-raw-value-at source 3 0)))
      ;; Right past the last column.
      (grid-table-etaf-set-cell 0 2 "=SEQUENCE(1,4)")
      (should (equal (funcall size) '(4 6)))
      (should (equal (grid-get-computed-value-at source 0 5) 4))
      (grid-table-etaf-undo)
      (should (equal (funcall size) '(4 3)))
      ;; A cell in the way keeps it #SPILL!, and nothing grows.
      (grid-table-etaf-set-cell 3 1 "=SEQUENCE(1,2)")
      (should (equal (funcall size) '(4 3)))
      (should (equal (grid-get-computed-value-at source 3 1) "#SPILL!"))
      ;; A formula that comes to spill past the edge when another cell
      ;; changes does not make the sheet grow, nor does recalculating.
      (grid-table-etaf-set-cell 3 1 "")
      (grid-table-etaf-set-cell 1 0 "1")
      (grid-table-etaf-set-cell 1 1 "=SEQUENCE(A2)")
      (should (equal (funcall size) '(4 3)))
      (grid-table-etaf-set-cell 1 0 "5")
      (should (equal (funcall size) '(4 3)))
      (should (equal (grid-get-computed-value-at source 1 1) "#SPILL!"))
      (grid-table-recalculate source t)
      (should (equal (funcall size) '(4 3))))))

(ert-deftest grid-table-etaf-general-numbers-show-eleven-characters ()
  "A cell shows a number as Excel's general format does; a copy keeps it whole."
  (grid-table-etaf-test--with-grid (4 3 100 12)
    (grid-table-etaf-set-cell 1 1 "=1/3")
    (should (string-match-p "0\\.333333333\\_>" (grid-table-etaf-test--text)))
    (should-not (string-match-p "0\\.3333333333" (grid-table-etaf-test--text)))
    (grid-table-etaf-goto 1 1)
    (grid-table-etaf-copy)
    (should (string-match-p "0\\.33333333333333" (current-kill 0)))))

(ert-deftest grid-table-etaf-name-for-a-formula ()
  "A name can stand for a formula, as Excel's Refers to: does."
  (grid-table-etaf-test--with-grid (8 4 100 12)
    ;; B2 holds 2.
    (grid-table-etaf-goto 1 1)
    (grid-table-etaf-define-name "Net")
    (grid-table-etaf-define-name "Gross" "Net*10")
    (should (equal (grid-workbook-name-definition (grid-workbook-of source) "Gross")
                   "=Net*10"))
    (grid-table-etaf-set-cell 6 0 "=Gross")
    (grid-table-etaf-set-cell 6 1 "=Twice(Net)")
    (should (equal (grid-get-computed-value-at source 6 0) 20))
    (should (equal (grid-get-computed-value-at source 6 1) "#NAME?"))
    (grid-table-etaf-define-name "Twice" "=LAMBDA(x,x*2)")
    (should (equal (grid-get-computed-value-at source 6 1) 4))
    ;; What does not read as a formula is refused, and nothing changes.
    (should-error (grid-table-etaf-define-name "Broken" "=SUM(") :type 'user-error)
    (should-error (grid-table-etaf-define-name "Empty" "=") :type 'user-error)
    (should-not (grid-workbook-name-definition (grid-workbook-of source) "Broken"))
    ;; Defining it is a step undo takes back.
    (grid-table-etaf-undo)
    (should (equal (grid-get-computed-value-at source 6 1) "#NAME?"))))

(provide 'grid-table-etaf-test)

