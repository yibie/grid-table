    (execute-kbd-macro (kbd "<down> <right> C-n C-f"))
    (should (equal (grid-table-etaf--cursor) '(2 . 2)))
    (execute-kbd-macro (kbd "TAB"))
    (should (equal (grid-table-etaf--cursor) '(2 . 3)))
    (execute-kbd-macro (kbd "<backtab> C-p"))
    (should (equal (grid-table-etaf--cursor) '(1 . 2)))
    (execute-kbd-macro (kbd "S-<down>"))
    (should (equal (grid-table-etaf-selection) '(1 2 2 2)))))

(ert-deftest grid-table-etaf-in-place-edit-commits-and-recalculates ()
  (grid-table-etaf-test--with-grid (6 5)
    (switch-to-buffer buffer)
    (grid-table-etaf-goto 2 1)
    (should (equal (grid-get-computed-value-at source 2 3) 10))
    (execute-kbd-macro (kbd "RET"))
    (should (grid-table-etaf--state-session grid-table-etaf--state))
    (execute-kbd-macro (kbd "C-a C-k 1 0 0 C-c C-c"))
    (should-not (grid-table-etaf--state-session grid-table-etaf--state))
    (should (equal (grid-table-etaf--cursor) '(2 . 1)))
    (should (equal (grid-get-raw-value-at source 2 1) "100"))
    (should-not (buffer-modified-p))
    (should (equal (grid-get-computed-value-at source 2 3) 106))
    (should (string-match-p "106" (grid-table-etaf-test--text)))
    ;; A recalculated value that outgrows its column widens it.
    (grid-table-etaf-goto 4 1)
    (execute-kbd-macro (kbd "RET C-a C-k 1 2 3 4 5 6 7 C-c C-c"))
    (should (string-match-p "1234579" (grid-table-etaf-test--text)))
    ;; A formula shows its source while edited and its value afterwards.
    (grid-table-etaf-goto 2 3)
    (execute-kbd-macro (kbd "<f2>"))
    (should (string-match-p "=B3" (grid-table-etaf-test--text)))
    (execute-kbd-macro (kbd "C-a C-k = B 3 * 2 C-c C-c"))
    (should (equal (grid-get-computed-value-at source 2 3) 200))
    (should-not (string-match-p "=B3" (grid-table-etaf-test--body)))))

(ert-deftest grid-table-etaf-typed-dates-and-number-formats ()
  (grid-table-etaf-test--with-grid (6 5)
    ;; Typing starts an edit here, as in Excel.
    (switch-to-buffer buffer)
    (let ((state grid-table-etaf--state))
      ;; A typed date is stored as a number and shown as typed.
      (grid-table-etaf-goto 2 1)
      (execute-kbd-macro (kbd "2 0 2 6 - 1 0 - 1 3 C-c C-c"))
      (should (equal (grid-get-raw-value-at source 2 1) "46308"))
      (should (string-match-p "2026-10-13" (grid-table-etaf-test--body)))
      (should-not (string-match-p "46308" (grid-table-etaf-test--text)))
      ;; Editing starts from the date, not from the number behind it.
      (execute-kbd-macro (kbd "<f2>"))
      (should (string-match-p "2026-10-13" (grid-table-etaf-test--body)))
      (execute-kbd-macro (kbd "C-c C-k"))
      ;; The value and its format are undone together.
      (let ((steps (length (grid-table-etaf--state-undo state))))
        (grid-table-etaf-undo)
        (should (= (length (grid-table-etaf--state-undo state)) (1- steps))))
      (should (equal (grid-get-raw-value-at source 2 1) "4"))
      (should-not (grid-get-style-at source 2 1))
      ;; Number formats apply to the selection.
      (grid-table-etaf-goto 3 1)
      (grid-table-etaf-set-cell 3 1 "0.256")
      (grid-table-etaf-format-percent)
      (should (string-match-p "26%" (grid-table-etaf-test--body)))
      (grid-table-etaf-more-decimals)
      (should (string-match-p "25\\.6%" (grid-table-etaf-test--body)))
      (grid-table-etaf-format-number 2)
      (should (string-match-p "0\\.26" (grid-table-etaf-test--body)))
      (grid-table-etaf-format-general)
      (should (equal (grid-get-display-value-at source 3 1) "0.256"))
      ;; Asked for by name, the general format shows a date's number.
      (grid-table-etaf-set-cell 3 2 "=DATE(2026,10,12)")
      (should (equal (grid-get-display-value-at source 3 2) "2026-10-12"))
      (grid-table-etaf-goto 3 2)
      (grid-table-etaf-format-general)
      (should (equal (grid-get-display-value-at source 3 2) "46307"))
      ;; A comparison that fails reads FALSE, an empty cell stays empty.
      (grid-table-etaf-set-cell 3 2 "=1=2")
      (should (equal (grid-get-display-value-at source 3 2) "FALSE"))
      (should (string-match-p "FALSE" (grid-table-etaf-test--body)))
      ;; The text format leaves the number there a number; what is typed
      ;; after it is text.
      (grid-table-etaf-set-cell 4 1 "007")
      (grid-table-etaf-set-cell 4 2 "=COUNT(B5:B5)")
      (should (equal (grid-get-computed-value-at source 4 2) 1))
      (grid-table-etaf-goto 4 1)
      (grid-table-etaf-format-text)
      (should (equal (grid-get-computed-value-at source 4 2) 1))
      (grid-table-etaf--enter-cells (grid-table-etaf--state-or-error)
                                    '((4 1 "007")))
      (should (equal (grid-get-display-value-at source 4 1) "007"))
      (should (equal (grid-get-computed-value-at source 4 2) 0)))))

(ert-deftest grid-table-etaf-paste-grows-the-grid ()
  (grid-table-etaf-test--with-grid (4 3)
    (let (kill-ring kill-ring-yank-pointer interprogram-cut-function
                    interprogram-paste-function)
      (kill-new "a\tb\tc\nd\te\tf\ng\th\ti")
      (grid-table-etaf-goto 2 1)
      (grid-table-etaf-paste)
      (should (equal (list (grid-get-row-count source)
                           (grid-get-column-count source))
                     '(5 4)))
      (should (equal (grid-get-raw-value-at source 4 3) "i"))
      (should (equal (grid-get-raw-value-at source 1 1) "2"))
      (should (string-match-p "i" (grid-table-etaf-test--body)))
      ;; The new lines and the values go back in one step.
      (grid-table-etaf-undo)
      (should (equal (list (grid-get-row-count source)
                           (grid-get-column-count source))
                     '(4 3)))
      (should (equal (grid-get-raw-value-at source 2 1) "4"))
      (grid-table-etaf-redo)
      (should (equal (grid-get-row-count source) 5))
      (should (equal (grid-get-raw-value-at source 4 3) "i")))))

(ert-deftest grid-table-etaf-column-widths-stay-with-their-columns ()
  (grid-table-etaf-test--with-grid (4 4)
    (grid-table-etaf-set-column-width 1 20)
    (should (= (aref (grid-table-etaf--state-widths grid-table-etaf--state) 1)
               20))
    ;; A column inserted before it moves the width along.
    (funcall (gethash :add-column source) source 0)
    (grid-table-refresh)
    (should (= (gethash 2 (grid-get-column-widths source)) 20))
    (should (= (aref (grid-table-etaf--state-widths grid-table-etaf--state) 2)
               20))
    ;; Rows and sorting leave it alone.
    (funcall (gethash :add-row source) source 1)
    (funcall (gethash :sort-by-column source) source 0 'descending)
    (grid-table-refresh)
    (should (= (gethash 2 (grid-get-column-widths source)) 20))
    ;; It is saved with the grid.
    (let ((file (make-temp-file "grid-widths-" nil ".grid")))
      (unwind-protect
          (progn
            (grid-table-persistence--save-to-file source file)
            (let ((back (grid-table-persistence-create-data-source-from-file
                         file)))
              (should (= (gethash 2 (grid-get-column-widths back)) 20))
              ;; The view uses it from the first showing.
              (let ((shown (generate-new-buffer " *grid-etaf-reopened*")))
                (unwind-protect
                    (with-current-buffer shown
                      (grid-table--show-grid-in-current-buffer back)
                      (should (= (aref (grid-table-etaf--state-widths
                                        grid-table-etaf--state)
                                       2)
                                 20)))
                  (kill-buffer shown)))))
        (delete-file file)))
    ;; Deleting the column forgets it.
    (funcall (gethash :delete-column source) source 2)
    (grid-table-refresh)
    (should (= (hash-table-count (grid-get-column-widths source)) 0))))

(ert-deftest grid-table-etaf-many-cells-recalculate-once ()
  "A fill of many cells recalculates the workbook once, not per cell.
Formulas calling a function defined after loading are computed on every
recalculation, so a recalculation per cell made a long fill quadratic."
  (grid-table-etaf-test--with-grid (60 4)
    (let ((grid-calc-functions (copy-hash-table grid-calc-functions))
          (recalculations 0))
      (grid-calc-defun TESTDOUBLE (value) (* 2 (grid-calc-to-number value)))
      (dotimes (row 59)
        (grid-set-raw-value-at source (1+ row) 0 (number-to-string row)))
      (grid-set-raw-value-at source 1 1 "=TESTDOUBLE(A2)")
      (grid-set-raw-value-at source 1 2 "=SUM(B2:B60)")
      (cl-letf* ((recalculate (symbol-function 'grid-table-calc-evaluate-models))
                 ((symbol-function 'grid-table-calc-evaluate-models)
                  (lambda (&rest args)
                    (cl-incf recalculations)
                    (apply recalculate args))))
        (grid-table-etaf-goto 1 1)
        (grid-table-etaf-goto 59 1 t)
        (grid-table-etaf-fill-down))
      (should (= recalculations 1))
      (should (equal (grid-get-computed-value-at source 59 1) 116))
      ;; What reads the filled cells sees their new values.
      (should (equal (grid-get-computed-value-at source 1 2)
                     (* 2 (apply #'+ (number-sequence 0 58))))))))

(ert-deftest grid-table-etaf-fill-continues-what-starts-the-selection ()
  (should (equal (mapcar #'car (grid-table-etaf--series '("1" "3") 3))
                 '("5" "7" "9")))
  (should (equal (mapcar #'car (grid-table-etaf--series '("5") 2)) '("6" "7")))
  (should (equal (mapcar #'car (grid-table-etaf--series '("0.1" "0.2") 2))
                 '("0.3" "0.4")))
  (should (equal (mapcar #'car (grid-table-etaf--series '("Week 08") 3))
                 '("Week 09" "Week 10" "Week 11")))
  (should (equal (mapcar #'car (grid-table-etaf--series '("a" "b") 3))
                 '("a" "b" "a")))
  (grid-table-etaf-test--with-grid (7 5)
    (let ((state grid-table-etaf--state))
      ;; Dates count on day by day and keep their format.
      (dotimes (row 5)
        (grid-set-raw-value-at source (1+ row) 0 ""))
      (grid-table-enter-value source 1 0 "2026-10-13")
      (grid-table-etaf-goto 1 0)
      (dotimes (_ 3) (grid-table-etaf-extend-down))
      (grid-table-etaf-fill-series)
      (should (equal (grid-get-display-value-at source 4 0) "2026-10-16"))
      (grid-table-etaf-undo)
      (should (equal (grid-get-raw-value-at source 4 0) ""))
      (should-not (grid-get-style-at source 4 0))
      ;; Fill down copies the first row; formulas follow their rows.
      (grid-set-raw-value-at source 1 3 "=B2*2")
      (grid-table-etaf-goto 1 3)
      (dotimes (_ 2) (grid-table-etaf-extend-down))
      (grid-table-etaf-fill-down)
      (should (equal (grid-get-raw-value-at source 3 3) "=B4*2"))
      (should (equal (grid-get-computed-value-at source 3 3) 12))
      ;; Fill right copies the first column.
      (grid-table-etaf-goto 5 1)
      (grid-table-etaf-extend-right)
      (grid-table-etaf-fill-right)
      (should (equal (grid-get-raw-value-at source 5 2)
                     (grid-get-raw-value-at source 5 1)))
      (should (grid-table-etaf--state-undo state)))))

(ert-deftest grid-table-etaf-find-and-replace-work-on-cells ()
  (grid-table-etaf-test--with-grid (6 5)
    (grid-set-raw-value-at source 2 2 "Apple pie")
    (grid-set-raw-value-at source 4 1 "apple")
    (grid-table-etaf-goto 1 0)
    (grid-table-etaf-find "APPLE")
    (should (equal (grid-table-etaf--cursor) '(2 . 2)))
    (grid-table-etaf-find "apple")
    (should (equal (grid-table-etaf--cursor) '(4 . 1)))
    ;; The search wraps, and goes backward on request.
    (grid-table-etaf-find "apple")
    (should (equal (grid-table-etaf--cursor) '(2 . 2)))
    (grid-table-etaf-find "apple" t)
    (should (equal (grid-table-etaf--cursor) '(4 . 1)))
    ;; A formula is found by what it shows and by what it says.
    (grid-table-etaf-find "=B3")
    (should (equal (grid-table-etaf--cursor) '(2 . 3)))
    ;; Replacing changes what cells store, as one step.
    (grid-table-etaf-goto 1 0)
    (grid-table-etaf-replace "apple" "pear")
    (should (equal (grid-get-raw-value-at source 2 2) "pear pie"))
    (should (equal (grid-get-raw-value-at source 4 1) "pear"))
    (grid-table-etaf-undo)
    (should (equal (grid-get-raw-value-at source 2 2) "Apple pie"))
    (should (equal (grid-get-raw-value-at source 4 1) "apple"))
    ;; A selection limits it.
    (grid-table-etaf-goto 2 2)
    (grid-table-etaf-extend-right)
    (grid-table-etaf-replace "apple" "plum")
    (should (equal (grid-get-raw-value-at source 2 2) "plum pie"))
    (should (equal (grid-get-raw-value-at source 4 1) "apple"))))

(ert-deftest grid-table-etaf-sheet-without-a-header-row ()
  (grid-table-etaf-test--with-grid (5 3)
    ;; With a header row a filter always leaves the first row shown.
    (grid-table-etaf-goto 2 0)
    (grid-table-etaf-filter-by-cell)
    (should (equal (append (grid-table-etaf--state-shown grid-table-etaf--state)
                           nil)
                   '(0 2)))
    (grid-table-etaf-clear-filters)
    ;; The first row cannot be deleted, nor a row put above it.
    (grid-table-etaf-goto 0 0)
    (grid-table-delete-row 0)
    (grid-table-insert-row-above)
    (should (equal (grid-get-row-count source) 5))
    (should (equal (grid-get-raw-value-at source 0 0) "H0"))
    ;; Without one it is a row like any other.
    (grid-table-toggle-header-row)
    (should-not (grid-table-header-row-p source))
    (grid-table-etaf-goto 2 0)
    (grid-table-etaf-filter-by-cell)
    (should (equal (append (grid-table-etaf--state-shown grid-table-etaf--state)
                           nil)
                   '(2)))
    (grid-table-etaf-clear-filters)
    (grid-table-etaf-goto 0 0)
    (grid-table-insert-row-above)
    (should (equal (grid-get-row-count source) 6))
    (should (equal (grid-get-raw-value-at source 0 0) ""))
    (should (equal (grid-get-raw-value-at source 1 0) "H0"))
    (grid-table-etaf-goto 0 0)
    (grid-table-delete-row 0)
    (should (equal (grid-get-raw-value-at source 0 0) "H0"))
    ;; Both are undone like any change of structure.
    (grid-table-etaf-undo)
    (should (equal (grid-get-raw-value-at source 1 0) "H0"))
    (grid-table-etaf-undo)
    (should (equal (grid-get-row-count source) 5))))

;; Model rows and columns the window of the current buffer shows.
(defun grid-table-etaf-test--window ()
  (let* ((state grid-table-etaf--state)
         (cols (grid-table-etaf--visible-cols
                state (etaf-value (grid-table-etaf--state-left state)))))
    (cons (grid-table-etaf--visible-rows
           state (etaf-value (grid-table-etaf--state-top state)) cols)
          cols)))

(ert-deftest grid-table-etaf-frozen-rows-and-columns-stay-in-place ()
  (grid-table-etaf-test--with-grid (60 30 60 12)
    ;; Rows above the cursor and columns left of it are frozen.
    (grid-table-etaf-goto 2 1)
    (grid-table-etaf-freeze-panes)
    (should (equal (grid-table-frozen source) '(2 . 1)))
    (grid-table-etaf-goto 40 20)
    (let ((window (grid-table-etaf-test--window)))
      (should (equal (cl-subseq (car window) 0 2) '(0 1)))
      (should (> (nth 2 (car window)) 2))
      (should (memq 40 (car window)))
      (should (= (car (cdr window)) 0))
      (should (> (nth 1 (cdr window)) 1))
      (should (memq 20 (cdr window))))
    ;; The frozen cells are painted, the ones scrolled past are not.
    (should (string-match-p "H0" (grid-table-etaf-test--text)))
    ;; Moving into the frozen rows leaves the rest where it is.
    (let ((before (grid-table-etaf-test--window)))
      (grid-table-etaf-goto 0 0)
      (should (equal (grid-table-etaf-test--window) before)))
    ;; Scrolling never moves the window over the frozen rows.
    (dotimes (_ 30) (grid-table-etaf-scroll-up))
    (should (equal (cl-subseq (car (grid-table-etaf-test--window)) 0 3)
                   '(0 1 2)))
    ;; A row put among the frozen ones is frozen with them; undoing the
    ;; row undoes that.
    (grid-table-etaf-goto 1 0)
    (grid-table-insert-row-above)
    (should (equal (grid-table-frozen source) '(3 . 1)))
    (grid-table-etaf-undo)
    (should (equal (grid-table-frozen source) '(2 . 1)))
    (funcall (gethash :add-column source) source 5)
    (should (equal (grid-table-frozen source) '(2 . 1)))
    (funcall (gethash :delete-column source) source 0)
    (grid-table-refresh)
    (should (equal (grid-table-frozen source) '(2 . 0)))
    ;; It is saved with the grid, and released on request.
    (let ((file (make-temp-file "grid-frozen-" nil ".grid")))
      (unwind-protect
          (progn
            (grid-table-persistence--save-to-file source file)
            (should (equal (grid-table-frozen
                            (grid-table-persistence-create-data-source-from-file
                             file))
                           '(2 . 0))))
        (delete-file file)))
    ;; A page is the rows that scroll.
    (grid-table-etaf-goto 2 3)
    (let ((page (grid-table-etaf--page-size)))
      (grid-table-etaf-page-down)
      (should (= (car (grid-table-etaf--cursor)) (+ 2 page))))
    ;; Frozen rows a window has no room for give way to one that scrolls.
    (grid-table-set-frozen source 30 0)
    (grid-table-refresh)
    (grid-table-etaf-goto 50 3)
    (let ((rows (car (grid-table-etaf-test--window))))
      (should (memq 50 rows))
      (should (<= (length rows) 9)))
    (grid-table-unfreeze-panes)
    (should (equal (grid-table-frozen source) '(0 . 0)))
    (grid-table-etaf-goto 40 3)
    (should-not (memq 0 (car (grid-table-etaf-test--window))))
    ;; More than the window holds cannot be frozen.
    (grid-table-etaf-goto 45 0)
    (should-error (grid-table-etaf-freeze-panes) :type 'user-error)
    (should (equal (grid-table-frozen source) '(0 . 0)))))

(ert-deftest grid-table-etaf-merge-across-the-frozen-columns ()
  (grid-table-etaf-test--with-grid (8 30 60 12)
    (dotimes (col 9)
      (grid-set-raw-value-at source 3 (1+ col) ""))
    (grid-merge-cells source 3 0 3 9)
    (grid-table-etaf-goto 0 1)
    (grid-table-etaf-freeze-panes)
    (grid-table-etaf-goto 5 12)
    ;; The window paints with the merge over the columns it shows.
    (let ((cols (cdr (grid-table-etaf-test--window))))
      (should (= (car cols) 0))
      (should (> (nth 1 cols) 1)))
    (should (string-match-p "3" (grid-table-etaf-test--text)))))

(ert-deftest grid-table-etaf-in-place-edit-cancels-cleanly ()
  (grid-table-etaf-test--with-grid (6 5)
    (switch-to-buffer buffer)
    (grid-table-etaf-goto 1 0)
    (execute-kbd-macro (kbd "RET z z z C-c C-k"))
    (should-not (grid-table-etaf--state-session grid-table-etaf--state))
    (should (equal (grid-get-raw-value-at source 1 0) "1"))
    (should-not (string-match-p "zzz" (grid-table-etaf-test--text)))
    ;; Moving away commits instead.
    (execute-kbd-macro (kbd "RET C-a C-k 7 7"))
    (grid-table-next-line)
    (should (equal (grid-get-raw-value-at source 1 0) "77"))
    (should (equal (grid-table-etaf--cursor) '(2 . 0)))
    (execute-kbd-macro (kbd "RET C-a C-k 8 8 TAB"))
    (should-not (grid-table-etaf--state-session grid-table-etaf--state))
    (should (equal (grid-get-raw-value-at source 2 0) "88"))
    (should (equal (grid-table-etaf--cursor) '(2 . 1)))))

(ert-deftest grid-table-etaf-typing-replaces-the-cell-and-return-moves-down ()
  (grid-table-etaf-test--with-grid (6 5)
    ;; Typing starts an edit here, as in Excel.
    (switch-to-buffer buffer)
    (grid-table-etaf-goto 1 1)
    (execute-kbd-macro (kbd "4 2 RET"))
    (should (equal (grid-get-raw-value-at source 1 1) "42"))
    (should (equal (grid-table-etaf--cursor) '(2 . 1)))
    (should-not (grid-table-etaf--state-session grid-table-etaf--state))
    ;; Letters, the old command keys included, and SPC and ? are text.
    (execute-kbd-macro (kbd "q SPC n ? RET"))
    (should (equal (grid-get-raw-value-at source 2 1) "q n?"))
    (should (buffer-live-p buffer))
    (execute-kbd-macro (kbd "= B 2 * 2 TAB"))
    (should (equal (grid-get-computed-value-at source 3 1) 84))
    (should (equal (grid-table-etaf--cursor) '(3 . 2)))
    ;; Non-ASCII text reaches the cell through the same path.
    (execute-kbd-macro (vconcat "中文" (kbd "RET")))
    (should (equal (grid-get-raw-value-at source 3 2) "中文"))
    ;; F2 keeps the existing text.
    (grid-table-etaf-goto 1 1)
    (execute-kbd-macro (kbd "<f2> 0 RET"))
    (should (equal (grid-get-raw-value-at source 1 1) "420"))
    ;; With the option off a typed key changes nothing; RET starts the edit.
    (setq-local grid-table-etaf-type-to-edit nil)
    (grid-table-etaf-goto 1 1)
    (execute-kbd-macro (kbd "7"))
    (should (equal (grid-get-raw-value-at source 1 1) "420"))
    (should-not (grid-table-etaf--state-session grid-table-etaf--state))
    (execute-kbd-macro (kbd "RET 7 RET"))
    (should (equal (grid-get-raw-value-at source 1 1) "4207"))))

(ert-deftest grid-table-etaf-empty-cell-can-be-edited ()
  (grid-table-etaf-test--with-grid (6 5)
    (switch-to-buffer buffer)
    (grid-set-raw-value-at source 3 2 "")
    (grid-table-refresh)
    (grid-table-etaf-goto 3 2)
    (execute-kbd-macro (kbd "RET a b c RET"))
    (should (equal (grid-get-raw-value-at source 3 2) "abc"))))

(ert-deftest grid-table-etaf-paste-passes-over-filtered-rows ()
  (grid-table-etaf-test--with-grid (12 4 100 20)
    ;; Column B holds 2, 4, ...: rows 1 to 5 are hidden.
    (grid-table-etaf-filter-column 1 ">" "10")
    (grid-table-etaf-goto 0 0)
    (kill-new "x\ny\nz")
    (grid-table-etaf-paste)
    (should (equal (grid-get-raw-value-at source 0 0) "x"))
    (should (equal (grid-get-raw-value-at source 1 0) "1"))
    (should (equal (grid-get-raw-value-at source 6 0) "y"))
    (should (equal (grid-get-raw-value-at source 7 0) "z"))))

(ert-deftest grid-table-etaf-column-widths-and-freezing-undo ()
  (grid-table-etaf-test--with-grid (20 6 100 12)
    (let ((before (aref (grid-table-etaf--state-widths grid-table-etaf--state) 1))
          (drag (grid-table-etaf--drag-resize (current-buffer) 1))
          (step (grid-table-etaf--char-width)))
      ;; One drag is one step, however many moves it takes.
      (funcall drag '(:phase start))
      (funcall drag (list :phase 'move :delta (cons (* 3 step) 0)))
      (funcall drag (list :phase 'end :delta (cons (* 5 step) 0)))
      (should (= (aref (grid-table-etaf--state-widths grid-table-etaf--state) 1)
                 (+ before 5)))
      (grid-table-etaf-undo)
      (should (= (aref (grid-table-etaf--state-widths grid-table-etaf--state) 1)
                 before))
      (should-not (gethash 1 (grid-table-etaf--manual grid-table-etaf--state)))
      (grid-table-etaf-redo)
      (should (= (aref (grid-table-etaf--state-widths grid-table-etaf--state) 1)
                 (+ before 5))))
    (grid-table-etaf-goto 2 1)
    (grid-table-etaf-freeze-panes)
    (grid-table-unfreeze-panes)
    (should (equal (grid-table-frozen source) '(0 . 0)))
    (grid-table-etaf-undo)
    (should (equal (grid-table-frozen source) '(2 . 1)))
    (grid-table-etaf-undo)
    (should (equal (grid-table-frozen source) '(0 . 0)))))

(ert-deftest grid-table-etaf-goto-address-moves-and-selects ()
  (grid-table-etaf-test--with-grid (40 6 100 12)
    (should (equal (grid-table-etaf--parse-address "d12") '(nil 11 3 11 3)))
    (should (equal (grid-table-etaf--parse-address "'My Sheet'!B2:A1")
                   '("My Sheet" 0 0 1 1)))
    (should (equal (grid-table-etaf--parse-address "C:B") '(nil nil 1 nil 2)))
    (should-not (grid-table-etaf--parse-address "A1:B"))
    (should-not (grid-table-etaf--parse-address "hello"))
    (grid-table-etaf-goto-address "D30")
    (should (equal (grid-table-etaf--cursor) '(29 . 3)))
    (should (memq 29 (car (grid-table-etaf-test--window))))
    (grid-table-etaf-goto-address "B2:C4")
    (should (equal (grid-table-etaf-selection) '(1 1 3 2)))
    (grid-table-etaf-goto-address "5:6")
    (should (equal (grid-table-etaf-selection) '(4 0 5 5)))
    ;; Past the last row are empty cells, as in a spreadsheet; past the
    ;; most rows a sheet may have is nothing.
    (grid-table-etaf-goto-address "A99")
    (should (equal (grid-table-etaf--cursor) '(98 . 0)))
    (should-error (grid-table-etaf-goto-address "A1048577") :type 'user-error)
    (should-error (grid-table-etaf-goto-address "nonsense") :type 'user-error)
    ;; Another sheet is shown first.
    (grid-table-sheet-new "Totals")
    (grid-table-etaf-goto-address "Sheet1!C3")
    (should (equal (grid-workbook-sheet-name grid-table--data-source) "Sheet1"))
    (should (equal (grid-table-etaf--cursor) '(2 . 2)))
    ;; The keys reach the command through the view.
    (switch-to-buffer (current-buffer))
    (cl-letf (((symbol-function 'completing-read)
               (lambda (&rest _) "E7")))
      (execute-kbd-macro (kbd "C-c g")))
    (should (equal (grid-table-etaf--cursor) '(6 . 4)))))

(ert-deftest grid-table-etaf-traces-precedents-and-dependents ()
  (grid-table-etaf-test--with-grid (8 5 100 12)
    ;; D3 is =B3+C3.
    (grid-table-etaf-goto 2 3)
    (should (string-match-p "2 precedents" (grid-table-etaf-trace-precedents)))
    (should (eq (grid-table-etaf--traced source 2 1) 'precedent))
    (should (eq (grid-table-etaf--traced source 2 2) 'precedent))
    (should-not (grid-table-etaf--traced source 2 3))
    ;; A formula elsewhere reading a range that takes in B3.
    (grid-table-etaf-set-cell 6 4 "=SUM(B:B)")
    (should-not grid-table-etaf--traces)
    (grid-table-sheet-new "Totals")
    (grid-table-etaf-set-cell 1 0 "=Sheet1!B3*2")
    (grid-table-sheet-select "Sheet1")
    (grid-table-etaf-goto 2 1)
    (should (string-match-p "3 dependents (1 on other sheets)"
                            (grid-table-etaf-trace-dependents)))
    (should (eq (grid-table-etaf--traced source 2 3) 'dependent))
    (should (eq (grid-table-etaf--traced source 6 4) 'dependent))
    (should-not (grid-table-etaf--traced source 3 3))
    ;; Visiting them goes to the other sheet in turn.
    (grid-table-etaf-next-trace)
    (should (equal (grid-table-etaf--cursor) '(2 . 3)))
    (grid-table-etaf-next-trace)
    (should (equal (grid-table-etaf--cursor) '(6 . 4)))
    (grid-table-etaf-next-trace)
    (should (equal (grid-workbook-sheet-name grid-table--data-source) "Totals"))
    (should (equal (grid-table-etaf--cursor) '(1 . 0)))
    (grid-table-etaf-clear-traces)
    (should-not grid-table-etaf--traces)
    (should-error (grid-table-etaf-next-trace) :type 'user-error)
    (grid-table-etaf-goto 0 0)
    (should-error (grid-table-etaf-trace-precedents) :type 'user-error)
    ;; Undoing an edit drops the traces it would make stale.
    (grid-table-sheet-select "Sheet1")
    (grid-table-etaf-goto 2 1)
    (grid-table-etaf-trace-dependents)
    (should grid-table-etaf--traces)
    (grid-table-etaf-undo)
    (should-not grid-table-etaf--traces)))

(ert-deftest grid-table-etaf-paste-special ()
  (grid-table-etaf-test--with-grid (14 5 100 12)
    ;; D2 is =B2+C2, which shows 5; make it bold.
    (grid-table-etaf-goto 1 3)
    (grid-table-etaf-toggle-bold)
    (grid-table-etaf-copy)
    ;; Values: the number shown, the target's format left alone.
