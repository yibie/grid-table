;;; grid-table-etaf-test.el --- ETAF renderer tests -*- lexical-binding: t; -*-

;;; Commentary:

;; These tests need the ecss, ebox and etaf repository roots on `load-path';
;; run them with `make test-etaf ETAF_SRC=/path/to/checkouts'.  They are
;; skipped when ETAF cannot be loaded.

;;; Code:

(require 'ert)
(setq load-prefer-newer t)
(require 'grid-table)
(defvar grid-table-etaf-mount-options)

(defconst grid-table-etaf-test--available
  (require 'grid-table-etaf nil t))

(defun grid-table-etaf-test--rows (rows cols)
  "Return ROWS by COLS raw values; column D holds =B+C formulas."
  (cl-loop for row below rows collect
           (cl-loop for col below cols collect
                    (cond ((= row 0) (format "H%d" col))
                          ((= col 3) (format "=B%d+C%d" (1+ row) (1+ row)))
                          (t (number-to-string (* row (1+ col))))))))

(defmacro grid-table-etaf-test--with-grid (spec &rest body)
  "Show a grid described by SPEC through ETAF and run BODY in its buffer.
SPEC is (ROWS COLS &optional VIEWPORT-COLUMNS VIEWPORT-LINES)."
  (declare (indent 1))
  `(progn
     (skip-unless grid-table-etaf-test--available)
     (let* ((grid-table-renderer 'etaf)
            (grid-table--etaf-warned nil)
            (grid-table-etaf-mount-options
             (list :viewport-width ,(or (nth 2 spec) 100)
                   :viewport-height ,(or (nth 3 spec) 12)))
            (source (make-default-data-source
                     (make-list ,(nth 1 spec) "")
                     (grid-table-etaf-test--rows ,(nth 0 spec) ,(nth 1 spec))))
            (buffer (generate-new-buffer " *grid-etaf-test*")))
       (unwind-protect
           (with-current-buffer buffer
             (grid-table--show-grid-in-current-buffer source)
             ,@body)
         (kill-buffer buffer)))))

(defun grid-table-etaf-test--text ()
  "Return the painted text of the current buffer without properties."
  (buffer-substring-no-properties (point-min) (point-max)))

(defun grid-table-etaf-test--body ()
  "Return the painted text below the formula bar."
  (let ((text (grid-table-etaf-test--text)))
    (substring text (1+ (string-search "\n" text)))))

(defun grid-table-etaf-test--cursor-painted-p ()
  "Return non-nil when the cursor cell is in the buffer."
  (etaf-host-ref-position (etaf-runtime-for-buffer (current-buffer))
                          'grid-table-etaf-cursor))

(ert-deftest grid-table-etaf-show-mounts-the-grid ()
  (grid-table-etaf-test--with-grid (6 5)
    (should (eq major-mode 'grid-table-etaf-mode))
    (should (grid-table--etaf-p))
    (should (etaf-runtime-for-buffer (current-buffer)))
    (should-not (buffer-modified-p))
    (should (equal (plist-get (grid-table-get-cell-at-point) :slice-row) 0))
    (should (equal (plist-get (grid-table-get-cell-at-point) :slice-col) 1))
    (should (string-match-p "H0" (grid-table-etaf-test--text)))))

(ert-deftest grid-table-etaf-classic-renderer-stays-selectable ()
  (let ((grid-table-renderer 'classic)
        (source (make-default-data-source
                 '("" "") (grid-table-etaf-test--rows 3 2))))
    (with-temp-buffer
      (grid-table--enter-classic-mode)
      (grid-table--show-grid-in-current-buffer source)
      (should (eq major-mode 'grid-table-mode))
      (should-not (grid-table--etaf-p))
      (should (string-match-p "│" (grid-table-etaf-test--text))))))

(ert-deftest grid-table-etaf-navigation-commands-move-the-cursor ()
  (grid-table-etaf-test--with-grid (6 5)
    (grid-table-next-line)
    (grid-table-cell-right)
    (should (equal (grid-table-etaf--cursor) '(1 . 1)))
    (grid-table-previous-line)
    (grid-table-cell-left)
    (should (equal (grid-table-etaf--cursor) '(0 . 0)))
    (grid-table-cell-left)
    (grid-table-previous-line)
    (should (equal (grid-table-etaf--cursor) '(0 . 0)))
    (grid-table-move-end-of-line)
    (should (equal (grid-table-etaf--cursor) '(0 . 4)))
    (grid-table-next-cell)
    (should (equal (grid-table-etaf--cursor) '(1 . 0)))
    (grid-table-previous-cell)
    (should (equal (grid-table-etaf--cursor) '(0 . 4)))
    (grid-table-etaf-last-cell)
    (should (equal (grid-table-etaf--cursor) '(5 . 4)))))

(ert-deftest grid-table-etaf-only-the-window-is-mounted ()
  (grid-table-etaf-test--with-grid (500 30 100 12)
    (should (<= (count-lines (point-min) (point-max)) 12))
    (grid-table-etaf-goto 400 0)
    (should (grid-table-etaf-test--cursor-painted-p))
    (should (<= (count-lines (point-min) (point-max)) 12))
    (should (string-match-p "401" (grid-table-etaf-test--text)))
    (should-not (string-match-p "\\_<2\\_>.*H0" (grid-table-etaf-test--text)))
    (grid-table-etaf-goto 400 27)
    (should (grid-table-etaf-test--cursor-painted-p))
    (should (string-match-p "AB" (grid-table-etaf-test--text)))
    (grid-table-etaf-first-cell)
    (should (grid-table-etaf-test--cursor-painted-p))
    (should (string-match-p "H0" (grid-table-etaf-test--text)))))

(ert-deftest grid-table-etaf-wheel-scrolls-without-moving-the-cursor ()
  (grid-table-etaf-test--with-grid (200 4 100 12)
    (grid-table-etaf-scroll-down)
    (grid-table-etaf-scroll-down)
    (should (equal (grid-table-etaf--cursor) '(0 . 0)))
    (should-not (grid-table-etaf-test--cursor-painted-p))
    (should (string-match-p "^ *7 " (grid-table-etaf-test--text)))
    (grid-table-next-line)
    (should (equal (grid-table-etaf--cursor) '(1 . 0)))
    (should (grid-table-etaf-test--cursor-painted-p))
    (grid-table-etaf-scroll-up)
    (should (grid-table-etaf-test--cursor-painted-p))))

(ert-deftest grid-table-etaf-falls-back-to-classic-when-mounting-fails ()
  (skip-unless grid-table-etaf-test--available)
  (let ((grid-table-renderer 'etaf)
        (grid-table--etaf-warned nil)
        (source (make-default-data-source
                 '("" "") (grid-table-etaf-test--rows 3 2))))
    (cl-letf (((symbol-function 'etaf-mount)
               (lambda (&rest _) (error "Stale ETAF"))))
      (with-temp-buffer
        (grid-table--show-grid-in-current-buffer source)
        (should (eq major-mode 'grid-table-mode))
        (should-not (grid-table--etaf-p))
        (should grid-table--etaf-warned)
        (should (string-match-p "│" (buffer-string)))))))

(ert-deftest grid-table-etaf-paging-follows-the-window-height ()
  (grid-table-etaf-test--with-grid (200 4 100 12)
    (grid-table-etaf-page-down)
    (should (equal (grid-table-etaf--cursor) '(9 . 0)))
    (grid-table-etaf-page-up)
    (should (equal (grid-table-etaf--cursor) '(0 . 0)))))

(ert-deftest grid-table-etaf-movement-steps-over-merged-cells ()
  (grid-table-etaf-test--with-grid (8 6)
    (grid-set-raw-value-at source 2 2 "")
    (grid-set-raw-value-at source 2 3 "")
    (grid-merge-cells source 2 1 2 3)
    (grid-table-refresh)
    (grid-table-etaf-goto 2 2)
    (let ((cell (grid-table-get-cell-at-point)))
      (should (equal (plist-get cell :anchor-col) 2))
      (should (equal (plist-get cell :col-start) 2))
      (should (equal (plist-get cell :col-end) 4))
      (should (equal (plist-get cell :slice-col) 3)))
    (grid-table-cell-right)
    (should (equal (grid-table-etaf--cursor) '(2 . 4)))
    (grid-table-cell-left)
    (grid-table-cell-left)
    (should (equal (grid-table-etaf--cursor) '(2 . 0)))
    (should (grid-table-etaf-test--cursor-painted-p))))

(ert-deftest grid-table-etaf-shared-commands-act-on-the-cursor ()
  (grid-table-etaf-test--with-grid (6 5)
    (grid-table-etaf-goto 2 1)
    (grid-table-add-row 2)
    (should (= (grid-get-row-count grid-table--data-source) 7))
    (grid-table-delete-row 3)
    (should (= (grid-get-row-count grid-table--data-source) 6))
    (grid-table-etaf-goto 4 4)
    (grid-table-edit-cell-with-value "")
    (grid-table-etaf-goto 4 3)
    (grid-table-edit-cell-with-value "wide")
    (grid-table-merge-cells "D5:E5")
    (should (equal (grid-get-merges grid-table--data-source) '((4 3 4 4))))
    (should (equal (grid-table-etaf--cursor) '(4 . 3)))
    (grid-table-unmerge-cell)
    (should-not (grid-get-merges grid-table--data-source))))

(ert-deftest grid-table-etaf-selection-extends-and-clears ()
  (grid-table-etaf-test--with-grid (6 5)
    (grid-table-etaf-goto 1 1)
    (grid-table-etaf-extend-down)
    (grid-table-etaf-extend-right)
    (should (equal (grid-table-etaf-selection) '(1 1 2 2)))
    (grid-table-etaf-clear-cells)
    (should (equal (grid-get-raw-value-at source 1 1) ""))
    (should (equal (grid-get-raw-value-at source 2 2) ""))
    (should (equal (grid-get-raw-value-at source 3 1) "6"))
    (grid-table-next-line)
    (should (equal (grid-table-etaf-selection) '(3 2 3 2)))))

(ert-deftest grid-table-etaf-formula-bar-shows-the-raw-value ()
  (grid-table-etaf-test--with-grid (6 5)
    (grid-table-etaf-goto 2 3)
    (let ((bar (car (split-string (grid-table-etaf-test--text) "\n"))))
      (should (string-match-p "D3" bar))
      (should (string-match-p "=B3\\+C3" bar)))
    ;; The grid itself shows the computed value.
    (should (string-match-p "\\_<10\\_>" (grid-table-etaf-test--text)))
    (grid-table-etaf-extend-down)
    (should (string-match-p
             "D3:D4" (car (split-string (grid-table-etaf-test--text) "\n"))))))

(ert-deftest grid-table-etaf-status-bar-summarizes-the-selection ()
  (grid-table-etaf-test--with-grid (6 5)
    (should (string-match-p "6 rows × 5 columns" (grid-table-etaf-test--text)))
    (grid-table-etaf-goto 0 1)
    (grid-table-etaf-extend-down)
    (grid-table-etaf-extend-down)
    ;; B1 is the text \"H1\"; B2 and B3 hold 2 and 4.
    (should (string-match-p "Count: 3   Sum: 6   Average: 3 *\\'"
                            (grid-table-etaf-test--text)))
    (grid-table-etaf-goto 0 0)
    (grid-table-etaf-extend-right)
    (should (string-match-p "Count: 2 *\\'" (grid-table-etaf-test--text)))))

(ert-deftest grid-table-etaf-copy-and-paste-keep-formulas ()
  (grid-table-etaf-test--with-grid (6 5)
    (let (kill-ring kill-ring-yank-pointer interprogram-cut-function
                    interprogram-paste-function)
      ;; C2:D3 holds 3, =B2+C2, 6, =B3+C3.
      (grid-table-etaf-goto 1 2)
      (grid-table-etaf-extend-down)
      (grid-table-etaf-extend-right)
      (grid-table-etaf-copy)
      (should (equal (current-kill 0) "3\t5\n6\t10"))
      (grid-table-etaf-goto 4 0)
      (grid-table-etaf-paste)
      (should (equal (grid-get-raw-value-at source 4 0) "3"))
      ;; Pasted three rows down and two columns left of where it was.
      (should (equal (grid-get-raw-value-at source 4 1) "=#REF!+A5"))
      (should (equal (grid-get-raw-value-at source 5 1) "=#REF!+A6"))
      (should (equal (grid-table-etaf-selection) '(4 0 5 1)))
      (grid-table-etaf-goto 4 3)
      (grid-table-etaf-paste)
      (should (equal (grid-get-raw-value-at source 4 4) "=C5+D5"))
      (should (equal (grid-get-raw-value-at source 5 4) "=C6+D6"))
      ;; Text from elsewhere is split on tabs and newlines and clipped.
      (kill-new "x\ty\tz\n\"multi\nline\"\tw\n")
      (grid-table-etaf-goto 4 3)
      (grid-table-etaf-paste)
      (should (equal (grid-get-raw-value-at source 4 3) "x"))
      (should (equal (grid-get-raw-value-at source 4 4) "y"))
      (should (equal (grid-get-raw-value-at source 5 3) "multi\nline"))
      (should (equal (grid-get-raw-value-at source 5 4) "w"))
      ;; One copied cell fills the selection.
      (grid-table-etaf-goto 0 0)
      (grid-table-etaf-copy)
      (grid-table-etaf-goto 1 0)
      (grid-table-etaf-extend-down)
      (grid-table-etaf-paste)
      (should (equal (grid-get-raw-value-at source 1 0) "H0"))
      (should (equal (grid-get-raw-value-at source 2 0) "H0"))
      ;; Cutting empties the source range.
      (grid-table-etaf-goto 3 2)
      (grid-table-etaf-cut)
      (should (equal (grid-get-raw-value-at source 3 2) ""))
      (should (equal (current-kill 0) "9"))
      ;; One copied formula fills a range, adjusted for each cell; a cut
      ;; formula moves unchanged.
      (grid-table-etaf-set-cell 1 3 "=B2+C2")
      (grid-table-etaf-goto 1 3)
      (grid-table-etaf-copy)
      (grid-table-etaf-goto 2 3)
      (grid-table-etaf-extend-down)
      (grid-table-etaf-paste)
      (should (equal (grid-get-raw-value-at source 2 3) "=B3+C3"))
      (should (equal (grid-get-raw-value-at source 3 3) "=B4+C4"))
      (grid-table-etaf-goto 1 3)
      (grid-table-etaf-cut)
      (grid-table-etaf-goto 5 0)
      (grid-table-etaf-paste)
      (should (equal (grid-get-raw-value-at source 5 0) "=B2+C2")))))

(ert-deftest grid-table-etaf-undo-and-redo-restore-cells ()
  (grid-table-etaf-test--with-grid (6 5)
    (switch-to-buffer buffer)
    (grid-table-etaf-goto 2 1)
    (execute-kbd-macro (kbd "9 9 RET"))
    (should (equal (grid-get-computed-value-at source 2 3) 105))
    (grid-table-etaf-goto 1 0)
    (grid-table-etaf-extend-down)
    (grid-table-etaf-extend-right)
    (grid-table-etaf-clear-cells)
    (should (equal (grid-get-raw-value-at source 2 1) ""))
    ;; The whole cleared range comes back as one step.
    (execute-kbd-macro (kbd "C-/"))
    (should (equal (grid-get-raw-value-at source 1 0) "1"))
    (should (equal (grid-get-raw-value-at source 2 1) "99"))
    (execute-kbd-macro (kbd "C-/"))
    (should (equal (grid-get-raw-value-at source 2 1) "4"))
    (should (equal (grid-get-computed-value-at source 2 3) 10))
    (should (equal (grid-table-etaf--cursor) '(2 . 1)))
    (should-error (grid-table-etaf-undo) :type 'user-error)
    (execute-kbd-macro (kbd "C-?"))
    (should (equal (grid-get-raw-value-at source 2 1) "99"))
    (grid-table-etaf-redo)
    (should (equal (grid-get-raw-value-at source 2 1) ""))
    ;; A new change drops what could be redone.
    (grid-table-etaf-undo)
    (grid-table-etaf-set-cell 0 0 "new")
    (should-error (grid-table-etaf-redo) :type 'user-error)))

(ert-deftest grid-table-etaf-undo-restores-structural-changes ()
  (grid-table-etaf-test--with-grid (6 5)
    (grid-table-etaf-goto 2 1)
    (grid-table-add-row 2)
    (should (= (grid-get-row-count grid-table--data-source) 7))
    (grid-table-etaf-set-cell 3 0 "inserted")
    (grid-table-etaf-goto 4 4)
    (grid-table-etaf-set-cell 4 4 "")
    (grid-table-merge-cells "D5:E5")
    (should (grid-get-merges grid-table--data-source))
    (grid-table-etaf-undo)
    (should-not (grid-get-merges grid-table--data-source))
    (grid-table-etaf-undo)
    (grid-table-etaf-undo)
    (should (equal (grid-get-raw-value-at source 3 0) ""))
    (grid-table-etaf-undo)
    (should (= (grid-get-row-count grid-table--data-source) 6))
    (should (equal (grid-get-raw-value-at source 3 0) "3"))
    (grid-table-etaf-redo)
    (grid-table-etaf-redo)
    (should (= (grid-get-row-count grid-table--data-source) 7))
    (should (equal (grid-get-raw-value-at source 3 0) "inserted"))))

(ert-deftest grid-table-etaf-headers-select-rows-and-columns ()
  (grid-table-etaf-test--with-grid (200 5 100 12)
    (grid-table-etaf-goto 3 2)
    (grid-table-etaf-select-column 1)
    (should (equal (grid-table-etaf-selection) '(0 1 199 1)))
    ;; Selecting a whole column does not scroll the window to its end.
    (should (string-match-p "^ *1 " (grid-table-etaf-test--text)))
    (should (string-match-p "B1:B200" (grid-table-etaf-test--text)))
    (grid-table-etaf-select-row 4)
    (should (equal (grid-table-etaf-selection) '(4 0 4 4)))
    (grid-table-etaf-select-all)
    (should (equal (grid-table-etaf-selection) '(0 0 199 4)))
    (should (string-match-p "Count: 1000" (grid-table-etaf-test--text)))))

(ert-deftest grid-table-etaf-dragging-a-header-edge-resizes-the-column ()
  (grid-table-etaf-test--with-grid (6 5)
    (let ((resize (grid-table-etaf--drag-resize buffer 1))
          (widths (lambda () (grid-table-etaf--state-widths
                              grid-table-etaf--state))))
      (should (= (aref (funcall widths) 1) 5))
      (funcall resize '(:phase start :delta (0 . 0)))
      ;; One pixel is one column in batch mode.
      (funcall resize '(:phase move :delta (4 . 0)))
      (should (= (aref (funcall widths) 1) 9))
      (funcall resize '(:phase end :delta (7 . 0)))
      (should (= (aref (funcall widths) 1) 12))
      ;; A dragged width survives edits and refreshes.
      (grid-table-etaf-set-cell 2 1 "a much longer value than before")
      (grid-table-refresh)
      (should (= (aref (funcall widths) 1) 12))
      ;; A cancelled drag puts the width back.
      (funcall resize '(:phase start :delta (0 . 0)))
      (funcall resize '(:phase move :delta (-6 . 0)))
      (should (= (aref (funcall widths) 1) 6))
      (funcall resize '(:phase cancel :delta (-6 . 0)))
      (should (= (aref (funcall widths) 1) 12))
      ;; Structural changes drop dragged widths with the columns they named.
      (grid-table-add-column 1)
      (should (= (aref (funcall widths) 1) 5)))))

(defun grid-table-etaf-test--cursor-face ()
  "Return the painted face of the cursor cell's text as a string."
  (format "%S" (get-text-property
                (etaf-host-ref-position
                 (etaf-runtime-for-buffer (current-buffer))
                 'grid-table-etaf-cursor)
                'face)))

(ert-deftest grid-table-etaf-formats-apply-to-the-selection-and-undo ()
  (grid-table-etaf-test--with-grid (6 5)
    (grid-table-etaf-goto 1 1)
    (grid-table-etaf-extend-down)
    (grid-table-etaf-toggle-bold)
    (should (plist-get (grid-get-style-at source 1 1) :bold))
    (should (plist-get (grid-get-style-at source 2 1) :bold))
    (should-not (grid-get-style-at source 3 1))
    (grid-table-etaf-goto 1 1)
    (should (string-match-p "bold" (grid-table-etaf-test--cursor-face)))
    (grid-table-etaf-goto 3 1)
    (should-not (string-match-p "bold" (grid-table-etaf-test--cursor-face)))
    ;; Toggling follows the cursor cell: bold there means turn it off.
    (grid-table-etaf-goto 1 1)
    (grid-table-etaf-toggle-bold)
    (should-not (grid-get-style-at source 1 1))
    (should (plist-get (grid-get-style-at source 2 1) :bold))
    (grid-table-etaf-undo)
    (should (plist-get (grid-get-style-at source 1 1) :bold))
    (grid-table-etaf-set-fill-color "#ffeeaa")
    (grid-table-etaf-align-center)
    (should (equal (plist-get (grid-get-style-at source 1 1) :background)
                   "#ffeeaa"))
    (should (eq (plist-get (grid-get-style-at source 1 1) :align) 'center))
    (grid-table-etaf-set-fill-color "")
    (should-not (plist-get (grid-get-style-at source 1 1) :background))
    (grid-table-etaf-clear-format)
    (should-not (grid-get-style-at source 1 1))
    (grid-table-etaf-undo)
    (should (eq (plist-get (grid-get-style-at source 1 1) :align) 'center))))

(ert-deftest grid-table-etaf-conditional-formats-follow-values ()
  (grid-table-etaf-test--with-grid (6 5)
    ;; B2:B6 holds 2 4 6 8 10.
    (grid-table-etaf-goto 1 1)
    (grid-table-etaf-goto 5 1 t)
    (grid-table-etaf-add-conditional-format ">" "5" '(:bold t))
    (should (equal (grid-get-conditional-formats source)
                   '((1 1 5 1 ">" "5" (:bold t)))))
    (grid-table-etaf-goto 3 1)
    (should (string-match-p "bold" (grid-table-etaf-test--cursor-face)))
    (grid-table-etaf-goto 1 1)
    (should-not (string-match-p "bold" (grid-table-etaf-test--cursor-face)))
    (grid-table-etaf-set-cell 1 1 "50")
    (should (string-match-p "bold" (grid-table-etaf-test--cursor-face)))
    (grid-table-etaf-undo)
    (grid-table-etaf-undo)
    (should-not (grid-get-conditional-formats source))
    (grid-table-etaf-redo)
    (grid-table-etaf-goto 2 0)
    (grid-table-etaf-extend-right)
    (grid-table-etaf-clear-conditional-formats)
    (should-not (grid-get-conditional-formats source))))

(ert-deftest grid-table-etaf-merges-the-selected-rectangle ()
  (grid-table-etaf-test--with-grid (8 6)
    (dolist (cell '((2 2) (3 1) (3 2) (4 1) (4 2)))
      (grid-table-etaf-set-cell (car cell) (cadr cell) ""))
    (grid-table-etaf-goto 2 1)
    (grid-table-etaf-goto 4 2 t)
    (grid-table-etaf-merge)
    (should (equal (grid-get-merges grid-table--data-source) '((2 1 4 2))))
    ;; The cursor anywhere inside is the one merged cell.
    (grid-table-etaf-goto 3 2)
    (let ((cell (grid-table-get-cell-at-point)))
      (should (equal (plist-get cell :anchor-row) 2))
      (should (equal (plist-get cell :row-end) 4))
      (should (equal (plist-get cell :col-start) 2))
      (should (equal (plist-get cell :col-end) 3)))
    (should (grid-table-etaf-test--cursor-painted-p))
    (should (equal (etaf-host-ref-size
                    (etaf-runtime-for-buffer (current-buffer))
                    (grid-table-etaf--slot-ref 2 1))
                   ;; Two 5-wide columns with their padding and grid lines,
                   ;; three rows tall.
                   '(16 . 3)))
    ;; Movement leaves the rectangle by its edges.
    (grid-table-next-line)
    (should (equal (grid-table-etaf--cursor) '(5 . 2)))
    (grid-table-etaf-goto 3 2)
    (grid-table-cell-left)
    (should (equal (grid-table-etaf--cursor) '(3 . 0)))
    ;; A non-empty covered cell refuses the merge and changes nothing.
    (grid-table-etaf-goto 5 3)
    (grid-table-etaf-goto 6 4 t)
    (should-error (grid-table-etaf-merge))
    (should (equal (grid-get-merges grid-table--data-source) '((2 1 4 2))))
    (grid-table-etaf-goto 3 1)
    (grid-table-unmerge-cell)
    (should-not (grid-get-merges grid-table--data-source))))

(ert-deftest grid-table-etaf-charts-are-drawn-in-their-cell ()
  (grid-table-etaf-test--with-grid (6 5 160 30)
    (grid-table-etaf-set-cell 2 4 "=COUNTPLOT(A2:A6,\"Counts\")")
    (let ((value (grid-get-computed-value-at source 2 4))
          (text (grid-table-etaf-test--text)))
      (should (plist-get value :grid-chart))
      (should-not (string-match-p "\\[Chart\\]" text))
      (should (string-match-p "Counts" text))
      ;; The column and the row grew to the size of the drawing.
      (let ((drawing (grid-table-chart-content value)))
        (should (>= (aref (grid-table-etaf--state-widths grid-table-etaf--state)
                          4)
                    (apply #'max (mapcar #'string-width
                                         (split-string drawing "\n")))))
        (should (> (count-lines (point-min) (point-max)) 10))))
    ;; Editing shows the formula, not the drawing.
    (grid-table-etaf-goto 2 4)
    (should (string-match-p "=COUNTPLOT" (car (split-string
                                               (grid-table-etaf-test--text)
                                               "\n"))))))

(ert-deftest grid-table-etaf-keys-reach-the-sheet ()
  (grid-table-etaf-test--with-grid (6 5)
    (switch-to-buffer buffer)
    (execute-kbd-macro (kbd "<down> <right> C-n C-f"))
    (should (equal (grid-table-etaf--cursor) '(2 . 2)))
    (execute-kbd-macro (kbd "TAB"))
    (should (equal (grid-table-etaf--cursor) '(2 . 3)))
    (execute-kbd-macro (kbd "<backtab> C-p"))
    (should (equal (grid-table-etaf--cursor) '(1 . 2)))
    (execute-kbd-macro (kbd "S-<down>"))
    (should (equal (grid-table-etaf-selection) '(1 2 2 2)))))

(ert-deftest grid-table-etaf-in-place-edit-commits-and-recalculates ()
  (grid-table-etaf-test--with-grid (6 5)
    (switch-to-buffer buffer)
    (grid-table-etaf-goto 2 1)
    (should (equal (grid-get-computed-value-at source 2 3) 10))
    (execute-kbd-macro (kbd "RET"))
    (should (grid-table-etaf--state-session grid-table-etaf--state))
    (execute-kbd-macro (kbd "C-a C-k 1 0 0 C-c C-c"))
    (should-not (grid-table-etaf--state-session grid-table-etaf--state))
    (should (equal (grid-table-etaf--cursor) '(2 . 1)))
    (should (equal (grid-get-raw-value-at source 2 1) "100"))
    (should-not (buffer-modified-p))
    (should (equal (grid-get-computed-value-at source 2 3) 106))
    (should (string-match-p "106" (grid-table-etaf-test--text)))
    ;; A recalculated value that outgrows its column widens it.
    (grid-table-etaf-goto 4 1)
    (execute-kbd-macro (kbd "RET C-a C-k 1 2 3 4 5 6 7 C-c C-c"))
    (should (string-match-p "1234579" (grid-table-etaf-test--text)))
    ;; A formula shows its source while edited and its value afterwards.
    (grid-table-etaf-goto 2 3)
    (execute-kbd-macro (kbd "<f2>"))
    (should (string-match-p "=B3" (grid-table-etaf-test--text)))
    (execute-kbd-macro (kbd "C-a C-k = B 3 * 2 C-c C-c"))
    (should (equal (grid-get-computed-value-at source 2 3) 200))
    (should-not (string-match-p "=B3" (grid-table-etaf-test--body)))))

(ert-deftest grid-table-etaf-in-place-edit-cancels-cleanly ()
  (grid-table-etaf-test--with-grid (6 5)
    (switch-to-buffer buffer)
    (grid-table-etaf-goto 1 0)
    (execute-kbd-macro (kbd "RET z z z C-c C-k"))
    (should-not (grid-table-etaf--state-session grid-table-etaf--state))
    (should (equal (grid-get-raw-value-at source 1 0) "1"))
    (should-not (string-match-p "zzz" (grid-table-etaf-test--text)))
    ;; Moving away commits instead.
    (execute-kbd-macro (kbd "RET C-a C-k 7 7"))
    (grid-table-next-line)
    (should (equal (grid-get-raw-value-at source 1 0) "77"))
    (should (equal (grid-table-etaf--cursor) '(2 . 0)))
    (execute-kbd-macro (kbd "RET C-a C-k 8 8 TAB"))
    (should-not (grid-table-etaf--state-session grid-table-etaf--state))
    (should (equal (grid-get-raw-value-at source 2 0) "88"))
    (should (equal (grid-table-etaf--cursor) '(2 . 1)))))

(ert-deftest grid-table-etaf-typing-replaces-the-cell-and-return-moves-down ()
  (grid-table-etaf-test--with-grid (6 5)
    (switch-to-buffer buffer)
    (grid-table-etaf-goto 1 1)
    (execute-kbd-macro (kbd "4 2 RET"))
    (should (equal (grid-get-raw-value-at source 1 1) "42"))
    (should (equal (grid-table-etaf--cursor) '(2 . 1)))
    (should-not (grid-table-etaf--state-session grid-table-etaf--state))
    ;; Letters, the old command keys included, and SPC and ? are text.
    (execute-kbd-macro (kbd "q SPC n ? RET"))
    (should (equal (grid-get-raw-value-at source 2 1) "q n?"))
    (should (buffer-live-p buffer))
    (execute-kbd-macro (kbd "= B 2 * 2 TAB"))
    (should (equal (grid-get-computed-value-at source 3 1) 84))
    (should (equal (grid-table-etaf--cursor) '(3 . 2)))
    ;; Non-ASCII text reaches the cell through the same path.
    (execute-kbd-macro (vconcat "中文" (kbd "RET")))
    (should (equal (grid-get-raw-value-at source 3 2) "中文"))
    ;; F2 keeps the existing text.
    (grid-table-etaf-goto 1 1)
    (execute-kbd-macro (kbd "<f2> 0 RET"))
    (should (equal (grid-get-raw-value-at source 1 1) "420"))))

(ert-deftest grid-table-etaf-empty-cell-can-be-edited ()
  (grid-table-etaf-test--with-grid (6 5)
    (switch-to-buffer buffer)
    (grid-set-raw-value-at source 3 2 "")
    (grid-table-refresh)
    (grid-table-etaf-goto 3 2)
    (execute-kbd-macro (kbd "RET a b c RET"))
    (should (equal (grid-get-raw-value-at source 3 2) "abc"))))

