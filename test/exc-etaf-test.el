(ert-deftest exc-etaf-dragging-a-header-edge-resizes-the-column ()
  (exc-etaf-test--with-grid (6 5)
    (let ((resize (exc-etaf--drag-resize buffer 1))
          (widths (lambda () (exc-etaf--state-widths
                              exc-etaf--state))))
      (should (= (aref (funcall widths) 1) 5))
      (funcall resize '(:phase start :delta (0 . 0)))
      ;; One pixel is one column in batch mode.
      (funcall resize '(:phase move :delta (4 . 0)))
      (should (= (aref (funcall widths) 1) 9))
      (funcall resize '(:phase end :delta (7 . 0)))
      (should (= (aref (funcall widths) 1) 12))
      ;; A dragged width survives edits and refreshes.
      (exc-etaf-set-cell 2 1 "a much longer value than before")
      (exc-refresh)
      (should (= (aref (funcall widths) 1) 12))
      ;; A cancelled drag puts the width back.
      (funcall resize '(:phase start :delta (0 . 0)))
      (funcall resize '(:phase move :delta (-6 . 0)))
      (should (= (aref (funcall widths) 1) 6))
      (funcall resize '(:phase cancel :delta (-6 . 0)))
      (should (= (aref (funcall widths) 1) 12))
      ;; Structural changes drop dragged widths with the columns they named.
      (exc-add-column 1)
      (should (= (aref (funcall widths) 1) 5)))))

(defun exc-etaf-test--cursor-face ()
  "Return the painted face of the cursor cell's text as a string."
  (format "%S" (get-text-property
                (etaf-host-ref-position
                 (etaf-runtime-for-buffer (current-buffer))
                 'exc-etaf-cursor)
                'face)))

(ert-deftest exc-etaf-formats-apply-to-the-selection-and-undo ()
  (exc-etaf-test--with-grid (6 5)
    (exc-etaf-goto 1 1)
    (exc-etaf-extend-down)
    (exc-etaf-toggle-bold)
    (should (plist-get (exc-get-style-at source 1 1) :bold))
    (should (plist-get (exc-get-style-at source 2 1) :bold))
    (should-not (exc-get-style-at source 3 1))
    (exc-etaf-goto 1 1)
    (should (string-match-p "bold" (exc-etaf-test--cursor-face)))
    (exc-etaf-goto 3 1)
    (should-not (string-match-p "bold" (exc-etaf-test--cursor-face)))
    ;; Toggling follows the cursor cell: bold there means turn it off.
    (exc-etaf-goto 1 1)
    (exc-etaf-toggle-bold)
    (should-not (exc-get-style-at source 1 1))
    (should (plist-get (exc-get-style-at source 2 1) :bold))
    (exc-etaf-undo)
