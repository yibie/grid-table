      (should (string-match-p "2026-10-13" (exc-etaf-test--body)))
      (should-not (string-match-p "46308" (exc-etaf-test--text)))
      ;; Editing starts from the date, not from the number behind it.
      (execute-kbd-macro (kbd "<f2>"))
      (should (string-match-p "2026-10-13" (exc-etaf-test--body)))
      (execute-kbd-macro (kbd "C-c C-k"))
      ;; The value and its format are undone together.
      (let ((steps (length (exc-etaf--state-undo state))))
        (exc-etaf-undo)
        (should (= (length (exc-etaf--state-undo state)) (1- steps))))
      (should (equal (exc-get-raw-value-at source 2 1) "4"))
      (should-not (exc-get-style-at source 2 1))
      ;; Number formats apply to the selection.
      (exc-etaf-goto 3 1)
      (exc-etaf-set-cell 3 1 "0.256")
      (exc-etaf-format-percent)
      (should (string-match-p "26%" (exc-etaf-test--body)))
      (exc-etaf-more-decimals)
      (should (string-match-p "25\\.6%" (exc-etaf-test--body)))
      (exc-etaf-format-number 2)
      (should (string-match-p "0\\.26" (exc-etaf-test--body)))
      (exc-etaf-format-general)
      (should (equal (exc-get-display-value-at source 3 1) "0.256"))
      ;; Asked for by name, the general format shows a date's number.
      (exc-etaf-set-cell 3 2 "=DATE(2026,10,12)")
      (should (equal (exc-get-display-value-at source 3 2) "2026-10-12"))
      (exc-etaf-goto 3 2)
      (exc-etaf-format-general)
      (should (equal (exc-get-display-value-at source 3 2) "46307"))
      ;; A comparison that fails reads FALSE, an empty cell stays empty.
      (exc-etaf-set-cell 3 2 "=1=2")
      (should (equal (exc-get-display-value-at source 3 2) "FALSE"))
      (should (string-match-p "FALSE" (exc-etaf-test--body)))
      ;; The text format leaves the number there a number; what is typed
      ;; after it is text.
      (exc-etaf-set-cell 4 1 "007")
      (exc-etaf-set-cell 4 2 "=COUNT(B5:B5)")
      (should (equal (exc-get-computed-value-at source 4 2) 1))
      (exc-etaf-goto 4 1)
      (exc-etaf-format-text)
      (should (equal (exc-get-computed-value-at source 4 2) 1))
      (exc-etaf--enter-cells (exc-etaf--state-or-error)
                                    '((4 1 "007")))
      (should (equal (exc-get-display-value-at source 4 1) "007"))
      (should (equal (exc-get-computed-value-at source 4 2) 0)))))

(ert-deftest exc-etaf-paste-grows-the-grid ()
  (exc-etaf-test--with-grid (4 3)
    (let (kill-ring kill-ring-yank-pointer interprogram-cut-function
                    interprogram-paste-function)
      (kill-new "a\tb\tc\nd\te\tf\ng\th\ti")
      (exc-etaf-goto 2 1)
