(ert-deftest exc-etaf-undo-keys-reach-the-sheet-outside-an-edit ()
  "A key bound to `undo' undoes the sheet, and no other buffer is affected."
  (exc-etaf-test--with-grid (6 5)
    (switch-to-buffer buffer)
    (should (eq (command-remapping 'undo) #'exc-etaf-undo))
    (should (eq (command-remapping 'undo-only) #'exc-etaf-undo))
    (should (eq (command-remapping 'undo-redo) #'exc-etaf-redo))
    (exc-etaf-goto 2 1)
    (let ((before (exc-get-raw-value-at source 2 1)))
      (exc-etaf-set-cell 2 1 "elsewhere")
      (should (equal (exc-get-raw-value-at source 2 1) "elsewhere"))
      (local-set-key (kbd "C-c z") #'undo)
      (execute-kbd-macro (kbd "C-c z"))
      (should (equal (exc-get-raw-value-at source 2 1) before))
      (local-set-key (kbd "C-c Z") #'undo-redo)
      (execute-kbd-macro (kbd "C-c Z"))
      (should (equal (exc-get-raw-value-at source 2 1) "elsewhere")))
    ;; A buffer that is not a grid keeps its own undo.
    (with-temp-buffer
      (should-not (command-remapping 'undo))
      (should-not (command-remapping 'undo-redo)))))

(ert-deftest exc-etaf-undo-restores-structural-changes ()
  (exc-etaf-test--with-grid (6 5)
