    ;; A formula elsewhere reading a range that takes in B3.
    (exc-etaf-set-cell 6 4 "=SUM(B:B)")
    (should-not exc-etaf--traces)
    (exc-sheet-new "Totals")
    (exc-etaf-set-cell 1 0 "=Sheet1!B3*2")
    (exc-sheet-select "Sheet1")
    (exc-etaf-goto 2 1)
    (should (string-match-p "3 dependents (1 on other sheets)"
                            (exc-etaf-trace-dependents)))
    (should (eq (exc-etaf--traced source 2 3) 'dependent))
    (should (eq (exc-etaf--traced source 6 4) 'dependent))
    (should-not (exc-etaf--traced source 3 3))
    ;; Visiting them goes to the other sheet in turn.
    (exc-etaf-next-trace)
    (should (equal (exc-etaf--cursor) '(2 . 3)))
    (exc-etaf-next-trace)
    (should (equal (exc-etaf--cursor) '(6 . 4)))
    (exc-etaf-next-trace)
    (should (equal (exc-workbook-sheet-name exc--data-source) "Totals"))
    (should (equal (exc-etaf--cursor) '(1 . 0)))
    (exc-etaf-clear-traces)
    (should-not exc-etaf--traces)
    (should-error (exc-etaf-next-trace) :type 'user-error)
    (exc-etaf-goto 0 0)
    (should-error (exc-etaf-trace-precedents) :type 'user-error)
    ;; Undoing an edit drops the traces it would make stale.
    (exc-sheet-select "Sheet1")
    (exc-etaf-goto 2 1)
    (exc-etaf-trace-dependents)
    (should exc-etaf--traces)
    (exc-etaf-undo)
    (should-not exc-etaf--traces)))

(ert-deftest exc-etaf-paste-special ()
  (exc-etaf-test--with-grid (14 5 100 12)
    ;; D2 is =B2+C2, which shows 5; make it bold.
    (exc-etaf-goto 1 3)
    (exc-etaf-toggle-bold)
    (exc-etaf-copy)
    ;; Values: the number shown, the target's format left alone.
    (exc-etaf-goto 9 0)
    (exc-etaf-paste-values)
    (should (equal (exc-get-raw-value-at source 9 0) "5"))
    (should-not (plist-get (exc-get-style-at source 9 0) :bold))
    ;; Formats: the value stays, the format arrives.
    (exc-etaf-goto 9 1)
    (exc-etaf-paste-formats)
    (should (equal (exc-get-raw-value-at source 9 1) "18"))
    (should (plist-get (exc-get-style-at source 9 1) :bold))
    ;; Text kept as text survives a paste of values.
    (exc-etaf-set-cell 2 4 "'007")
    (exc-etaf-goto 2 4)
    (exc-etaf-copy)
    (exc-etaf-goto 9 4)
    (exc-etaf-paste-values)
    (should (equal (exc-get-raw-value-at source 9 4) "'007"))
    ;; Transposed: B2:C3 lands as rows of two, B3's =B2 moving with it.
    (exc-etaf-set-cell 2 1 "=B2")
    (exc-etaf-goto 1 1)
    (exc-etaf-goto 2 2 t)
    (exc-etaf-copy)
    (exc-etaf-goto 10 1)
    (exc-etaf-paste-transposed)
    (should (equal (exc-get-raw-value-at source 10 1) "2"))
    (should (equal (exc-get-raw-value-at source 10 2) "=C10"))
    (should (equal (exc-get-raw-value-at source 11 1) "3"))
    (should (equal (exc-get-raw-value-at source 11 2) "6"))
    ;; One undo step each.
    (exc-etaf-undo)
    (should (equal (exc-get-raw-value-at source 10 2) "30"))))

(ert-deftest exc-etaf-sort-by-several-columns ()
  (exc-etaf-test--with-grid (6 3 100 12)
    (exc-etaf-set-cell 1 0 "b")
    (exc-etaf-set-cell 2 0 "a")
    (exc-etaf-set-cell 3 0 "b")
    (exc-etaf-set-cell 4 0 "a")
    (exc-etaf-set-cell 5 0 "a")
    (exc-etaf-goto 1 0)
    (let ((answers '("ascending" "descending")))
      (cl-letf (((symbol-function 'completing-read)
                 (lambda (&rest _) (pop answers)))
                ((symbol-function 'read-string)
                 (let ((columns '("B" "")))
