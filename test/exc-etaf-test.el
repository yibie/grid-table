(ert-deftest exc-etaf-typing-replaces-the-cell-and-return-moves-down ()
  (exc-etaf-test--with-grid (6 5)
    ;; Typing starts an edit here, as in Excel.
    (switch-to-buffer buffer)
    (exc-etaf-goto 1 1)
    (execute-kbd-macro (kbd "4 2 RET"))
    (should (equal (exc-get-raw-value-at source 1 1) "42"))
    (should (equal (exc-etaf--cursor) '(2 . 1)))
    (should-not (exc-etaf--state-session exc-etaf--state))
    ;; Letters, the old command keys included, and SPC and ? are text.
    (execute-kbd-macro (kbd "q SPC n ? RET"))
    (should (equal (exc-get-raw-value-at source 2 1) "q n?"))
    (should (buffer-live-p buffer))
    (execute-kbd-macro (kbd "= B 2 * 2 TAB"))
    (should (equal (exc-get-computed-value-at source 3 1) 84))
    (should (equal (exc-etaf--cursor) '(3 . 2)))
    ;; Non-ASCII text reaches the cell through the same path.
    (execute-kbd-macro (vconcat "中文" (kbd "RET")))
    (should (equal (exc-get-raw-value-at source 3 2) "中文"))
    ;; F2 keeps the existing text.
    (exc-etaf-goto 1 1)
    (execute-kbd-macro (kbd "<f2> 0 RET"))
    (should (equal (exc-get-raw-value-at source 1 1) "420"))
    ;; With the option off a typed key changes nothing; RET starts the edit.
    (setq-local exc-etaf-type-to-edit nil)
    (exc-etaf-goto 1 1)
    (execute-kbd-macro (kbd "7"))
    (should (equal (exc-get-raw-value-at source 1 1) "420"))
    (should-not (exc-etaf--state-session exc-etaf--state))
    (execute-kbd-macro (kbd "RET 7 RET"))
    (should (equal (exc-get-raw-value-at source 1 1) "4207"))))

