    (exc-etaf-goto 3 2)
    (exc-etaf-select-column 1)
    (should (equal (exc-etaf-selection) '(0 1 199 1)))
    ;; Selecting a whole column does not scroll the window to its end.
    (should (string-match-p "^ *1 " (exc-etaf-test--text)))
    (should (string-match-p "B1:B200" (exc-etaf-test--text)))
    (exc-etaf-select-row 4)
    (should (equal (exc-etaf-selection) '(4 0 4 4)))
