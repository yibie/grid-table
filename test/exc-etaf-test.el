;;; exc-etaf-test.el --- ETAF renderer tests -*- lexical-binding: t; -*-

;;; Commentary:

;; These tests need the ecss, ebox and etaf repository roots on `load-path';
;; run them with `make test-etaf ETAF_SRC=/path/to/checkouts'.  They are
;; skipped when ETAF cannot be loaded.

;;; Code:

(require 'ert)
(setq load-prefer-newer t)
(require 'exc)
(defvar exc-etaf-mount-options)

(defconst exc-etaf-test--available
  (require 'exc-etaf nil t))

(defun exc-etaf-test--rows (rows cols)
  "Return ROWS by COLS raw values; column D holds =B+C formulas."
  (cl-loop for row below rows collect
           (cl-loop for col below cols collect
                    (cond ((= row 0) (format "H%d" col))
                          ((= col 3) (format "=B%d+C%d" (1+ row) (1+ row)))
                          (t (number-to-string (* row (1+ col))))))))

(defmacro exc-etaf-test--with-grid (spec &rest body)
  "Show a grid described by SPEC through ETAF and run BODY in its buffer.
SPEC is (ROWS COLS &optional VIEWPORT-COLUMNS VIEWPORT-LINES)."
  (declare (indent 1))
  `(progn
     (skip-unless exc-etaf-test--available)
     (let* ((exc-etaf-mount-options
             (list :viewport-width ,(or (nth 2 spec) 100)
                   :viewport-height ,(or (nth 3 spec) 12)))
            (source (make-exc-default-data-source
                     (make-list ,(nth 1 spec) "")
                     (exc-etaf-test--rows ,(nth 0 spec) ,(nth 1 spec))))
            (buffer (generate-new-buffer " *exc-etaf-test*")))
       (unwind-protect
           (with-current-buffer buffer
             (exc--show-grid-in-current-buffer source)
             ,@body)
         (kill-buffer buffer)))))

(defun exc-etaf-test--text ()
  "Return the painted text of the current buffer without properties."
  (buffer-substring-no-properties (point-min) (point-max)))

(defun exc-etaf-test--body ()
  "Return the painted text below the formula bar."
  (let ((text (exc-etaf-test--text)))
    (substring text (1+ (string-search "\n" text)))))

(defun exc-etaf-test--type (text)
  "Type TEXT into the grid one character at a time, as a person would."
  (dolist (char (string-to-list text))
    (execute-kbd-macro (vector char))))

(defun exc-etaf-test--session ()
  "Return the grid's in-place edit session, or nil."
  (exc-etaf--state-session exc-etaf--state))

(defun exc-etaf-test--cursor-painted-p ()
  "Return non-nil when the cursor cell is in the buffer."
  (etaf-host-ref-position (etaf-runtime-for-buffer (current-buffer))
                          'exc-etaf-cursor))

(ert-deftest exc-etaf-show-mounts-the-grid ()
  (exc-etaf-test--with-grid (6 5)
    (should (eq major-mode 'exc-etaf-mode))
    (should (etaf-runtime-for-buffer (current-buffer)))
    (should-not (buffer-modified-p))
    (should (equal (plist-get (exc-get-cell-at-point) :slice-row) 0))
    (should (equal (plist-get (exc-get-cell-at-point) :slice-col) 1))
    (should (string-match-p "H0" (exc-etaf-test--text)))))

(ert-deftest exc-etaf-mode-derives-from-the-grid-mode ()
  (exc-etaf-test--with-grid (3 2)
    (should (eq major-mode 'exc-etaf-mode))
    (should (derived-mode-p 'exc-mode))))

(ert-deftest exc-etaf-navigation-commands-move-the-cursor ()
  (exc-etaf-test--with-grid (6 5)
    (exc-next-line)
    (exc-cell-right)
    (should (equal (exc-etaf--cursor) '(1 . 1)))
    (exc-previous-line)
    (exc-cell-left)
    (should (equal (exc-etaf--cursor) '(0 . 0)))
    (exc-cell-left)
    (exc-previous-line)
    (should (equal (exc-etaf--cursor) '(0 . 0)))
    (exc-move-end-of-line)
    (should (equal (exc-etaf--cursor) '(0 . 4)))
    (exc-next-cell)
    (should (equal (exc-etaf--cursor) '(1 . 0)))
    (exc-previous-cell)
    (should (equal (exc-etaf--cursor) '(0 . 4)))
    (exc-etaf-last-cell)
    (should (equal (exc-etaf--cursor) '(5 . 4)))))

(ert-deftest exc-etaf-only-the-window-is-mounted ()
  (exc-etaf-test--with-grid (500 30 100 12)
    (should (<= (count-lines (point-min) (point-max)) 12))
    (exc-etaf-goto 400 0)
    (should (exc-etaf-test--cursor-painted-p))
    (should (<= (count-lines (point-min) (point-max)) 12))
    (should (string-match-p "401" (exc-etaf-test--text)))
    (should-not (string-match-p "\\_<2\\_>.*H0" (exc-etaf-test--text)))
    (exc-etaf-goto 400 27)
    (should (exc-etaf-test--cursor-painted-p))
    (should (string-match-p "AB" (exc-etaf-test--text)))
    (exc-etaf-first-cell)
    (should (exc-etaf-test--cursor-painted-p))
    (should (string-match-p "H0" (exc-etaf-test--text)))))

(ert-deftest exc-etaf-wheel-scrolls-without-moving-the-cursor ()
  (exc-etaf-test--with-grid (200 4 100 12)
    (exc-etaf-scroll-down)
    (exc-etaf-scroll-down)
    (should (equal (exc-etaf--cursor) '(0 . 0)))
    (should-not (exc-etaf-test--cursor-painted-p))
    (should (string-match-p "^ *7 " (exc-etaf-test--text)))
    (exc-next-line)
    (should (equal (exc-etaf--cursor) '(1 . 0)))
    (should (exc-etaf-test--cursor-painted-p))
    (exc-etaf-scroll-up)
    (should (exc-etaf-test--cursor-painted-p))))

(ert-deftest exc-etaf-a-failed-mount-is-an-error ()
  (skip-unless exc-etaf-test--available)
  (let ((source (make-exc-default-data-source
                 '("" "") (exc-etaf-test--rows 3 2))))
    (cl-letf (((symbol-function 'etaf-mount)
               (lambda (&rest _) (error "Stale ETAF"))))
      (with-temp-buffer
        (should-error (exc--show-grid-in-current-buffer source))))))

(ert-deftest exc-etaf-paging-follows-the-window-height ()
  (exc-etaf-test--with-grid (200 4 100 12)
    (exc-etaf-page-down)
    (should (equal (exc-etaf--cursor) '(9 . 0)))
    (exc-etaf-page-up)
    (should (equal (exc-etaf--cursor) '(0 . 0)))))

(ert-deftest exc-etaf-movement-steps-over-merged-cells ()
  (exc-etaf-test--with-grid (8 6)
    (exc-set-raw-value-at source 2 2 "")
    (exc-set-raw-value-at source 2 3 "")
    (exc-source-merge-cells source 2 1 2 3)
    (exc-refresh)
    (exc-etaf-goto 2 2)
    (let ((cell (exc-get-cell-at-point)))
      (should (equal (plist-get cell :anchor-col) 2))
      (should (equal (plist-get cell :col-start) 2))
      (should (equal (plist-get cell :col-end) 4))
      (should (equal (plist-get cell :slice-col) 3)))
    (exc-cell-right)
    (should (equal (exc-etaf--cursor) '(2 . 4)))
    (exc-cell-left)
    (exc-cell-left)
    (should (equal (exc-etaf--cursor) '(2 . 0)))
    (should (exc-etaf-test--cursor-painted-p))))

(ert-deftest exc-etaf-shared-commands-act-on-the-cursor ()
  (exc-etaf-test--with-grid (6 5)
    (exc-etaf-goto 2 1)
    (exc-add-row 2)
    (should (= (exc-get-row-count exc--data-source) 7))
    (exc-delete-row 3)
    (should (= (exc-get-row-count exc--data-source) 6))
    (exc-etaf-goto 4 4)
    (exc-edit-cell-with-value "")
    (exc-etaf-goto 4 3)
    (exc-edit-cell-with-value "wide")
    (exc-merge-cells "D5:E5")
    (should (equal (exc-get-merges exc--data-source) '((4 3 4 4))))
    (should (equal (exc-etaf--cursor) '(4 . 3)))
    (exc-unmerge-cell)
    (should-not (exc-get-merges exc--data-source))))

(ert-deftest exc-etaf-selection-extends-and-clears ()
  (exc-etaf-test--with-grid (6 5)
    (exc-etaf-goto 1 1)
    (exc-etaf-extend-down)
    (exc-etaf-extend-right)
    (should (equal (exc-etaf-selection) '(1 1 2 2)))
    (exc-etaf-clear-cells)
    (should (equal (exc-get-raw-value-at source 1 1) ""))
    (should (equal (exc-get-raw-value-at source 2 2) ""))
    (should (equal (exc-get-raw-value-at source 3 1) "6"))
    (exc-next-line)
    (should (equal (exc-etaf-selection) '(3 2 3 2)))))

(ert-deftest exc-etaf-formula-bar-shows-the-raw-value ()
  (exc-etaf-test--with-grid (6 5)
    (exc-etaf-goto 2 3)
    (let ((bar (car (split-string (exc-etaf-test--text) "\n"))))
      (should (string-match-p "D3" bar))
      (should (string-match-p "=B3\\+C3" bar)))
    ;; The grid itself shows the computed value.
    (should (string-match-p "\\_<10\\_>" (exc-etaf-test--text)))
    (exc-etaf-extend-down)
    (should (string-match-p
             "D3:D4" (car (split-string (exc-etaf-test--text) "\n"))))))

(ert-deftest exc-etaf-status-bar-summarizes-the-selection ()
  (exc-etaf-test--with-grid (6 5)
    ;; The header row is not counted, as in the filtered count.
    (should (string-match-p "5 rows × 5 columns" (exc-etaf-test--text)))
    (exc-etaf-goto 0 1)
    (exc-etaf-extend-down)
    (exc-etaf-extend-down)
    ;; B1 is the text \"H1\"; B2 and B3 hold 2 and 4.
    (should (string-match-p "Count: 3   Sum: 6   Average: 3 *\\'"
                            (exc-etaf-test--text)))
    (exc-etaf-goto 0 0)
    (exc-etaf-extend-right)
    (should (string-match-p "Count: 2 *\\'" (exc-etaf-test--text)))))

(ert-deftest exc-etaf-notes-and-links ()
  (exc-etaf-test--with-grid (6 5)
    (let (kill-ring kill-ring-yank-pointer interprogram-cut-function
                    interprogram-paste-function)
      (exc-etaf-goto 2 1)
      (exc-etaf-edit-note "Checked by\nthe auditor")
      (should (equal (exc-get-style-at source 2 1)
                     '(:note "Checked by\nthe auditor")))
      (should (string-match-p "Note: Checked by / the auditor"
                              (exc-etaf-test--text)))
      (exc-etaf-set-link "#D5")
      (should (string-match-p "Link: #D5" (exc-etaf-test--text)))
      ;; Clearing formats keeps notes and links.
      (exc-etaf-toggle-bold)
      (exc-etaf-clear-format)
      (should (equal (exc-get-style-at source 2 1)
                     '(:note "Checked by\nthe auditor" :link "#D5")))
      ;; An internal link goes to its cell.
      (exc-etaf-open-link)
      (should (equal (exc-etaf--cursor) '(4 . 3)))
      ;; Pasting formats only leaves the target's note; a plain paste
      ;; brings the copied one.
      (exc-etaf-edit-note "own")
      (exc-etaf-goto 1 0)
      (exc-etaf-toggle-bold)
      (exc-etaf-copy)
      (exc-etaf-goto 4 3)
      (exc-etaf-paste-formats)
      (should (equal (exc-get-style-at source 4 3) '(:bold t :note "own")))
      (exc-etaf-goto 2 1)
      (exc-etaf-copy)
      (exc-etaf-goto 3 4)
      (exc-etaf-paste)
      (should (equal (plist-get (exc-get-style-at source 3 4) :note)
                     "Checked by\nthe auditor"))
      ;; An empty note removes it, and that is undoable.
      (exc-etaf-goto 2 1)
      (exc-etaf-edit-note "")
      (should-not (plist-get (exc-get-style-at source 2 1) :note))
      (exc-etaf-undo)
      (should (plist-get (exc-get-style-at source 2 1) :note))
      ;; Notes and links travel with their row and are saved.
      (exc-etaf-goto 1 0)
      (exc-add-row 0)
      (should (equal (plist-get (exc-get-style-at exc--data-source 3 1)
                                :link)
                     "#D5"))
      (let ((file (make-temp-file "exc-notes" nil ".grid")))
        (unwind-protect
            (progn
              (exc-persistence--save-to-file exc--data-source file)
              (let ((loaded (exc-persistence-create-data-source-from-file
                             file)))
                (should (equal (exc-get-style-at loaded 3 1)
                               '(:note "Checked by\nthe auditor"
                                       :link "#D5")))))
          (delete-file file))))))

(ert-deftest exc-etaf-sheets ()
  (exc-etaf-test--with-grid (6 5)
    (let ((first source)
          (state exc-etaf--state))
      (should-not (exc-sheets))
      (exc-etaf-goto 3 2)
      (exc-sheet-new "Totals")
      (let ((second exc--data-source))
        (should-not (eq second first))
        (should (equal (mapcar #'exc-workbook-sheet-name (exc-sheets))
                       '("Sheet1" "Totals")))
        (should (eq major-mode 'exc-etaf-mode))
        (should (buffer-modified-p))
        (should-not (eq exc-etaf--state state))
        (should (equal (exc-etaf--cursor) '(0 . 0)))
        ;; A formula reads the first sheet, and follows what changes there.
        (exc-etaf-set-cell 1 0 "=SUM(Sheet1!B2:B4)")
        (should (equal (exc-get-computed-value-at second 1 0) 12))
        (exc-sheet-previous)
        (should (eq exc--data-source first))
        ;; The sheet comes back as it was left.
        (should (eq exc-etaf--state state))
        (should (equal (exc-etaf--cursor) '(3 . 2)))
        (exc-etaf-set-cell 1 1 "100")
        (should (equal (exc-get-computed-value-at second 1 0) 110))
        ;; A row added here moves the range the other sheet reads; undoing
        ;; it moves the range back.
        (funcall (gethash :add-row first) first 1)
        (exc-refresh)
        (should (equal (exc-get-raw-value-at second 1 0)
                       "=SUM(Sheet1!B2:B5)"))
        (exc-etaf-undo)
        (should (equal (exc-get-raw-value-at second 1 0)
                       "=SUM(Sheet1!B2:B4)"))
        (should (equal (exc-get-computed-value-at second 1 0) 110))
        ;; Renaming rewrites the formulas that name the sheet.
        (exc-sheet-rename "My Data")
        (should (equal (exc-get-raw-value-at second 1 0)
                       "=SUM('My Data'!B2:B4)"))
        (should (equal (exc-get-computed-value-at second 1 0) 110))
        (should-error (exc-sheet-rename "totals"))
        (should-error (exc-sheet-new "a/b"))
        (exc-sheet-move-right)
        (should (equal (mapcar #'exc-workbook-sheet-name (exc-sheets))
                       '("Totals" "My Data")))
        (exc-sheet-next)
        (should (eq exc--data-source second))
        (exc-sheet-select "my data")
        (should (eq exc--data-source first))
        ;; Deleting a sheet leaves the formulas that read it without a value.
        (exc-sheet-delete)
        (should (eq exc--data-source second))
        (should (equal (exc-get-computed-value-at second 1 0) "#REF!"))
        (should-error (exc-sheet-delete))))))

(ert-deftest exc-etaf-copy-and-paste-carry-formats ()
  (exc-etaf-test--with-grid (6 5)
    (let (kill-ring kill-ring-yank-pointer interprogram-cut-function
                    interprogram-paste-function
                    (state exc-etaf--state))
      (exc-set-style-at source 1 1 '(:bold t :background "#FFFF00"))
      (exc-set-style-at source 4 2 '(:italic t))
      ;; B2:C2 goes to B5:C5: B5 takes B2's format, C5 loses its own.
      (exc-etaf-goto 1 1)
      (exc-etaf-extend-right)
      (exc-etaf-copy)
      (exc-etaf-goto 4 1)
      (exc-etaf-paste)
      (should (equal (exc-get-raw-value-at source 4 1) "2"))
      (should (equal (exc-get-style-at source 4 1)
                     '(:bold t :background "#FFFF00")))
      (should-not (exc-get-style-at source 4 2))
      ;; Values and formats come back in one step.
      (let ((steps (length (exc-etaf--state-undo state))))
        (exc-etaf-undo)
        (should (= (length (exc-etaf--state-undo state)) (1- steps))))
      (should (equal (exc-get-raw-value-at source 4 1) "8"))
      (should-not (exc-get-style-at source 4 1))
      (should (equal (exc-get-style-at source 4 2) '(:italic t)))
      (exc-etaf-redo)
      (should (equal (exc-get-style-at source 4 1)
                     '(:bold t :background "#FFFF00")))
      (should-not (exc-get-style-at source 4 2))
      ;; One copied cell gives its format to the whole selection.
      (exc-etaf-goto 1 1)
      (exc-etaf-copy)
      (exc-etaf-goto 2 0)
      (exc-etaf-extend-down)
      (exc-etaf-paste)
      (should (equal (exc-get-style-at source 2 0)
                     '(:bold t :background "#FFFF00")))
      (should (equal (exc-get-style-at source 3 0)
                     '(:bold t :background "#FFFF00")))
      ;; Text from elsewhere leaves formats alone.
      (kill-new "plain")
      (exc-etaf-goto 2 0)
      (exc-etaf-paste)
      (should (equal (exc-get-raw-value-at source 2 0) "plain"))
      (should (equal (exc-get-style-at source 2 0)
                     '(:bold t :background "#FFFF00")))
      ;; Cutting takes the format away with the value, in one step.
      (exc-etaf-goto 1 1)
      (exc-etaf-cut)
      (should (equal (exc-get-raw-value-at source 1 1) ""))
      (should-not (exc-get-style-at source 1 1))
      (exc-etaf-goto 5 4)
      (exc-etaf-paste)
      (should (equal (exc-get-raw-value-at source 5 4) "2"))
      (should (equal (exc-get-style-at source 5 4)
                     '(:bold t :background "#FFFF00")))
      (exc-etaf-undo)
      (exc-etaf-undo)
      (should (equal (exc-get-raw-value-at source 1 1) "2"))
      (should (equal (exc-get-style-at source 1 1)
                     '(:bold t :background "#FFFF00"))))))

(ert-deftest exc-etaf-copy-and-paste-keep-formulas ()
  (exc-etaf-test--with-grid (6 5)
    (let (kill-ring kill-ring-yank-pointer interprogram-cut-function
                    interprogram-paste-function)
      ;; C2:D3 holds 3, =B2+C2, 6, =B3+C3.
      (exc-etaf-goto 1 2)
      (exc-etaf-extend-down)
      (exc-etaf-extend-right)
      (exc-etaf-copy)
      (should (equal (current-kill 0) "3\t5\n6\t10"))
      (exc-etaf-goto 4 0)
      (exc-etaf-paste)
      (should (equal (exc-get-raw-value-at source 4 0) "3"))
      ;; Pasted three rows down and two columns left of where it was.
      (should (equal (exc-get-raw-value-at source 4 1) "=#REF!+A5"))
      (should (equal (exc-get-raw-value-at source 5 1) "=#REF!+A6"))
      (should (equal (exc-etaf-selection) '(4 0 5 1)))
      (exc-etaf-goto 4 3)
      (exc-etaf-paste)
      (should (equal (exc-get-raw-value-at source 4 4) "=C5+D5"))
      (should (equal (exc-get-raw-value-at source 5 4) "=C6+D6"))
      ;; Text from elsewhere is split on tabs and newlines and clipped.
      (kill-new "x\ty\tz\n\"multi\nline\"\tw\n")
      (exc-etaf-goto 4 3)
      (exc-etaf-paste)
      (should (equal (exc-get-raw-value-at source 4 3) "x"))
      (should (equal (exc-get-raw-value-at source 4 4) "y"))
      (should (equal (exc-get-raw-value-at source 5 3) "multi\nline"))
      (should (equal (exc-get-raw-value-at source 5 4) "w"))
      ;; One copied cell fills the selection.
      (exc-etaf-goto 0 0)
      (exc-etaf-copy)
      (exc-etaf-goto 1 0)
      (exc-etaf-extend-down)
      (exc-etaf-paste)
      (should (equal (exc-get-raw-value-at source 1 0) "H0"))
      (should (equal (exc-get-raw-value-at source 2 0) "H0"))
      ;; Cutting empties the source range.
      (exc-etaf-goto 3 2)
      (exc-etaf-cut)
      (should (equal (exc-get-raw-value-at source 3 2) ""))
      (should (equal (current-kill 0) "9"))
      ;; One copied formula fills a range, adjusted for each cell; a cut
      ;; formula moves unchanged.
      (exc-etaf-set-cell 1 3 "=B2+C2")
      (exc-etaf-goto 1 3)
      (exc-etaf-copy)
      (exc-etaf-goto 2 3)
      (exc-etaf-extend-down)
      (exc-etaf-paste)
      (should (equal (exc-get-raw-value-at source 2 3) "=B3+C3"))
      (should (equal (exc-get-raw-value-at source 3 3) "=B4+C4"))
      (exc-etaf-goto 1 3)
      (exc-etaf-cut)
      (exc-etaf-goto 5 0)
      (exc-etaf-paste)
      (should (equal (exc-get-raw-value-at source 5 0) "=B2+C2")))))

(ert-deftest exc-etaf-undo-and-redo-restore-cells ()
  (exc-etaf-test--with-grid (6 5)
    ;; Typing starts an edit here, as in Excel.
    (switch-to-buffer buffer)
    (exc-etaf-goto 2 1)
    (execute-kbd-macro (kbd "9 9 RET"))
    (should (equal (exc-get-computed-value-at source 2 3) 105))
    (exc-etaf-goto 1 0)
    (exc-etaf-extend-down)
    (exc-etaf-extend-right)
    (exc-etaf-clear-cells)
    (should (equal (exc-get-raw-value-at source 2 1) ""))
    ;; The whole cleared range comes back as one step.
    (execute-kbd-macro (kbd "C-/"))
    (should (equal (exc-get-raw-value-at source 1 0) "1"))
    (should (equal (exc-get-raw-value-at source 2 1) "99"))
    (execute-kbd-macro (kbd "C-/"))
    (should (equal (exc-get-raw-value-at source 2 1) "4"))
    (should (equal (exc-get-computed-value-at source 2 3) 10))
    (should (equal (exc-etaf--cursor) '(2 . 1)))
    (should-error (exc-etaf-undo) :type 'user-error)
    (execute-kbd-macro (kbd "C-?"))
    (should (equal (exc-get-raw-value-at source 2 1) "99"))
    (exc-etaf-redo)
    (should (equal (exc-get-raw-value-at source 2 1) ""))
    ;; A new change drops what could be redone.
    (exc-etaf-undo)
    (exc-etaf-set-cell 0 0 "new")
    (should-error (exc-etaf-redo) :type 'user-error)))

(ert-deftest exc-etaf-typing-then-an-arrow-stores-and-moves ()
  "An edit begun by typing stores the text and moves on an arrow key."
  (exc-etaf-test--with-grid (6 5)
    (switch-to-buffer buffer)
    (exc-etaf-goto 2 1)
    (exc-etaf-test--type "abc")
    (should (exc-etaf-test--session))
    (execute-kbd-macro (kbd "<down>"))
    (should-not (exc-etaf-test--session))
    (should (equal (exc-etaf--cursor) '(3 . 1)))
    (should (equal (exc-get-raw-value-at source 2 1) "abc"))
    ;; An arrow stores the text and moves the way it points.
    (execute-kbd-macro (kbd "<right>"))
    (exc-etaf-goto 2 2)
    (exc-etaf-test--type "xy")
    (execute-kbd-macro (kbd "<right>"))
    (should-not (exc-etaf-test--session))
    (should (equal (exc-etaf--cursor) '(2 . 3)))
    (should (equal (exc-get-raw-value-at source 2 2) "xy"))
    (exc-etaf-goto 3 2)
    (exc-etaf-test--type "z")
    (execute-kbd-macro (kbd "<up>"))
    (should (equal (exc-etaf--cursor) '(2 . 2)))
    (should (equal (exc-get-raw-value-at source 3 2) "z"))
    (exc-etaf-goto 3 2)
    (exc-etaf-test--type "w")
    (execute-kbd-macro (kbd "<left>"))
    (should (equal (exc-etaf--cursor) '(3 . 1)))
    (should (equal (exc-get-raw-value-at source 3 2) "w"))
    ;; The stored text is one step of the sheet's undo.
    (exc-etaf-undo)
    (should (equal (exc-get-raw-value-at source 3 2) "z"))))

(ert-deftest exc-etaf-edit-begun-with-f2-keeps-the-arrows-in-the-text ()
  "An edit begun with F2 or RET moves within the text on an arrow key."
  (exc-etaf-test--with-grid (6 5)
    (switch-to-buffer buffer)
    (exc-etaf-goto 2 1)
    (let ((before (exc-get-raw-value-at source 2 1)))
      (execute-kbd-macro (kbd "<f2>"))
      (execute-kbd-macro (kbd "<left>"))
      (execute-kbd-macro (kbd "<right>"))
      (execute-kbd-macro (kbd "<down>"))
      (should (exc-etaf-test--session))
      (should (equal (exc-get-raw-value-at source 2 1) before))
      (should (equal (exc-etaf--cursor) '(2 . 1)))
      (execute-kbd-macro (kbd "RET"))
      (should-not (exc-etaf-test--session))
      (execute-kbd-macro (kbd "<left>"))
      (should-not (exc-etaf-test--session))
      (should (equal (exc-etaf--cursor) '(3 . 0))))))

(ert-deftest exc-etaf-undo-of-typed-input-cancels-it-at-once ()
  "Typing counts as a change: one undo throws the whole input away."
  (exc-etaf-test--with-grid (6 5)
    (switch-to-buffer buffer)
    (exc-etaf-goto 2 1)
    (let ((before (exc-get-raw-value-at source 2 1))
          (steps (length (exc-etaf--state-undo exc-etaf--state)))
          (modified (buffer-modified-p)))
      (exc-etaf-test--type "abc")
      (should (exc-etaf-test--session))
      (execute-kbd-macro (kbd "s-z"))
      (should-not (exc-etaf-test--session))
      (should (equal (exc-get-raw-value-at source 2 1) before))
      (should (= (length (exc-etaf--state-undo exc-etaf--state))
                 steps))
      (should (eq (buffer-modified-p) modified))
      ;; Each of the other undo keys does the same.
      (dolist (key '("C-/" "C-_" "C-x u"))
        (exc-etaf-test--type "xy")
        (should (exc-etaf-test--session))
        (execute-kbd-macro (kbd key))
        (should-not (exc-etaf-test--session))
        (should (equal (exc-get-raw-value-at source 2 1) before))
        (should (= (length (exc-etaf--state-undo exc-etaf--state))
                   steps))))))

(ert-deftest exc-etaf-undo-in-an-f2-edit-takes-back-the-typing ()
  "An edit begun with F2 undoes its typing a change at a time, then goes."
  (exc-etaf-test--with-grid (6 5)
    (switch-to-buffer buffer)
    (exc-etaf-goto 2 1)
    (let ((before (exc-get-raw-value-at source 2 1))
          (steps (length (exc-etaf--state-undo exc-etaf--state))))
      (execute-kbd-macro (kbd "<f2>"))
      ;; Point is at the end of the cell's text, so the typing follows it.
      (exc-etaf-test--type "abc")
      (should (exc-etaf-test--session))
      (execute-kbd-macro (kbd "s-z"))
      (should (equal (etaf-input-text (exc-etaf-test--session))
                     (concat before "ab")))
      (execute-kbd-macro (kbd "s-z"))
      (should (equal (etaf-input-text (exc-etaf-test--session))
                     (concat before "a")))
      (execute-kbd-macro (kbd "s-z"))
      (should (equal (etaf-input-text (exc-etaf-test--session)) before))
      ;; Back to the text the cell held, the next one cancels the edit.
      (execute-kbd-macro (kbd "s-z"))
      (should-not (exc-etaf-test--session))
      (should (equal (exc-get-raw-value-at source 2 1) before))
      (should (= (length (exc-etaf--state-undo exc-etaf--state))
                 steps)))))

(ert-deftest exc-etaf-escape-cancels-an-edit ()
