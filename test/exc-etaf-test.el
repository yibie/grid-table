    (should (= (exc-get-row-count exc--data-source) 7))
    (exc-etaf-set-cell 3 0 "inserted")
    (exc-etaf-goto 4 4)
    (exc-etaf-set-cell 4 4 "")
    (exc-merge-cells "D5:E5")
    (should (exc-get-merges exc--data-source))
    (exc-etaf-undo)
    (should-not (exc-get-merges exc--data-source))
    (exc-etaf-undo)
    (exc-etaf-undo)
    (should (equal (exc-get-raw-value-at source 3 0) ""))
    (exc-etaf-undo)
    (should (= (exc-get-row-count exc--data-source) 6))
    (should (equal (exc-get-raw-value-at source 3 0) "3"))
    (exc-etaf-redo)
    (exc-etaf-redo)
    (should (= (exc-get-row-count exc--data-source) 7))
    (should (equal (exc-get-raw-value-at source 3 0) "inserted"))))

(ert-deftest exc-etaf-undo-forgets-old-sheet-copies-beyond-budget ()
  ;; 6x5 grows to 7, 8 and 9 rows: the newest step keeps 40 + 45 cells,
  ;; the one before would add 35 more.
  (let ((exc-etaf-undo-model-cells 100))
    (exc-etaf-test--with-grid (6 5)
      (exc-etaf-goto 1 0)
      (exc-etaf-set-cell 1 0 "kept")
      (dotimes (_ 3) (exc-add-row 1))
      (should (= (exc-get-row-count exc--data-source) 9))
      (exc-etaf-undo)
      (should (= (exc-get-row-count exc--data-source) 8))
      (should-error (exc-etaf-undo) :type 'user-error)
      (should (= (exc-get-row-count exc--data-source) 8))))
  ;; Even a single step over the budget stays undoable.
  (let ((exc-etaf-undo-model-cells 10))
    (exc-etaf-test--with-grid (6 5)
      (exc-etaf-goto 1 0)
      (exc-add-row 1)
      (exc-etaf-undo)
      (should (= (exc-get-row-count exc--data-source) 6))))
  (let ((exc-etaf-undo-model-cells nil))
    (exc-etaf-test--with-grid (6 5)
      (exc-etaf-goto 1 0)
      (dotimes (_ 3) (exc-add-row 1))
      (dotimes (_ 3) (exc-etaf-undo))
      (should (= (exc-get-row-count exc--data-source) 6)))))

(ert-deftest exc-etaf-headers-select-rows-and-columns ()
