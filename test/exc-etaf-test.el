(ert-deftest exc-etaf-column-widths-and-freezing-undo ()
  (exc-etaf-test--with-grid (20 6 100 12)
    (let ((before (aref (exc-etaf--state-widths exc-etaf--state) 1))
          (drag (exc-etaf--drag-resize (current-buffer) 1))
          (step (exc-etaf--char-width)))
      ;; One drag is one step, however many moves it takes.
      (funcall drag '(:phase start))
      (funcall drag (list :phase 'move :delta (cons (* 3 step) 0)))
      (funcall drag (list :phase 'end :delta (cons (* 5 step) 0)))
      (should (= (aref (exc-etaf--state-widths exc-etaf--state) 1)
                 (+ before 5)))
      (exc-etaf-undo)
      (should (= (aref (exc-etaf--state-widths exc-etaf--state) 1)
                 before))
      (should-not (gethash 1 (exc-etaf--manual exc-etaf--state)))
      (exc-etaf-redo)
      (should (= (aref (exc-etaf--state-widths exc-etaf--state) 1)
                 (+ before 5))))
    (exc-etaf-goto 2 1)
    (exc-etaf-freeze-panes)
    (exc-unfreeze-panes)
    (should (equal (exc-frozen source) '(0 . 0)))
    (exc-etaf-undo)
    (should (equal (exc-frozen source) '(2 . 1)))
    (exc-etaf-undo)
    (should (equal (exc-frozen source) '(0 . 0)))))

