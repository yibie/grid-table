(ert-deftest exc-etaf-hidden-rows-and-columns ()
  (exc-etaf-test--with-grid (10 5 100 14)
    ;; Hide rows 3 and 4 (model 2 and 3) and column B.
    (exc-etaf-goto 2 0)
    (exc-etaf-goto 3 0 t)
    (exc-etaf-hide-rows)
    (should (equal (car (exc-hidden source)) '(2 3)))
    (exc-etaf-goto 1 1)
    (exc-etaf-hide-columns)
    (should (equal (exc-etaf--cursor) '(1 . 2)))
    (let ((window (exc-etaf-test--window)))
      (should-not (memq 2 (car window)))
      (should-not (memq 1 (cdr window))))
    ;; Movement passes over them.
    (exc-etaf-goto 1 0)
    (exc-next-line)
    (should (equal (exc-etaf--cursor) '(4 . 0)))
    (exc-cell-right)
    (should (equal (exc-etaf--cursor) '(4 . 2)))
    (exc-cell-left)
    (should (equal (exc-etaf--cursor) '(4 . 0)))
    ;; Copying leaves them out.
    (exc-etaf-goto 1 0)
    (exc-etaf-goto 4 2 t)
    (exc-etaf-copy)
    (should (equal (current-kill 0 t) "1\t3\n4\t12"))
    ;; Undo shows the column again; showing the rows takes a selection
    ;; across them.
    (exc-etaf-undo)
    (should (equal (cdr (exc-hidden source)) nil))
    (exc-etaf-select-all)
    (exc-etaf-show-rows)
    (should (equal (exc-hidden source) '(nil)))
    ;; Not everything can be hidden.
    (exc-etaf-select-all)
    (should-error (exc-etaf-hide-columns) :type 'user-error)
    ;; Rows a filter hides stay the filter's: B is 2, 4, ... so rows 1 to
    ;; 4 go, and hiding rows 0 to 6 hides only the ones shown.
    (exc-etaf-filter-column 1 ">" "8")
    (exc-etaf-goto 0 0)
    (exc-etaf-goto 6 0 t)
    (exc-etaf-hide-rows)
    (should (equal (car (exc-hidden source)) '(0 5 6)))
    ;; With the rest filtered away, the last shown row cannot go.
    (exc-etaf-select-all)
    (should-error (exc-etaf-hide-rows) :type 'user-error)))

(ert-deftest exc-etaf-defined-names ()
  (exc-etaf-test--with-grid (8 4 100 12)
    ;; B2:B4 hold 2, 4, 6.
    (exc-etaf-goto 1 1)
    (exc-etaf-goto 3 1 t)
    (exc-etaf-define-name "Amounts")
    (should (equal (exc-workbook-name-definition
                    (exc-workbook-of source) "amounts")
                   (concat "=" (exc-calc-sheet-prefix
                                (exc-workbook-sheet-name source))
                           "$B$2:$B$4")))
    (exc-etaf-set-cell 6 2 "=SUM(Amounts)")
    (should (equal (exc-get-computed-value-at source 6 2) 12))
    ;; Going to the name selects its cells.
    (exc-etaf-goto 0 0)
    (exc-etaf-goto-name "Amounts")
    (should (equal (exc-etaf-selection) '(1 1 3 1)))
    (exc-etaf-goto 0 0)
    (exc-etaf-goto-address "amounts")
    (should (equal (exc-etaf-selection) '(1 1 3 1)))
    ;; A short name reads like column letters; the name wins.
    (exc-etaf-goto 4 2)
    (exc-etaf-define-name "Qty")
    (exc-etaf-goto 0 0)
    (exc-etaf-goto-name "Qty")
    (should (equal (exc-etaf--cursor) '(4 . 2)))
    ;; Tracing the formula shows the named cells.
    (exc-etaf-goto 6 2)
    (exc-etaf-trace-precedents)
    (should (eq (exc-etaf--traced source 2 1) 'precedent))
    (should-error (exc-etaf-define-name "B12") :type 'user-error)
    ;; Deleting it is a step undo takes back.
    (exc-etaf-delete-name "Amounts")
    (should (equal (exc-get-computed-value-at source 6 2) "#NAME?"))
    (exc-etaf-undo)
    (should (equal (exc-get-computed-value-at source 6 2) 12))))

(ert-deftest exc-etaf-validation-lists ()
  (exc-etaf-test--with-grid (8 4 100 12)
    ;; Typing starts an edit here, as in Excel.
    (switch-to-buffer buffer)
    (exc-etaf-goto 1 0)
    (exc-etaf-goto 3 0 t)
    (exc-etaf-set-validation-list "Yes, No")
    ;; Editing such a cell offers the choices.
    (exc-etaf-goto 2 0)
    (cl-letf (((symbol-function 'completing-read)
               (lambda (_prompt options &rest _)
                 (should (equal options '("Yes" "No")))
                 "No")))
      (exc-edit-cell))
    (should (equal (exc-get-raw-value-at source 2 0) "No"))
    ;; Typing something else is refused and leaves the cell alone.
    (should-error (execute-kbd-macro (kbd "m a y b e RET")) :type 'user-error)
    (should (equal (exc-get-raw-value-at source 2 0) "No"))
    (execute-kbd-macro (kbd "y e s RET"))
    (should (equal (exc-get-raw-value-at source 2 0) "yes"))
    ;; Undo takes the rule back with it.
    (exc-etaf-goto 1 0)
    (exc-etaf-clear-validations)
    (should-not (exc-validations source))
    (exc-etaf-undo)
    (should (exc-validations source))))

(ert-deftest exc-etaf-remove-duplicates ()
  (exc-etaf-test--with-grid (8 4 100 12)
    ;; Rows 2 to 7: a, b, A, b, c, a in column A; column D reads B.
    (cl-loop for row from 1 for key in '("a" "b" "A" "b" "c" "a") do
             (exc-etaf-set-cell row 0 key))
    (exc-etaf-set-cell 5 1 "4")
    (exc-sheet-new "Other")
    (exc-etaf-set-cell 0 0 "=Sheet1!B6+Sheet1!B4")
    (exc-sheet-select "Sheet1")
    ;; Comparing column A only.
    (exc-etaf-goto 0 0)
    (exc-etaf-goto 7 0 t)
    (exc-etaf-remove-duplicates)
    (should (equal (cl-loop for row below (exc-get-row-count source)
                            collect (exc-get-raw-value-at source row 0))
                   '("H0" "a" "b" "c" "7")))
    ;; The formula of the row kept moved with it; the other sheet's
    ;; reference to a deleted row is #REF!, to a kept one follows it.
    (should (equal (exc-get-raw-value-at source 3 3) "=B4+C4"))
    (let ((other (exc-workbook-sheet (exc-workbook-of source) "Other")))
      (should (equal (exc-get-raw-value-at other 0 0) "=Sheet1!B4+Sheet1!#REF!"))
      (should (equal (exc-get-computed-value-at other 0 0) "#REF!"))
      (exc-etaf-undo)
      (should (= (exc-get-row-count source) 8))
      (should (equal (exc-get-raw-value-at other 0 0) "=Sheet1!B6+Sheet1!B4"))
      (should (equal (exc-get-computed-value-at other 0 0) 10)))
    (exc-etaf-goto 0 0)
    (should (equal (exc-etaf-remove-duplicates)
                   "No duplicate rows"))))

(defun exc-etaf-test--geometry (ref)
  "Return the painted geometry of Host REF, or nil when it is not painted."
  (when-let* ((node (etaf-runtime-host-node (exc-etaf--runtime) ref)))
    (ebox-node-geometry node)))

(ert-deftest exc-etaf-chart-runs-past-a-short-sheet ()
  "A chart taller than the rows below its anchor keeps its height.
The window's empty lines below the grid take the rest, and the status
bar moves below the chart."
  (exc-etaf-test--with-grid (6 3 120 30)
    (exc-etaf-goto 0 0)
    (exc-etaf-goto 5 1 t)
    (exc-etaf-insert-chart 'column)
    (let ((chart (exc-etaf-test--geometry 'exc-etaf-chart-0)))
      (should (equal (plist-get chart :height) 16))
      (let ((status-line (with-current-buffer (current-buffer)
                           (save-excursion
                             (goto-char (point-min))
                             (search-forward "Chart:")
                             (1- (line-number-at-pos))))))
        (should (>= status-line (+ (plist-get chart :y) 16)))))))

(ert-deftest exc-etaf-floating-charts ()
  "A chart floats over its anchor cell, scrolls with it and undoes."
  (exc-etaf-test--with-grid (40 8 120 24)
    (let ((source exc--data-source)
          (top (exc-etaf--state-top exc-etaf--state)))
      ;; With no cells selected the chart draws the filled block around
      ;; the cursor, here the whole sheet.
      (exc-etaf-goto 2 1)
      (exc-etaf-insert-chart 'column)
      (should (equal (plist-get (car (exc-charts source)) :range) "A1:H40"))
      (exc-etaf-undo)
      (should-not (exc-charts source))
      ;; From the selection, sitting right of the block of data it is
      ;; part of: here every column is filled, so past the sheet's edge.
      (exc-etaf-goto 1 1)
      (exc-etaf-goto 5 2 t)
      (exc-etaf-insert-chart 'column)
      (let ((chart (car (exc-charts source))))
        (should (equal (plist-get chart :range) "B2:C6"))
        (should (equal (plist-get chart :anchor) '(1 . 8))))
      (let ((geometry (exc-etaf-test--geometry 'exc-etaf-chart-0)))
        (should (equal (plist-get geometry :y) 3))
        (should (equal (plist-get geometry :height) 16)))
      (should (string-match-p "Chart: untitled (Column, B2:C6)"
                              (exc-etaf-test--text)))
      ;; Scrolled two rows past the anchor, the top of the chart is cut.
      (etaf-set-value top 3)
      (let ((geometry (exc-etaf-test--geometry 'exc-etaf-chart-0)))
        (should (equal (plist-get geometry :y) 2))
        (should (equal (plist-get geometry :height) 14)))
      ;; Scrolled past it entirely, it is gone.
      (etaf-set-value top 30)
      (should-not (exc-etaf-test--geometry 'exc-etaf-chart-0))
      (etaf-set-value top 0)
      ;; Type, title and switching are each a step to undo.
      (exc-etaf-chart-type 'pie)
      (exc-etaf-chart-title "Sales")
      (exc-etaf-chart-switch)
      (let ((chart (car (exc-charts source))))
        (should (eq (plist-get chart :type) 'pie))
        (should (equal (plist-get chart :title) "Sales"))
        (should (eq (plist-get chart :by) 'rows)))
      (exc-etaf-undo)
      (exc-etaf-undo)
      (should (eq (plist-get (car (exc-charts source)) :type) 'pie))
      (should-not (plist-get (car (exc-charts source)) :title))
      ;; A row inserted above moves the chart and its range.
      (exc-etaf-goto 1 0)
      (exc-insert-row-above)
      (let ((chart (car (exc-charts source))))
        (should (equal (plist-get chart :anchor) '(2 . 8)))
        (should (equal (plist-get chart :range) "B3:C7")))
      ;; A pointer drag redraws the grid as it goes, so each move may
      ;; reach a handler made after the drag started.
      (funcall (exc-etaf--drag-chart (current-buffer) 0) '(:phase start))
      (exc-etaf--bump exc-etaf--state)
      (funcall (exc-etaf--drag-chart (current-buffer) 0)
               '(:phase move :delta (0 . 2)))
      (funcall (exc-etaf--drag-chart (current-buffer) 0)
               '(:phase end :delta (0 . 2)))
      (should (equal (plist-get (car (exc-charts source)) :anchor) '(4 . 8)))
      (exc-etaf-undo)
      ;; A drag moves the chart by whole cells, as one undo step.
      (etaf-drag-step (exc-etaf--runtime) 'exc-etaf-chart-0 0 3)
      (should (equal (plist-get (car (exc-charts source)) :anchor) '(5 . 8)))
      (exc-etaf-undo)
      (should (equal (plist-get (car (exc-charts source)) :anchor) '(2 . 8)))
      ;; The chart draws what the cells hold now.
      (exc-etaf-set-cell 2 1 "999")
      (should (equal (cadr (car (plist-get (exc-etaf--chart-data
                                             source (car (exc-charts source))
                                             (etaf-value (exc-etaf--state-tick
                                                          exc-etaf--state)))
                                            :series)))
                     999))
      (exc-etaf-chart-move-here)
      (should (equal (plist-get (car (exc-charts source)) :anchor) '(1 . 0)))
      (exc-etaf-chart-delete)
      (should-not (exc-charts source))
      (exc-etaf-undo)
      (should (exc-charts source))
      ;; A chart anchored far past the sheet's edge, as a file may hold, still mounts.
      (exc-set-charts
       source (list (list :anchor '(1 . 50) :size '(20 . 6) :type 'line
                          :range "B2:C6")))
      (exc-etaf--bump exc-etaf--state)
      ;; It stands there, out of the window's sight, as on a spreadsheet.
      (should (equal (plist-get (car (exc-charts source)) :anchor) '(1 . 50)))
      (should-not (exc-etaf-test--geometry 'exc-etaf-chart-0)))))

(ert-deftest exc-etaf-charts-stand-past-the-last-column ()
  "A chart can stand right of the sheet, as on a spreadsheet's empty cells.
Selecting a chart leaves the selected cells alone, so they can be given
to it."
  (exc-etaf-test--with-grid (12 3 120 24)
    (let* ((source exc--data-source)
           (state exc-etaf--state)
           (real (+ (exc-etaf--col-pixels state 0)
                    (exc-etaf--col-pixels state 1)
                    (exc-etaf--col-pixels state 2))))
      ;; Right of a three-column block: column D, past the edge
      (exc-etaf-goto 0 0)
      (exc-etaf-goto 5 1 t)
      (exc-etaf-insert-chart 'column)
      (should (equal (plist-get (car (exc-charts source)) :anchor) '(0 . 3)))
      (let ((geometry (exc-etaf-test--geometry 'exc-etaf-chart-0)))
        (should geometry)
        ;; it starts right of the last column
        (should (>= (plist-get geometry :x) real)))
      ;; Dragged further right, over more empty columns, and back
      (should (= (exc-etaf--walk-cols
                  state 3 (* 3 (exc-etaf--col-pixels state 3)))
                 6))
      (should (= (exc-etaf--walk-cols
                  state 6 (- (* 4 (exc-etaf--col-pixels state 3))))
                 2))
      ;; Dragged two empty columns further, it is still drawn, there.
      (etaf-drag-step (exc-etaf--runtime) 'exc-etaf-chart-0
                      (* 2 (exc-etaf--col-pixels state 3)) 0)
      (should (equal (plist-get (car (exc-charts source)) :anchor) '(0 . 5)))
      (should-not (plist-get (car (exc-charts source)) :offset))
      (let ((geometry (exc-etaf-test--geometry 'exc-etaf-chart-0)))
        (should geometry)
        (should (>= (plist-get geometry :x)
                    (+ real (* 2 (exc-etaf--col-pixels state 3))))))
      ;; Select cells, then the chart: the cells stay selected for C-c k r.
      (exc-etaf-chart-deselect)
      (exc-etaf-goto 0 0)
      (exc-etaf-goto 5 2 t)
      (exc-etaf-chart-next)
      (should (equal (exc-etaf-selection) '(0 0 5 2)))
      (exc-etaf-chart-range)
      (should (equal (plist-get (car (exc-charts source)) :range) "A1:C6")))))

(ert-deftest exc-etaf-charts-move-to-the-pixel ()
  "A dragged chart stands where it is let go, not on a cell's edge.
While the pointer moves only its box moves; letting go changes the
sheet, as one undo step."
  (exc-etaf-test--with-grid (12 3 120 24)
    (let* ((source exc--data-source)
           (state exc-etaf--state)
           (char (exc-etaf--char-width))
           (drag (lambda (phase dx)
                   (funcall (exc-etaf--drag-chart (current-buffer) 0)
                            (list :phase phase :delta (cons dx 0)))))
           x)
      (exc-etaf-goto 0 0)
      (exc-etaf-goto 5 1 t)
      (exc-etaf-insert-chart 'column)
      (setq x (plist-get (exc-etaf-test--geometry 'exc-etaf-chart-0) :x))
      (funcall drag 'start 0)
      (funcall drag 'move (* 3 char))
      ;; The box moved; the sheet did not.
      (should (= (plist-get (exc-etaf-test--geometry 'exc-etaf-chart-0) :x)
                 (+ x (* 3 char))))
      (should (equal (plist-get (car (exc-charts source)) :anchor) '(0 . 3)))
      (funcall drag 'end (* 3 char))
      (let ((chart (car (exc-charts source))))
        (should (equal (plist-get chart :anchor) '(0 . 3)))
        (should (equal (plist-get chart :offset) '(3.0 . 0))))
      (should (= (plist-get (exc-etaf-test--geometry 'exc-etaf-chart-0) :x)
                 (+ x (* 3 char))))
      ;; Back where it started: no offset is kept, and the box is back too.
      (funcall drag 'start 0)
      (funcall drag 'move (* 5 char))
      (funcall drag 'end (- (* 3 char)))
      (should-not (plist-get (car (exc-charts source)) :offset))
      (should (= (plist-get (exc-etaf-test--geometry 'exc-etaf-chart-0) :x)
                 x))
      ;; Dragged far left, it stops on the first column's edge while the
      ;; pointer moves, where letting go puts it, not over the row numbers.
      (funcall drag 'start 0)
      (funcall drag 'move -10000)
      (let ((held (plist-get (exc-etaf-test--geometry 'exc-etaf-chart-0) :x)))
        (funcall drag 'end -10000)
        (should (equal (plist-get (car (exc-charts source)) :anchor) '(0 . 0)))
        (should (= (plist-get (exc-etaf-test--geometry 'exc-etaf-chart-0) :x)
                   held)))
      (exc-etaf-undo)
      (should (= (plist-get (exc-etaf-test--geometry 'exc-etaf-chart-0) :x)
                 x))
      ;; A cancelled drag leaves the chart and its box where they were.
      (funcall drag 'start 0)
      (funcall drag 'move (* 7 char))
      (funcall (exc-etaf--drag-chart (current-buffer) 0) '(:phase cancel))
      (should (= (plist-get (exc-etaf-test--geometry 'exc-etaf-chart-0) :x)
                 x))
      ;; Esc puts it back too, and is not read again as a Meta key.
      (funcall drag 'start 0)
      (funcall drag 'move (* 7 char))
      (let ((unread-command-events (list 'escape)))
        (funcall (exc-etaf--drag-chart (current-buffer) 0)
                 '(:phase cancel :reason input :event escape :delta (70 . 0)))
        (should-not unread-command-events))
      (should (= (plist-get (exc-etaf-test--geometry 'exc-etaf-chart-0) :x)
                 x))
      ;; So it is when Esc stops a selection.
      (let ((unread-command-events (list ?\e)))
        (funcall (exc-etaf--drag-cell (current-buffer) 0 0)
                 '(:phase cancel :reason input :event ?\e))
        (should-not unread-command-events))
      ;; A pointer leaving the window leaves the chart where it last
      ;; stood, as letting go there would.
      (let ((before (copy-tree (exc-charts source))))
        (funcall drag 'start 0)
        (funcall drag 'move (* 2 char))
        (funcall (exc-etaf--drag-chart (current-buffer) 0)
                 (list :phase 'cancel :reason 'window-left :delta (cons (* 2 char) 0)))
        (should (equal (plist-get (car (exc-charts source)) :offset)
                       (cons (+ (or (car (plist-get (car before) :offset)) 0) 2.0) 0)))
        (exc-etaf-undo)
        (should (equal (exc-charts source) before)))
      ;; Each drag that moved it is one undo step.
      (exc-etaf-undo)
      (should (equal (plist-get (car (exc-charts source)) :offset) '(3.0 . 0)))
      (exc-etaf-undo)
      (should-not (plist-get (car (exc-charts source)) :offset))
      ;; Moving it to the cursor puts it on the cell's edge.
      (exc-etaf-redo)
      (exc-etaf-goto 2 1)
      (exc-etaf-chart-next)
      (exc-etaf-chart-move-here)
      (should (equal (plist-get (car (exc-charts source)) :anchor) '(2 . 1)))
      (should-not (plist-get (car (exc-charts source)) :offset)))))

(ert-deftest exc-etaf-paste-counts-the-cells-pasted ()
  "Pasting says how many cells it pasted, though some held the same."
  (exc-etaf-test--with-grid (8 4 100 12)
    (exc-etaf-goto 1 0)
    (exc-etaf-goto 2 1 t)
    (exc-etaf-copy)
    (let ((said nil))
      (cl-letf (((symbol-function 'message)
                 (lambda (format &rest args)
                   (setq said (and format (apply #'format-message format args))))))
        ;; Onto itself: nothing changes, four cells are pasted.
        (exc-etaf-paste)
        (should (equal said "Pasted 4 cells"))
        (exc-etaf-goto 5 0)
        (exc-etaf-paste)
        (should (equal said "Pasted 4 cells"))))))

(defun exc-etaf-test--cursor-shown-p ()
  "Return non-nil when the window shows the cursor's row and column.
An empty cell paints no text, so the cursor there has no text to mark."
  (let ((cursor (exc-etaf--cursor))
        (window (exc-etaf-test--window)))
    (and (memq (car cursor) (car window)) (memq (cdr cursor) (cdr window)) t)))

(ert-deftest exc-etaf-cursor-goes-past-the-edge ()
  "The cursor goes past the last row and column onto empty cells.
The window shows them, with their letters and numbers, as a
spreadsheet's does; moving there changes nothing."
  (exc-etaf-test--with-grid (4 3 100 12)
    (let ((size (lambda ()
                  (list (exc-get-row-count source) (exc-get-column-count source)))))
      (set-buffer-modified-p nil)
      ;; The window goes on past the last column and row.
      (should (memq 4 (cdr (exc-etaf-test--window))))
      (should (memq 6 (car (exc-etaf-test--window))))
      (should (string-match-p "\\_<E\\_>" (exc-etaf-test--text)))
      ;; Right past the last column, down past the last row.
      (exc-etaf-goto 0 2)
      (exc-cell-right)
      (exc-cell-right)
      (should (equal (exc-etaf--cursor) '(0 . 4)))
      (should (exc-etaf-test--cursor-shown-p))
      (exc-etaf-goto 3 0)
      (exc-next-line)
      (exc-next-line)
      (should (equal (exc-etaf--cursor) '(5 . 0)))
      (should (exc-etaf-test--cursor-shown-p))
      (should (string-match-p "^ *6 " (exc-etaf-test--text)))
      ;; The name box goes there too, far down, and the window follows.
      (exc-etaf-goto-address "H200")
      (should (equal (exc-etaf--cursor) '(199 . 7)))
      (should (exc-etaf-test--cursor-shown-p))
      (should (string-match-p "200" (exc-etaf-test--text)))
      ;; A range there selects, and its cells read as empty.
      (exc-etaf-goto-address "F10:G12")
      (should (equal (exc-etaf-selection) '(9 5 11 6)))
      ;; Nothing of that changed the sheet or made an undo step.
      (should (equal (funcall size) '(4 3)))
      (should-not (buffer-modified-p))
      (should-not (exc-etaf--state-undo exc-etaf--state))
      ;; Back up and left to the cells the sheet has.
      (exc-etaf-first-cell)
      (should (equal (exc-etaf--cursor) '(0 . 0))))))

(ert-deftest exc-etaf-writing-past-the-edge-grows-the-sheet ()
  "Writing on the empty cells past the edge grows the sheet to them.
The growing is part of the step the writing is, and undoing it takes
the new rows and columns back; clearing those cells changes nothing."
  (exc-etaf-test--with-grid (4 3 100 12)
    (let ((size (lambda ()
                  (list (exc-get-row-count source) (exc-get-column-count source)))))
      ;; A value typed at E7.
      (exc-etaf-goto 6 4)
      (exc-etaf--enter-cells exc-etaf--state '((6 4 "42")))
      (should (equal (funcall size) '(7 5)))
      (should (equal (exc-get-raw-value-at source 6 4) "42"))
      (should (exc-etaf--state-undo exc-etaf--state))
      (exc-etaf-undo)
      (should (equal (funcall size) '(4 3)))
      (should (equal (exc-get-raw-value-at source 6 4) ""))
      ;; Clearing empty cells out there grows nothing.
      (exc-etaf-goto 6 4)
      (exc-etaf-goto 8 5 t)
      (exc-etaf-clear-cells)
      (should (equal (funcall size) '(4 3)))
      ;; Bold on them does, in one step.
      (exc-etaf-toggle-bold)
      (should (equal (funcall size) '(9 6)))
      (should (plist-get (exc-get-style-at source 8 5) :bold))
      (exc-etaf-undo)
      (should (equal (funcall size) '(4 3)))
      ;; So does a merge reaching out there.
      (exc-etaf-goto 3 2)
      (exc-etaf-goto 5 4 t)
      (exc-etaf-merge)
      (should (equal (funcall size) '(6 5)))
      (should (exc--merge-at (exc-get-merges source) 5 4))
      (exc-etaf-undo)
      (should (equal (funcall size) '(4 3)))
      (should-not (exc-get-merges source))
      ;; Removing duplicates among empty cells removes nothing.
      (exc-etaf-goto 6 0)
      (exc-etaf-goto 9 1 t)
      (exc-etaf-remove-duplicates)
      (should (equal (funcall size) '(4 3))))))

(ert-deftest exc-etaf-spill-past-the-edge-grows-the-sheet ()
  "A typed formula spilling past the sheet's edge makes the sheet grow.
Excel's sheet has no edge short of its last row and column, so only a
cell in the way makes such a formula #SPILL!."
  (exc-etaf-test--with-grid (4 3 100 12)
    (let ((size (lambda ()
                  (list (exc-get-row-count source) (exc-get-column-count source)))))
      ;; Down past the last row: six rows from row 3 need nine.
      (exc-etaf-set-cell 2 0 "")
      (exc-etaf-set-cell 3 0 "=SEQUENCE(6)")
      (should (equal (funcall size) '(9 3)))
      (should (equal (exc-get-computed-value-at source 8 0) 6))
      ;; One undo takes back the formula and the rows it made.
      (exc-etaf-undo)
      (should (equal (funcall size) '(4 3)))
      (should-not (string-prefix-p "=" (exc-get-raw-value-at source 3 0)))
      ;; Right past the last column.
      (exc-etaf-set-cell 0 2 "=SEQUENCE(1,4)")
      (should (equal (funcall size) '(4 6)))
      (should (equal (exc-get-computed-value-at source 0 5) 4))
      (exc-etaf-undo)
      (should (equal (funcall size) '(4 3)))
      ;; A cell in the way keeps it #SPILL!, and nothing grows.
      (exc-etaf-set-cell 3 1 "=SEQUENCE(1,2)")
      (should (equal (funcall size) '(4 3)))
      (should (equal (exc-get-computed-value-at source 3 1) "#SPILL!"))
      ;; A formula that comes to spill past the edge when another cell
      ;; changes does not make the sheet grow, nor does recalculating.
      (exc-etaf-set-cell 3 1 "")
      (exc-etaf-set-cell 1 0 "1")
      (exc-etaf-set-cell 1 1 "=SEQUENCE(A2)")
      (should (equal (funcall size) '(4 3)))
      (exc-etaf-set-cell 1 0 "5")
      (should (equal (funcall size) '(4 3)))
      (should (equal (exc-get-computed-value-at source 1 1) "#SPILL!"))
      (exc-recalculate source t)
      (should (equal (funcall size) '(4 3))))))

(ert-deftest exc-etaf-general-numbers-show-eleven-characters ()
  "A cell shows a number as Excel's general format does; a copy keeps it whole."
  (exc-etaf-test--with-grid (4 3 100 12)
    (exc-etaf-set-cell 1 1 "=1/3")
    (should (string-match-p "0\\.333333333\\_>" (exc-etaf-test--text)))
    (should-not (string-match-p "0\\.3333333333" (exc-etaf-test--text)))
    (exc-etaf-goto 1 1)
    (exc-etaf-copy)
    (should (string-match-p "0\\.33333333333333" (current-kill 0)))))

(ert-deftest exc-etaf-name-for-a-formula ()
  "A name can stand for a formula, as Excel's Refers to: does."
  (exc-etaf-test--with-grid (8 4 100 12)
    ;; B2 holds 2.
    (exc-etaf-goto 1 1)
    (exc-etaf-define-name "Net")
    (exc-etaf-define-name "Gross" "Net*10")
    (should (equal (exc-workbook-name-definition (exc-workbook-of source) "Gross")
                   "=Net*10"))
    (exc-etaf-set-cell 6 0 "=Gross")
    (exc-etaf-set-cell 6 1 "=Twice(Net)")
    (should (equal (exc-get-computed-value-at source 6 0) 20))
    (should (equal (exc-get-computed-value-at source 6 1) "#NAME?"))
    (exc-etaf-define-name "Twice" "=LAMBDA(x,x*2)")
    (should (equal (exc-get-computed-value-at source 6 1) 4))
    ;; What does not read as a formula is refused, and nothing changes.
    (should-error (exc-etaf-define-name "Broken" "=SUM(") :type 'user-error)
    (should-error (exc-etaf-define-name "Empty" "=") :type 'user-error)
    (should-not (exc-workbook-name-definition (exc-workbook-of source) "Broken"))
    ;; Defining it is a step undo takes back.
    (exc-etaf-undo)
    (should (equal (exc-get-computed-value-at source 6 1) "#NAME?"))))

;; A .grid file opens as a grid, and saving the buffer saves the grid,
;; as with any file Emacs visits.
(ert-deftest exc-etaf-save-buffer-saves-the-grid ()
  (let* ((dir (make-temp-file "exc-visit" t))
         (file (expand-file-name "sales.grid" dir))
         (fresh (expand-file-name "new.grid" dir)))
    (unwind-protect
        (progn
          (exc-persistence--save-to-file
           (make-exc-default-data-source '("A" "B") '(("1" "2"))) file)
          (with-current-buffer (find-file-noselect file)
            (should (derived-mode-p 'exc-etaf-mode))
            (should-not (buffer-modified-p))
            (switch-to-buffer (current-buffer))
            (exc-etaf-goto 1 0)
            (execute-kbd-macro (kbd "9 9 RET"))
            (should (buffer-modified-p))
            (save-buffer)
            (should-not (buffer-modified-p))
            ;; Undoing is a change too, and saving again finds no
            ;; complaint that the file changed since it was visited.
            (exc-etaf-undo)
            (should (buffer-modified-p))
            (save-buffer)
            (exc-etaf-redo)
            (save-buffer)
            (should (equal (directory-files dir nil "\\`[^.]") '("sales.grid")))
            (kill-buffer))
          (should (equal (exc-get-raw-value-at
                          (exc-persistence-create-data-source-from-file file)
                          1 0)
                         "99"))
          ;; A file not there yet is an empty grid until it is saved.
          (with-current-buffer (find-file-noselect fresh)
            (should (derived-mode-p 'exc-etaf-mode))
            (should-not (file-exists-p fresh))
            (switch-to-buffer (current-buffer))
            (exc-etaf-goto 0 0)
            (execute-kbd-macro (kbd "x RET"))
            (save-buffer)
            (kill-buffer))
          (should (equal (exc-get-raw-value-at
                          (exc-persistence-create-data-source-from-file fresh)
                          0 0)
                         "x")))
      (delete-directory dir t))))

;; A CSV file opens as a grid with its header line on top, and saving
;; the buffer writes CSV back to it.
(ert-deftest exc-etaf-csv-opens-and-saves-as-csv ()
  (require 'exc-csv)
  (let* ((dir (make-temp-file "exc-csv" t))
         (file (expand-file-name "sales.csv" dir)))
    (unwind-protect
        (progn
          (with-temp-file file
            (insert "name,amount\nalpha,10\nbeta,20\n"))
          (exc-find-file-csv file)
          (should (equal buffer-file-name file))
          (should (derived-mode-p 'exc-etaf-mode))
          (should-not (buffer-modified-p))
          (should (equal (exc-get-raw-value-at exc--data-source 0 0) "name"))
          (exc-etaf-goto 1 1)
          (execute-kbd-macro (kbd "9 9 RET"))
          (should (buffer-modified-p))
          (save-buffer)
          (should-not (buffer-modified-p))
          (kill-buffer)
          (should (equal (directory-files dir nil "\\`[^.]") '("sales.csv")))
          (with-temp-buffer
            (insert-file-contents file)
            (should (equal (buffer-string) "name,amount\nalpha,99\nbeta,20\n"))))
      (delete-directory dir t))))

;; A window system's Return key is the event `return', not RET; it edits
;; and stores a cell all the same.
(ert-deftest exc-etaf-return-key-edits-and-stores ()
  (exc-etaf-test--with-grid (6 5)
    (switch-to-buffer buffer)
    (exc-etaf-goto 1 0)
    (execute-kbd-macro [return])
    (should (exc-etaf--state-session exc-etaf--state))
    (execute-kbd-macro (vconcat (kbd "C-a C-k 4 2") [return]))
    (should-not (exc-etaf--state-session exc-etaf--state))
    (should (equal (exc-get-raw-value-at source 1 0) "42"))
    (should (equal (exc-etaf--cursor) '(2 . 0)))
    ;; M-<return> is a line break inside the cell, as M-RET is.
    (execute-kbd-macro (vconcat (kbd "a") [M-return] (kbd "b") [return]))
    (should (equal (exc-get-raw-value-at source 2 0) "a\nb"))))

;; A tooltip is a frame of its own, which would take the pointer from a
;; drag; none shows while one lasts, and help comes back after it.
(ert-deftest exc-etaf-no-tooltip-while-dragging ()
  (exc-etaf-test--with-grid (6 5)
    (let ((show-help-function #'tooltip-show-help)
          (handler (exc-etaf--drag-cell (current-buffer) 0 0)))
      (dolist (stop '((:phase end :delta (0 . 0))
                      (:phase cancel :reason window-left :delta (0 . 0))
                      (:phase cancel :reason quit)))
        (funcall handler '(:phase start :delta (0 . 0)))
        (should (eq show-help-function #'ignore))
        (funcall handler stop)
        (should (eq show-help-function #'tooltip-show-help))
        (should-not exc-etaf--drag-help)))))

;; A drag's release starts where the press did, taken before the grid was
;; drawn again; the cell it ends on is the one under the pointer's pixels.
(ert-deftest exc-etaf-drag-ends-on-the-cell-under-the-pointer ()
  (exc-etaf-test--with-grid (8 5)
    (set-window-buffer (selected-window) (current-buffer))
    (let* ((window (selected-window))
           (state exc-etaf--state)
           (xy (cl-loop for y below (window-body-height window t)
                        thereis
                        (cl-loop for x below (window-body-width window t)
                                 when (equal (exc-etaf--cell-at-gesture
                                              state (list :position (cons x y)
                                                          :window window))
                                             '(3 . 2))
                                 return (cons x y))))
           ;; The press's start, at the first cell drawn.
           (stale (cl-loop for y below 10
                           for posn = (posn-at-x-y 5 y window)
                           when (equal (exc-etaf--cell-at-gesture
                                        state (list :position (posn-x-y posn)
                                                    :window window))
                                       '(0 . 0))
                           return posn))
           (handler (exc-etaf--drag-cell (current-buffer) 0 0)))
      (should (and xy stale))
      (funcall handler (list :phase 'start :event (list 'down-mouse-1 stale)
                             :window window :position '(0 . 0)))
      (funcall handler (list :phase 'end :event (list 'drag-mouse-1 stale stale)
                             :window window :position xy))
      (should (equal (exc-etaf--cursor) '(3 . 2)))
      (should (equal (etaf-value (exc-etaf--state-anchor state))
                     '(0 . 0))))))

;; A drag-selection resting against a window edge goes on past it, the
;; window scrolling, as a spreadsheet's does.
(ert-deftest exc-etaf-drag-selection-scrolls-at-the-window-edge ()
  (exc-etaf-test--with-grid (40 30 60 12)
    (let* ((state exc-etaf--state)
           (handler (exc-etaf--drag-cell (current-buffer) 2 1))
           (edge (lambda (edges)
                   (funcall handler (list :phase 'edge :edges edges
                                          :window (selected-window)
                                          :position '(0 . 0)))))
           (last-row (lambda ()
                       (car (last (exc-etaf--visible-rows
                                   state
                                   (etaf-value (exc-etaf--state-top state))
                                   (exc-etaf--visible-cols
                                    state
                                    (etaf-value (exc-etaf--state-left state))))))))
           (shown (funcall last-row)))
      (funcall handler '(:phase start :delta (0 . 0)))
      ;; The first step is from the window's edge, not from the cursor.
      (funcall edge '(bottom))
      (should (equal (exc-etaf--cursor) (cons (1+ shown) 1)))
      (should (> (etaf-value (exc-etaf--state-top state)) 0))
      (dotimes (_ 3) (funcall edge '(bottom)))
      (should (equal (exc-etaf--cursor) (cons (+ 4 shown) 1)))
      (funcall edge '(right))
      (should (> (cdr (exc-etaf--cursor)) 2))
      (should (> (etaf-value (exc-etaf--state-left state)) 0))
      (dotimes (_ 40) (funcall edge '(top left)))
      (should (equal (exc-etaf--cursor) '(0 . 0)))
      (should (equal (etaf-value (exc-etaf--state-top state)) 0))
      (should (equal (etaf-value (exc-etaf--state-left state)) 0))
      ;; The anchor stays where the drag began.
      (should (equal (etaf-value (exc-etaf--state-anchor state))
                     '(2 . 1))))))

;; A drag-selection reaching into frozen columns brings back the columns
;; scrolled out of sight between.
(ert-deftest exc-etaf-drag-selection-into-frozen-columns-unscrolls ()
  (exc-etaf-test--with-grid (40 30 60 12)
    (let ((state exc-etaf--state)
          (handler (exc-etaf--drag-cell (current-buffer) 3 8)))
      (exc-etaf-goto 2 2)
      (exc-etaf-freeze-panes)
      (exc-etaf-goto 3 8)
      (etaf-set-value (exc-etaf--state-left state) 6)
      (funcall handler '(:phase start :delta (0 . 0)))
      (cl-letf (((symbol-function 'exc-etaf--cell-at-gesture)
                 (lambda (&rest _) '(3 . 0))))
        (funcall handler '(:phase move :delta (0 . 0))))
      (should (equal (exc-etaf--cursor) '(3 . 0)))
      (should (= (etaf-value (exc-etaf--state-left state)) 2)))))

;; A chart dragged against a window edge scrolls the sheet under it and
;; goes as far again, landing there as one undo step.
(ert-deftest exc-etaf-chart-drag-scrolls-at-the-window-edge ()
  (exc-etaf-test--with-grid (60 3 120 16)
    (let* ((source exc--data-source)
           (state exc-etaf--state)
           (drag (lambda (phase &rest more)
                   (funcall (exc-etaf--drag-chart (current-buffer) 0)
                            (append (list :phase phase :delta '(0 . 0)) more)))))
      (exc-etaf-goto 0 0)
      (exc-etaf-goto 5 1 t)
      (exc-etaf-insert-chart 'column)
      (should (equal (plist-get (car (exc-charts source)) :anchor) '(0 . 3)))
      (funcall drag 'start)
      (dotimes (_ 5) (funcall drag 'edge :edges '(bottom)))
      (should (= (etaf-value (exc-etaf--state-top state)) 5))
      ;; Drawn where it would land while the drag goes on.
      (should (equal (plist-get (car (exc-charts source)) :anchor) '(5 . 3)))
      (dotimes (_ 2) (funcall drag 'edge :edges '(top)))
      (funcall drag 'end)
      (should (equal (plist-get (car (exc-charts source)) :anchor) '(3 . 3)))
      (should-not exc-etaf--chart-drag)
      (should (equal exc-etaf--chart-drag-scroll '(0 . 0)))
      (exc-etaf-undo)
      (should (equal (plist-get (car (exc-charts source)) :anchor) '(0 . 3))))))

;; A pointer on a cell leaves the selected chart, and one on the chart
;; still takes it.  The press is dispatched as Ebox dispatches one, at the
;; painted Host of the cell and of the chart, so it is the handlers the
;; nodes carry that run.
(ert-deftest exc-etaf-clicking-a-cell-leaves-the-chart ()
  (exc-etaf-test--with-grid (12 6 120 24)
    (let ((state exc-etaf--state)
          (normal (exc-etaf--status-text
                   exc-etaf--state exc--data-source nil)))
      (exc-etaf-goto 1 1)
      (exc-etaf-insert-chart 'column)
      (should (eql exc-etaf--chart 0))
      (should (string-match-p "Chart: untitled" (exc-etaf-test--text)))
      (let* ((cols (exc-etaf--visible-cols
                    state (etaf-value (exc-etaf--state-left state))))
             (rows (exc-etaf--visible-rows
                    state (etaf-value (exc-etaf--state-top state)) cols))
             (ref (exc-etaf--slot-ref (cl-position 4 rows)
                                      (cl-position 2 cols))))
        (etaf-drag-step (exc-etaf--runtime) ref 0 0)
        (should-not exc-etaf--chart)
        (should (equal (exc-etaf--cursor) '(4 . 2)))
        (should-not (string-match-p "Chart:" (exc-etaf-test--text)))
        ;; The status bar tells the cells' figures again.
        (should (equal (exc-etaf--status-text
                        state exc--data-source nil)
                       normal)))
      ;; The chart itself is still the thing a press on it selects.
      (etaf-drag-step (exc-etaf--runtime) 'exc-etaf-chart-0 0 0)
      (should (eql exc-etaf--chart 0)))))

;; ESC takes the selection off a chart, and is only a command while one is
;; selected: otherwise it stays the prefix key it is everywhere in Emacs.
(ert-deftest exc-etaf-escape-leaves-the-chart ()
  (exc-etaf-test--with-grid (10 5)
    (switch-to-buffer buffer)
    (let ((state exc-etaf--state))
      (should-not (key-binding [escape]))
      (exc-etaf-goto 1 1)
      (exc-etaf-insert-chart 'column)
      (should (eq (key-binding [escape]) #'exc-etaf-chart-deselect))
      (execute-kbd-macro [escape])
      (should-not exc-etaf--chart)
      (should-not (key-binding [escape]))
      (should (keymapp (key-binding (kbd "ESC"))))
      (should-not (string-match-p "Chart:" (exc-etaf-test--text)))
      ;; ESC in an edit belongs to the edit, which it cancels; the chart
      ;; the edit began on is already left, and one selected since stays.
      (exc-etaf-insert-chart 'column)
      (execute-kbd-macro (kbd "<f2>"))
      (should (exc-etaf-test--session))
      (should-not exc-etaf--chart)
      (exc-etaf--select-chart state 0)
      (execute-kbd-macro [escape])
      (should-not (exc-etaf-test--session))
      (should (eql exc-etaf--chart 0))
      (should-not (etaf-value (exc-etaf--state-editing state))))))

;; Starting an edit leaves the chart: by typing, with F2, or with RET.
(ert-deftest exc-etaf-editing-a-cell-leaves-the-chart ()
  (exc-etaf-test--with-grid (8 5)
    (switch-to-buffer buffer)
    (let ((state exc-etaf--state))
      (dolist (start (list (lambda () (exc-etaf-test--type "7"))
                           (lambda () (execute-kbd-macro (kbd "<f2>")))
                           (lambda () (execute-kbd-macro (kbd "RET")))))
        (exc-etaf-goto 1 1)
        (exc-etaf-insert-chart 'column)
        (should (eql exc-etaf--chart 0))
        (funcall start)
        (should (exc-etaf-test--session))
        (should-not exc-etaf--chart)
        (should-not (string-match-p "Chart:" (exc-etaf-test--text)))
        (execute-kbd-macro [escape])
        (should-not (exc-etaf-test--session))
        (should-not exc-etaf--chart)
        (should (equal (exc-get-raw-value-at exc--data-source 1 1) "2"))
        ;; Take the chart away again for the next way of starting an edit.
        (exc-etaf-undo)
        (should-not (exc-charts exc--data-source))))))

;; The keyboard moves the cursor and keeps the chart, so that C-c k m can
;; be told where to put it.
(ert-deftest exc-etaf-arrows-keep-the-chart-to-move-it-here ()
  (exc-etaf-test--with-grid (10 6 120 24)
    (switch-to-buffer buffer)
    (let ((source exc--data-source))
      (exc-etaf-goto 1 1)
      (exc-etaf-insert-chart 'column)
      (should (eql exc-etaf--chart 0))
      (execute-kbd-macro (kbd "<down>"))
      (execute-kbd-macro (kbd "<right>"))
      (should (equal (exc-etaf--cursor) '(2 . 2)))
      (should (eql exc-etaf--chart 0))
      (execute-kbd-macro (kbd "C-c k m"))
      (should (equal (plist-get (car (exc-charts source)) :anchor) '(2 . 2)))
      (should (eql exc-etaf--chart 0)))))

(ert-deftest exc-etaf-shows-calc-answers-when-they-come ()
  "A CALC cell computed in another Emacs is drawn again once its answer
comes, with what reads it."
  (exc-etaf-test--with-grid (3 3)
    (let ((exc-calc-calc-async t)
          (exc-calc--calc-answers (make-hash-table :test 'equal))
          (exc-calc--calc-waiting (make-hash-table :test 'equal))
          (exc-calc--calc-queue nil) (exc-calc--calc-workers nil)
          (exc-calc--calc-sent 0)
          (start (float-time)))
      (unwind-protect
          (progn
            (exc-set-raw-value-at source 1 0 "=CALC(\"deriv(x^4, x)\")")
            (exc-set-raw-value-at source 1 1 "=LEN(A2)")
            (exc-recalculate source)
            (exc-refresh)
            (should (equal (exc-get-computed-value-at source 1 0) "#GETTING_DATA"))
            (while (and (not (string-search "4 x^3" (exc-etaf-test--text)))
                        (< (- (float-time) start) 10))
              (accept-process-output nil 0.05))
            (should (string-search "4 x^3" (exc-etaf-test--text)))
            (should (equal (exc-get-computed-value-at source 1 1) 5)))
        (exc-calc-calc-stop)))))

(ert-deftest exc-etaf-new-view-shows-edits-and-outlives-the-other ()
  "A second view of a sheet draws the edits made in the first, and the
first goes on drawing once the second is killed.  Cloning a grid's
buffer opens such a view."
  (exc-etaf-test--with-grid (3 3)
    (should (eq (key-binding [remap clone-indirect-buffer-other-window])
                #'exc-etaf-new-view))
    (let ((first (current-buffer))
          (view (save-window-excursion
                  (exc-etaf-new-view)
                  (current-buffer))))
      (unwind-protect
          (progn
            (should-not (eq view first))
            (should (eq (buffer-local-value 'exc--data-source view) source))
            (exc-etaf-set-cell 1 0 "seen-there")
            (accept-process-output nil 0.05)
            (with-current-buffer view
              (should (string-search "seen-there" (exc-etaf-test--text))))
            (with-current-buffer view
              (exc-etaf-set-cell 2 0 "seen-here"))
            (accept-process-output nil 0.05)
            (should (string-search "seen-here" (exc-etaf-test--text))))
        (kill-buffer view))
      (exc-etaf-set-cell 0 1 "still-drawn")
      (should (string-search "still-drawn" (exc-etaf-test--text))))))

(ert-deftest exc-etaf-holds-garbage-collection-while-commands-run ()
  "A grid's commands raise `gc-cons-threshold' until Emacs is idle.
Each move allocates a few megabytes; collecting several times a move is
what made held arrow keys outrun the display."
  (exc-etaf-test--with-grid (5 3)
    (let ((gc-cons-threshold 800000)
          (exc-etaf-gc-cons-threshold (* 64 1024 1024))
          (exc-etaf--gc-saved nil)
          (exc-etaf--gc-timer nil))
      (should (memq #'exc-etaf--gc-hold pre-command-hook))
      (run-hooks 'pre-command-hook)
      (should (= gc-cons-threshold (* 64 1024 1024)))
      (should (timerp exc-etaf--gc-timer))
      ;; A second command neither saves the raised value nor adds a timer.
      (let ((timer exc-etaf--gc-timer))
        (run-hooks 'pre-command-hook)
        (should (eq exc-etaf--gc-timer timer))
        (cancel-timer timer))
      (exc-etaf--gc-release)
      (should (= gc-cons-threshold 800000))
      (should-not exc-etaf--gc-saved)
      ;; A threshold someone else changed meanwhile is theirs to keep.
      (run-hooks 'pre-command-hook)
      (cancel-timer exc-etaf--gc-timer)
      (setq gc-cons-threshold (* 100 1024 1024))
      (exc-etaf--gc-release)
      (should (= gc-cons-threshold (* 100 1024 1024)))
      ;; Another package's named command sees the user's value.
      (let ((this-command 'describe-variable)
            (gc-cons-threshold 800000))
        (exc-etaf--gc-hold)
        (should (= gc-cons-threshold 800000)))
      ;; nil leaves it alone.
      (let ((exc-etaf-gc-cons-threshold nil)
            (gc-cons-threshold 800000))
        (run-hooks 'pre-command-hook)
        (should (= gc-cons-threshold 800000))))))

;; A move to a row already on screen needs only the drawing's own layout.
(ert-deftest exc-etaf-lays-out-rows-once-per-move-on-screen ()
  "Moving within the window lays the rows out once, for the drawing."
  (exc-etaf-test--with-grid (40 3)
    (exc-etaf-set-cell 39 0 "far-down")
    (let ((calls 0)
          (real (symbol-function 'exc-etaf--visible-rows)))
      (cl-letf (((symbol-function 'exc-etaf--visible-rows)
                 (lambda (&rest args) (cl-incf calls) (apply real args))))
        (exc-etaf-goto 2 0)
        (should (= calls 1))
        ;; A row off screen still scrolls into view.
        (exc-etaf-goto 39 0)))
    (should (string-search "far-down" (exc-etaf-test--text)))))

;; Keys waiting to be read are moved over without drawing each step.
(ert-deftest exc-etaf-held-moves-draw-once ()
  "Moves made while input waits are drawn once, where they ended."
  (exc-etaf-test--with-grid (40 4)
    (let ((renders 0)
          (real (symbol-function 'exc-etaf--render)))
      (cl-letf (((symbol-function 'exc-etaf--render)
                 (lambda (&rest args) (cl-incf renders) (apply real args)))
                ((symbol-function 'input-pending-p) #'always))
        (exc-etaf-move 1 0)
        (exc-etaf-move 1 0)
        (exc-etaf-move 0 1)
        (should (= renders 0))
        (should (equal (exc-etaf--cursor) '(0 . 0)))
        ;; The next move key keeps waiting; any other command draws first.
        (let ((this-command-keys-shift-translated nil))
          (cl-letf (((symbol-function 'this-command-keys-vector)
                     (lambda () [down])))
            (exc-etaf--draw-before-command))
          (should (= renders 0))
          (cl-letf (((symbol-function 'this-command-keys-vector)
                     (lambda () [?x])))
            (exc-etaf--draw-before-command))))
      (should (= renders 1))
      (should (equal (exc-etaf--cursor) '(2 . 1)))
      (should-not exc-etaf--pending-move)
      (should-not exc-etaf--pending-timer))))

(ert-deftest exc-etaf-held-shift-moves-select-the-run ()
  "A held S-Down selects every row it passed, drawn once input stops."
  (exc-etaf-test--with-grid (40 4)
    (exc-etaf-goto 1 1)
    (cl-letf (((symbol-function 'input-pending-p) #'always))
      (dotimes (_ 3) (exc-etaf-move 1 0 t)))
    (exc-etaf--draw-after-command)
    (should (equal (exc-etaf--cursor) '(4 . 1)))
    (should (equal (etaf-value (exc-etaf--state-anchor
                                (exc-etaf--state-or-error)))
                   '(1 . 1)))
    ;; A plain move then shifted ones extend from where the plain one went.
    (cl-letf (((symbol-function 'input-pending-p) #'always))
      (exc-etaf-move 1 0)
      (exc-etaf-move 0 1 t))
    (exc-etaf--draw-after-command)
    (should (equal (exc-etaf--cursor) '(5 . 2)))
    (should (equal (etaf-value (exc-etaf--state-anchor
                                (exc-etaf--state-or-error)))
                   '(5 . 1)))))

(ert-deftest exc-etaf-far-jump-lays-out-a-window-not-every-row ()
  "Going far down lays the window out a few times, not once a row."
  (exc-etaf-test--with-grid (2000 3)
    (exc-etaf-set-cell 1990 0 "near-end")
    (let ((calls 0)
          (real (symbol-function 'exc-etaf--visible-rows)))
      (cl-letf (((symbol-function 'exc-etaf--visible-rows)
                 (lambda (&rest args) (cl-incf calls) (apply real args))))
        (exc-etaf-goto 1990 0))
      (should (<= calls 4)))
    (should (string-search "near-end" (exc-etaf-test--text)))
    ;; The row is the window's last, as stepping down one row at a time
    ;; left it.
    (let* ((state (exc-etaf--state-or-error))
           (cols (exc-etaf--visible-cols
                  state (etaf-value (exc-etaf--state-left state))))
           (rows (exc-etaf--visible-rows
                  state (etaf-value (exc-etaf--state-top state)) cols)))
      (should (eql (car (last rows)) 1990))
      (should-not (memq 1990 (exc-etaf--visible-rows
                              state (1- (etaf-value
                                         (exc-etaf--state-top state)))
                              cols))))))

(ert-deftest exc-etaf-first-cell-scrolls-home-past-frozen-panes ()
  "M-< and C-<home> go to the first cell past frozen panes, scrolled home."
  (exc-etaf-test--with-grid (300 30)
    (exc-etaf-goto 1 1)
    (exc-etaf-freeze-panes)
    (exc-etaf-goto 250 25)
    (exc-etaf-first-cell)
    (let ((state (exc-etaf--state-or-error)))
      (should (equal (exc-etaf--cursor) '(1 . 1)))
      (should (= (etaf-value (exc-etaf--state-top state)) 1))
      (should (= (etaf-value (exc-etaf--state-left state)) 1)))))

(ert-deftest exc-etaf-binds-fast-wheel-and-ctrl-home-end ()
  "Double and triple wheel events scroll; C-<home> and C-<end> jump."
  (exc-etaf-test--with-grid (5 3)
    (dolist (event '(wheel-down double-wheel-down triple-wheel-down))
      (should (eq (lookup-key exc-etaf-traverse-map (vector event))
                  #'exc-etaf-scroll-down)))
    (dolist (event '(wheel-up double-wheel-up triple-wheel-up))
      (should (eq (lookup-key exc-etaf-traverse-map (vector event))
                  #'exc-etaf-scroll-up)))
    (should (assoc "C-<home>" exc-etaf--keys))
    (should (assoc "C-<end>" exc-etaf--keys))))

