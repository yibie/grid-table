(ert-deftest exc-etaf-column-widths-stay-with-their-columns ()
  (exc-etaf-test--with-grid (4 4)
    (exc-etaf-set-column-width 1 20)
    (should (= (aref (exc-etaf--state-widths exc-etaf--state) 1)
               20))
    ;; A column inserted before it moves the width along.
    (funcall (gethash :add-column source) source 0)
    (exc-refresh)
    (should (= (gethash 2 (exc-get-column-widths source)) 20))
    (should (= (aref (exc-etaf--state-widths exc-etaf--state) 2)
               20))
    ;; Rows and sorting leave it alone.
    (funcall (gethash :add-row source) source 1)
    (funcall (gethash :sort-by-column source) source 0 'descending)
    (exc-refresh)
    (should (= (gethash 2 (exc-get-column-widths source)) 20))
    ;; It is saved with the grid.
    (let ((file (make-temp-file "exc-widths-" nil ".grid")))
      (unwind-protect
          (progn
            (exc-persistence--save-to-file source file)
            (let ((back (exc-persistence-create-data-source-from-file
                         file)))
              (should (= (gethash 2 (exc-get-column-widths back)) 20))
              ;; The view uses it from the first showing.
              (let ((shown (generate-new-buffer " *exc-etaf-reopened*")))
                (unwind-protect
                    (with-current-buffer shown
                      (exc--show-grid-in-current-buffer back)
                      (should (= (aref (exc-etaf--state-widths
                                        exc-etaf--state)
                                       2)
                                 20)))
                  (kill-buffer shown)))))
        (delete-file file)))
    ;; Deleting the column forgets it.
    (funcall (gethash :delete-column source) source 2)
    (exc-refresh)
    (should (= (hash-table-count (exc-get-column-widths source)) 0))))

(ert-deftest exc-etaf-many-cells-recalculate-once ()
  "A fill of many cells recalculates the workbook once, not per cell.
Formulas calling a function defined after loading are computed on every
recalculation, so a recalculation per cell made a long fill quadratic."
  (exc-etaf-test--with-grid (60 4)
    (let ((exc-calc-functions (copy-hash-table exc-calc-functions))
          (recalculations 0))
      (exc-calc-defun TESTDOUBLE (value) (* 2 (exc-calc-to-number value)))
      (dotimes (row 59)
        (exc-set-raw-value-at source (1+ row) 0 (number-to-string row)))
      (exc-set-raw-value-at source 1 1 "=TESTDOUBLE(A2)")
      (exc-set-raw-value-at source 1 2 "=SUM(B2:B60)")
      (cl-letf* ((recalculate (symbol-function 'exc-calc-evaluate-models))
                 ((symbol-function 'exc-calc-evaluate-models)
                  (lambda (&rest args)
                    (cl-incf recalculations)
                    (apply recalculate args))))
        (exc-etaf-goto 1 1)
        (exc-etaf-goto 59 1 t)
        (exc-etaf-fill-down))
      (should (= recalculations 1))
      (should (equal (exc-get-computed-value-at source 59 1) 116))
      ;; What reads the filled cells sees their new values.
      (should (equal (exc-get-computed-value-at source 1 2)
                     (* 2 (apply #'+ (number-sequence 0 58))))))))

(ert-deftest exc-etaf-fill-continues-what-starts-the-selection ()
  (should (equal (mapcar #'car (exc-etaf--series '("1" "3") 3))
                 '("5" "7" "9")))
  (should (equal (mapcar #'car (exc-etaf--series '("5") 2)) '("6" "7")))
  (should (equal (mapcar #'car (exc-etaf--series '("0.1" "0.2") 2))
                 '("0.3" "0.4")))
  (should (equal (mapcar #'car (exc-etaf--series '("Week 08") 3))
                 '("Week 09" "Week 10" "Week 11")))
  (should (equal (mapcar #'car (exc-etaf--series '("a" "b") 3))
                 '("a" "b" "a")))
  (exc-etaf-test--with-grid (7 5)
    (let ((state exc-etaf--state))
      ;; Dates count on day by day and keep their format.
      (dotimes (row 5)
        (exc-set-raw-value-at source (1+ row) 0 ""))
      (exc-enter-value source 1 0 "2026-10-13")
      (exc-etaf-goto 1 0)
      (dotimes (_ 3) (exc-etaf-extend-down))
      (exc-etaf-fill-series)
      (should (equal (exc-get-display-value-at source 4 0) "2026-10-16"))
      (exc-etaf-undo)
      (should (equal (exc-get-raw-value-at source 4 0) ""))
      (should-not (exc-get-style-at source 4 0))
      ;; Fill down copies the first row; formulas follow their rows.
      (exc-set-raw-value-at source 1 3 "=B2*2")
      (exc-etaf-goto 1 3)
      (dotimes (_ 2) (exc-etaf-extend-down))
      (exc-etaf-fill-down)
      (should (equal (exc-get-raw-value-at source 3 3) "=B4*2"))
      (should (equal (exc-get-computed-value-at source 3 3) 12))
      ;; Fill right copies the first column.
      (exc-etaf-goto 5 1)
      (exc-etaf-extend-right)
      (exc-etaf-fill-right)
      (should (equal (exc-get-raw-value-at source 5 2)
                     (exc-get-raw-value-at source 5 1)))
      (should (exc-etaf--state-undo state)))))

(ert-deftest exc-etaf-find-and-replace-work-on-cells ()
  (exc-etaf-test--with-grid (6 5)
    (exc-set-raw-value-at source 2 2 "Apple pie")
    (exc-set-raw-value-at source 4 1 "apple")
    (exc-etaf-goto 1 0)
    (exc-etaf-find "APPLE")
    (should (equal (exc-etaf--cursor) '(2 . 2)))
    (exc-etaf-find "apple")
    (should (equal (exc-etaf--cursor) '(4 . 1)))
    ;; The search wraps, and goes backward on request.
    (exc-etaf-find "apple")
    (should (equal (exc-etaf--cursor) '(2 . 2)))
    (exc-etaf-find "apple" t)
    (should (equal (exc-etaf--cursor) '(4 . 1)))
    ;; A formula is found by what it shows and by what it says.
    (exc-etaf-find "=B3")
    (should (equal (exc-etaf--cursor) '(2 . 3)))
    ;; Replacing changes what cells store, as one step.
    (exc-etaf-goto 1 0)
    (exc-etaf-replace "apple" "pear")
    (should (equal (exc-get-raw-value-at source 2 2) "pear pie"))
    (should (equal (exc-get-raw-value-at source 4 1) "pear"))
    (exc-etaf-undo)
    (should (equal (exc-get-raw-value-at source 2 2) "Apple pie"))
    (should (equal (exc-get-raw-value-at source 4 1) "apple"))
    ;; A selection limits it.
    (exc-etaf-goto 2 2)
    (exc-etaf-extend-right)
    (exc-etaf-replace "apple" "plum")
    (should (equal (exc-get-raw-value-at source 2 2) "plum pie"))
    (should (equal (exc-get-raw-value-at source 4 1) "apple"))))

(ert-deftest exc-etaf-sheet-without-a-header-row ()
  (exc-etaf-test--with-grid (5 3)
    ;; With a header row a filter always leaves the first row shown.
    (exc-etaf-goto 2 0)
    (exc-etaf-filter-by-cell)
    (should (equal (append (exc-etaf--state-shown exc-etaf--state)
                           nil)
                   '(0 2)))
    (exc-etaf-clear-filters)
    ;; The first row cannot be deleted, nor a row put above it.
    (exc-etaf-goto 0 0)
    (exc-delete-row 0)
    (exc-insert-row-above)
    (should (equal (exc-get-row-count source) 5))
    (should (equal (exc-get-raw-value-at source 0 0) "H0"))
    ;; Without one it is a row like any other.
    (exc-toggle-header-row)
    (should-not (exc-header-row-p source))
    (exc-etaf-goto 2 0)
    (exc-etaf-filter-by-cell)
    (should (equal (append (exc-etaf--state-shown exc-etaf--state)
                           nil)
                   '(2)))
    (exc-etaf-clear-filters)
    (exc-etaf-goto 0 0)
    (exc-insert-row-above)
    (should (equal (exc-get-row-count source) 6))
    (should (equal (exc-get-raw-value-at source 0 0) ""))
    (should (equal (exc-get-raw-value-at source 1 0) "H0"))
    (exc-etaf-goto 0 0)
    (exc-delete-row 0)
    (should (equal (exc-get-raw-value-at source 0 0) "H0"))
    ;; Both are undone like any change of structure.
    (exc-etaf-undo)
    (should (equal (exc-get-raw-value-at source 1 0) "H0"))
    (exc-etaf-undo)
    (should (equal (exc-get-row-count source) 5))))

;; Model rows and columns the window of the current buffer shows.
(defun exc-etaf-test--window ()
  (let* ((state exc-etaf--state)
         (cols (exc-etaf--visible-cols
                state (etaf-value (exc-etaf--state-left state)))))
    (cons (exc-etaf--visible-rows
           state (etaf-value (exc-etaf--state-top state)) cols)
          cols)))

(ert-deftest exc-etaf-frozen-rows-and-columns-stay-in-place ()
  (exc-etaf-test--with-grid (60 30 60 12)
    ;; Rows above the cursor and columns left of it are frozen.
    (exc-etaf-goto 2 1)
    (exc-etaf-freeze-panes)
    (should (equal (exc-frozen source) '(2 . 1)))
    (exc-etaf-goto 40 20)
    (let ((window (exc-etaf-test--window)))
      (should (equal (cl-subseq (car window) 0 2) '(0 1)))
      (should (> (nth 2 (car window)) 2))
      (should (memq 40 (car window)))
      (should (= (car (cdr window)) 0))
      (should (> (nth 1 (cdr window)) 1))
      (should (memq 20 (cdr window))))
    ;; The frozen cells are painted, the ones scrolled past are not.
    (should (string-match-p "H0" (exc-etaf-test--text)))
    ;; Moving into the frozen rows leaves the rest where it is.
    (let ((before (exc-etaf-test--window)))
      (exc-etaf-goto 0 0)
      (should (equal (exc-etaf-test--window) before)))
    ;; Scrolling never moves the window over the frozen rows.
    (dotimes (_ 30) (exc-etaf-scroll-up))
    (should (equal (cl-subseq (car (exc-etaf-test--window)) 0 3)
                   '(0 1 2)))
    ;; A row put among the frozen ones is frozen with them; undoing the
    ;; row undoes that.
    (exc-etaf-goto 1 0)
    (exc-insert-row-above)
    (should (equal (exc-frozen source) '(3 . 1)))
    (exc-etaf-undo)
    (should (equal (exc-frozen source) '(2 . 1)))
    (funcall (gethash :add-column source) source 5)
    (should (equal (exc-frozen source) '(2 . 1)))
    (funcall (gethash :delete-column source) source 0)
    (exc-refresh)
    (should (equal (exc-frozen source) '(2 . 0)))
    ;; It is saved with the grid, and released on request.
    (let ((file (make-temp-file "exc-frozen-" nil ".grid")))
      (unwind-protect
          (progn
            (exc-persistence--save-to-file source file)
            (should (equal (exc-frozen
                            (exc-persistence-create-data-source-from-file
                             file))
                           '(2 . 0))))
        (delete-file file)))
    ;; A page is the rows that scroll.
    (exc-etaf-goto 2 3)
    (let ((page (exc-etaf--page-size)))
      (exc-etaf-page-down)
      (should (= (car (exc-etaf--cursor)) (+ 2 page))))
    ;; Frozen rows a window has no room for give way to one that scrolls.
    (exc-set-frozen source 30 0)
    (exc-refresh)
    (exc-etaf-goto 50 3)
    (let ((rows (car (exc-etaf-test--window))))
      (should (memq 50 rows))
      (should (<= (length rows) 9)))
    (exc-unfreeze-panes)
    (should (equal (exc-frozen source) '(0 . 0)))
    (exc-etaf-goto 40 3)
    (should-not (memq 0 (car (exc-etaf-test--window))))
    ;; More than the window holds cannot be frozen.
    (exc-etaf-goto 45 0)
    (should-error (exc-etaf-freeze-panes) :type 'user-error)
    (should (equal (exc-frozen source) '(0 . 0)))))

(ert-deftest exc-etaf-merge-across-the-frozen-columns ()
  (exc-etaf-test--with-grid (8 30 60 12)
    (dotimes (col 9)
      (exc-set-raw-value-at source 3 (1+ col) ""))
    (exc-source-merge-cells source 3 0 3 9)
