(ert-deftest exc-etaf-merges-the-selected-rectangle ()
  (exc-etaf-test--with-grid (8 6)
    (dolist (cell '((2 2) (3 1) (3 2) (4 1) (4 2)))
      (exc-etaf-set-cell (car cell) (cadr cell) ""))
    (exc-etaf-goto 2 1)
    (exc-etaf-goto 4 2 t)
    (exc-etaf-merge)
    (should (equal (exc-get-merges exc--data-source) '((2 1 4 2))))
    ;; The cursor anywhere inside is the one merged cell.
    (exc-etaf-goto 3 2)
    (let ((cell (exc-get-cell-at-point)))
      (should (equal (plist-get cell :anchor-row) 2))
      (should (equal (plist-get cell :row-end) 4))
      (should (equal (plist-get cell :col-start) 2))
      (should (equal (plist-get cell :col-end) 3)))
    (should (exc-etaf-test--cursor-painted-p))
    (should (equal (etaf-host-ref-size
                    (etaf-runtime-for-buffer (current-buffer))
                    (exc-etaf--slot-ref 2 1))
                   ;; Two 5-wide columns with their padding and grid lines,
                   ;; three rows tall.
                   '(16 . 3)))
    ;; Movement leaves the rectangle by its edges.
    (exc-next-line)
    (should (equal (exc-etaf--cursor) '(5 . 2)))
    (exc-etaf-goto 3 2)
    (exc-cell-left)
    (should (equal (exc-etaf--cursor) '(3 . 0)))
    ;; A non-empty covered cell refuses the merge and changes nothing.
    (exc-etaf-goto 5 3)
    (exc-etaf-goto 6 4 t)
    (should-error (exc-etaf-merge))
    (should (equal (exc-get-merges exc--data-source) '((2 1 4 2))))
    (exc-etaf-goto 3 1)
    (exc-unmerge-cell)
    (should-not (exc-get-merges exc--data-source))))

(ert-deftest exc-etaf-charts-are-drawn-in-their-cell ()
  (exc-etaf-test--with-grid (6 5 160 30)
    (exc-etaf-set-cell 2 4 "=COUNTPLOT(A2:A6,\"Counts\")")
    (let ((value (exc-get-computed-value-at source 2 4))
          (text (exc-etaf-test--text)))
      (should (plist-get value :exc-chart))
      (should-not (string-match-p "\\[Chart\\]" text))
      (should (string-match-p "Counts" text))
      ;; The column and the row grew to the size of the drawing.
      (let ((drawing (exc-chart-content value)))
        (should (>= (aref (exc-etaf--state-widths exc-etaf--state)
                          4)
                    (apply #'max (mapcar #'string-width
                                         (split-string drawing "\n")))))
        (should (> (count-lines (point-min) (point-max)) 10))))
    ;; Editing shows the formula, not the drawing.
    (exc-etaf-goto 2 4)
    (should (string-match-p "=COUNTPLOT" (car (split-string
                                               (exc-etaf-test--text)
                                               "\n"))))))

(ert-deftest exc-etaf-row-counts-agree-with-and-without-a-header ()
