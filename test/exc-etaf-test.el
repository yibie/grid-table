(ert-deftest exc-etaf-filters-hide-rows-and-movement-skips-them ()
  (exc-etaf-test--with-grid (12 4 100 20)
    ;; Column B below its title holds 2, 4, ... 22.
    (exc-etaf-filter-column 1 ">" "10")
    (should (= (exc-etaf--row-count exc-etaf--state) 7))
    (let ((text (exc-etaf-test--text)))
      (should (string-match-p "^ *1[ │]+H0" text))
      (should (string-match-p "^ *7 " text))
      (should-not (string-match-p "^ *5 " text))
      (should (string-match-p "B ▼" text))
      (should (string-match-p "6 of 11 rows shown" text)))
    ;; The cursor leaves a hidden row and steps over hidden rows.
    (exc-etaf-goto 3 0)
    (should (equal (exc-etaf--cursor) '(6 . 0)))
    (exc-previous-line)
    (should (equal (exc-etaf--cursor) '(0 . 0)))
    (exc-next-line)
    (exc-next-line)
    (should (equal (exc-etaf--cursor) '(7 . 0)))
    (exc-etaf-last-cell)
    (should (equal (car (exc-etaf--cursor)) 11))
    ;; A filter on another column narrows the first: A holds 1 to 11.
    (exc-etaf-filter-column 0 "<" "10")
    (should (= (exc-etaf--row-count exc-etaf--state) 5))
    ;; Clearing and figures work on what is shown.
    (exc-etaf-select-column 1)
    (should (string-match-p "Count: 5   Sum: 60" (exc-etaf-test--text)))
    (exc-etaf-clear-cells)
    (should (equal (exc-get-raw-value-at source 5 1) "10"))
    (should (equal (exc-get-raw-value-at source 6 1) ""))
    (should (equal (exc-get-raw-value-at source 10 1) "20"))
    (exc-etaf-undo)
    ;; Edits do not re-filter; refreshing does.
    (exc-etaf-set-cell 6 1 "1")
    (should (= (exc-etaf--row-count exc-etaf--state) 5))
    (exc-refresh)
    (should (= (exc-etaf--row-count exc-etaf--state) 4))
    ;; Clearing one column's filter leaves the other in force.
    (exc-etaf-goto 0 0)
    (exc-etaf-clear-column-filter)
    (should (equal (mapcar #'car (exc-etaf--state-filters
                                  exc-etaf--state))
                   '(1)))
    (exc-etaf-clear-filters)
    (should-not (exc-etaf--state-shown exc-etaf--state))
    (should (string-match-p "^ *5 " (exc-etaf-test--text)))))

(ert-deftest exc-etaf-filter-by-cell-and-structure-changes ()
  (exc-etaf-test--with-grid (8 4 100 20)
    (exc-etaf-set-cell 2 0 "x")
    (exc-etaf-set-cell 5 0 "X")
