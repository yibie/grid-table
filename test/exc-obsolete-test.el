(defun exc-obsolete-test--root ()
  "Directory the package was loaded from."
  (file-name-directory (or (locate-library "exc") "")))

(defun exc-obsolete-test--run (form)
  "Run FORM in an Emacs of its own with the package on `load-path'.
Return what it printed, standard error included."
  (with-temp-buffer
    (let ((status
           (call-process-shell-command
            (concat (shell-quote-argument
                     (expand-file-name invocation-name invocation-directory))
                    " -Q --batch -L " (shell-quote-argument (exc-obsolete-test--root))
                    " --eval " (shell-quote-argument form) " 2>&1")
            nil t)))
      (unless (eql status 0)
        (ert-fail (format "the other Emacs exited %s: %s" status (buffer-string))))
      (buffer-string))))

(defun exc-obsolete-test--entries (kind)
  "The (OLD NEW KIND) entries of KIND."
  (cl-remove-if-not (lambda (entry) (eq (nth 2 entry) kind))
                    exc-obsolete-test--expected))

(ert-deftest exc-obsolete-test-functions-are-aliased ()
  "Every old function name resolves to its new name, and says it is obsolete."
  (should (exc-obsolete-test--entries 'fun))
  (let (failures)
    (dolist (entry (exc-obsolete-test--entries 'fun))
      (let ((old (intern (nth 0 entry)))
            (new (intern (nth 1 entry))))
        (unless (eq (indirect-function old) (indirect-function new))
          (push (format "%s does not call %s" old new) failures))
        (unless (get old 'byte-obsolete-info)
          (push (format "%s is not marked obsolete" old) failures))))
    (should (null (nreverse failures)))))

(ert-deftest exc-obsolete-test-variables-are-aliased ()
  "Every old variable name resolves to its new name, and says it is obsolete."
  (should (exc-obsolete-test--entries 'var))
  (let (failures)
    (dolist (entry (exc-obsolete-test--entries 'var))
      (let ((old (intern (nth 0 entry)))
            (new (intern (nth 1 entry))))
        (unless (eq (indirect-variable old) (indirect-variable new))
          (push (format "%s does not alias %s" old new) failures))
        (unless (get old 'byte-obsolete-variable)
          (push (format "%s is not marked obsolete" old) failures))))
    (should (null (nreverse failures)))))

(ert-deftest exc-obsolete-test-faces-are-aliased ()
  "Every old face name is an alias of its new name, and says it is obsolete."
  (should (exc-obsolete-test--entries 'face))
  (let (failures)
    (dolist (entry (exc-obsolete-test--entries 'face))
      (let ((old (intern (nth 0 entry)))
            (new (intern (nth 1 entry))))
        (unless (eq (get old 'face-alias) new)
          (push (format "%s is not a face alias of %s" old new) failures))
        (unless (get old 'obsolete-face)
          (push (format "%s is not marked obsolete" old) failures))))
    (should (null (nreverse failures)))))

(ert-deftest exc-obsolete-test-no-old-name-is-defined-without-an-alias ()
  "Nothing is left defined under an old name unless exc-obsolete aliases it."
  (require 'exc)
  (let (extra)
    (mapatoms
     (lambda (symbol)
       (let ((name (symbol-name symbol)))
         (when (and (string-prefix-p "grid-" name)
                    (or (fboundp symbol) (boundp symbol))
                    (not (assoc name exc-obsolete-test--expected)))
           (push name extra)))))
    (should (equal (sort extra #'string<) nil))))

(ert-deftest exc-obsolete-test-autoloaded-commands-keep-their-cookie ()
  "The old name of every autoloaded command is autoloaded too.
Without the cookie, `M-x' on the old name would only work once the
package had been loaded some other way."
  (let ((wanted (cl-loop for entry in exc-obsolete-test--expected
                         when (nth 3 entry) collect (nth 0 entry)))
        (file (expand-file-name "exc-obsolete.el"
                                (file-name-directory
                                 (locate-library "exc-obsolete")))))
    (should (= (length wanted) 10))
    (with-temp-buffer
      (insert-file-contents file)
      (dolist (old wanted)
        (goto-char (point-min))
        (should (re-search-forward
                 (concat "^;;;###autoload\n(define-obsolete-function-alias '"
                         (regexp-quote old) " ")
                 nil t))))))

(ert-deftest exc-obsolete-test-value-set-before-loading-reaches-the-new-name ()
  "A value put on an old option before the package loads reaches the new one."
  (let ((out (exc-obsolete-test--run
              (concat "(progn "
                      "  (setq grid-table-title-align 'center) "
                      "  (require 'exc) "
                      "  (princ (format \"result: %S\" exc-title-align)))"))))
    ;; `title-align' is a defcustom in exc.el, defined long after exc-obsolete
    ;; was loaded by the first file that needed it.
    (should (string-match-p "result: center" out))))

(ert-deftest exc-obsolete-test-old-variable-name-still-reads-and-writes ()
  "Setting the old name after loading sets the new one, and reads back."
  (require 'exc)
  (let ((exc-title-align 'left))
    (setq grid-table-title-align 'right)
    (should (eq exc-title-align 'right))
    (should (eq grid-table-title-align 'right))))

(ert-deftest exc-obsolete-test-old-feature-name-still-loads ()
  "`(require 'grid-table)' loads the package and says what to write instead."
  (let ((out (exc-obsolete-test--run
              (concat "(progn (require 'grid-table) "
                      "(princ (if (featurep 'exc) \"loaded\" \"missing\")))"))))
    (should (string-match-p "loaded" out))
    (should (string-match-p "now exc" out))
    (should (string-match-p "require 'exc" out))))

;;; Things written by the old version, and read by the new one

(ert-deftest exc-obsolete-test-old-grid-file-tag-is-read ()
  "A .grid file whose head says grid-table-file still loads."
  (require 'exc)
  (require 'exc-persistence)
  (let ((file (make-temp-file "exc-old-tag-" nil ".grid")))
    (unwind-protect
        (progn
          ;; Both forms the old version wrote: a tagged v4 sheet and a
          ;; tagged v5 workbook.
          (with-temp-file file
            (prin1 '(grid-table-file
                     :version 4
                     :title "Old"
                     :headers ("A" "B")
                     :rows (("1" "2"))
                     :styles ((0 0 :bold t)))
                   (current-buffer)))
          (let ((source (exc-persistence-create-data-source-from-file file)))
            (should (equal (exc-get-raw-value-at source 0 0) "A"))
            (should (equal (exc-get-raw-value-at source 1 1) "2"))
            (should (equal (exc-get-style-at source 0 0) '(:bold t))))
          (with-temp-file file
            (prin1 '(grid-table-file
                     :version 5
                     :active 1
                     :sheets ((:name "One" :title nil
                                     :headers ("A") :rows (("1")))
                              (:name "Two" :title nil
                                     :headers ("B") :rows (("2")))))
                   (current-buffer)))
          (let* ((source (exc-persistence-create-data-source-from-file file))
                 (workbook (exc-workbook-of source)))
            (should (equal (exc-workbook-sheet-name source) "Two"))
            (should (equal (mapcar #'exc-workbook-sheet-name
                                   (exc-workbook-sheets workbook))
                           '("One" "Two"))))
          ;; What is written now starts with exc-file, and reads back.
          (exc-persistence--save-to-file
           (exc-persistence-create-data-source-from-file file) file)
          (with-temp-buffer
            (insert-file-contents file)
            (goto-char (point-min))
            (should (eq (car (read (current-buffer))) 'exc-file)))
          (should (exc-persistence-create-data-source-from-file file)))
      (delete-file file))))

(ert-deftest exc-obsolete-test-old-error-names-still-catch ()
  "A `condition-case' written with an old error name still catches."
  (require 'exc)
  (dolist (pair '((grid-calc-error exc-calc-error)
                  (grid-calc-cycle exc-calc-cycle)
                  (grid-model-covered-cell exc-model-covered-cell)
                  (grid-calc-put-off exc-calc-put-off)))
    (let ((old (nth 0 pair))
          (new (nth 1 pair)))
      (should (memq old (get new 'error-conditions)))
      (should (eq (eval `(condition-case nil
                             (signal ',new '("test"))
                           (,old 'caught)))
                  'caught))))
  ;; A cycle is still a `grid-calc-error' to old code, as it was before.
  (should (eq (eval '(condition-case nil
                         (signal 'exc-calc-cycle '("test"))
                       (grid-calc-error 'caught)))
              'caught)))

